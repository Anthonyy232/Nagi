<ResourceDictionary x:Class="Nagi.WinUI.Styles.InsightsTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:insights="using:Nagi.Presentation.Insights"
                    xmlns:localControls="using:Nagi.WinUI.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Styles/Converters.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="SeeAllListItemStyle"
           BasedOn="{StaticResource DefaultListViewItemStyle}"
           TargetType="ListViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="InsightsRankTextBlockStyle"
           BasedOn="{StaticResource BodyStrongTextBlockStyle}"
           TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="InsightsSecondaryTextBlockStyle"
           BasedOn="{StaticResource CaptionTextBlockStyle}"
           TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="InsightsStatTextBlockStyle"
           BasedOn="{StaticResource BodyStrongTextBlockStyle}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CompactTextFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <DataTemplate x:Key="TopSongItemTemplate" x:DataType="insights:TopSongItem">
        <Grid Padding="0,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Style="{StaticResource InsightsRankTextBlockStyle}"
                       Text="{x:Bind Rank.ToString()}" />
            <localControls:ArtworkImage Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        PlaceholderGlyph="&#xE8D6;"
                                        PlaceholderGlyphSize="16"
                                        Size="40"
                                        Source="{x:Bind ArtworkUri}" />
            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center"
                        Spacing="2">
                <TextBlock FontSize="{StaticResource CompactTextFontSize}"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Text="{x:Bind Title}"
                           TextWrapping="NoWrap" />
                <TextBlock Style="{StaticResource InsightsSecondaryTextBlockStyle}" Text="{x:Bind Artist}" />
            </StackPanel>
            <TextBlock Grid.Column="3"
                       Style="{StaticResource InsightsStatTextBlockStyle}"
                       Text="{x:Bind StatText}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TopArtistItemTemplate" x:DataType="insights:TopArtistItem">
        <Grid Padding="0,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Style="{StaticResource InsightsRankTextBlockStyle}"
                       Text="{x:Bind Rank.ToString()}" />
            <localControls:ArtworkImage Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        IsCircular="True"
                                        PlaceholderGlyph="&#xE77B;"
                                        PlaceholderGlyphSize="16"
                                        Size="40"
                                        Source="{x:Bind ImageUri}" />
            <HyperlinkButton Grid.Column="2"
                             Command="{x:Bind Command}"
                             CommandParameter="{x:Bind}"
                             Content="{x:Bind Name}"
                             Style="{StaticResource InsightsHyperlinkButtonStyle}" />
            <TextBlock Grid.Column="3"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Style="{StaticResource InsightsSecondaryTextBlockStyle}"
                       Text="{x:Bind StatText}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TopAlbumItemTemplate" x:DataType="insights:TopAlbumItem">
        <Grid Padding="0,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Style="{StaticResource InsightsRankTextBlockStyle}"
                       Text="{x:Bind Rank.ToString()}" />
            <localControls:ArtworkImage Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        PlaceholderGlyph="&#xE93C;"
                                        PlaceholderGlyphSize="16"
                                        Size="40"
                                        Source="{x:Bind ArtworkUri}" />
            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center"
                        Spacing="2">
                <HyperlinkButton Command="{x:Bind Command}"
                                 CommandParameter="{x:Bind}"
                                 Content="{x:Bind Title}"
                                 Style="{StaticResource InsightsHyperlinkButtonStyle}" />
                <TextBlock Style="{StaticResource InsightsSecondaryTextBlockStyle}" Text="{x:Bind ArtistName}" />
            </StackPanel>
            <TextBlock Grid.Column="3"
                       Style="{StaticResource InsightsStatTextBlockStyle}"
                       Text="{x:Bind StatText}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TopGenreItemTemplate" x:DataType="insights:TopGenreItem">
        <Grid Padding="0,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Style="{StaticResource InsightsRankTextBlockStyle}"
                       Text="{x:Bind Rank.ToString()}" />
            <HyperlinkButton Grid.Column="1"
                             Command="{x:Bind Command}"
                             CommandParameter="{x:Bind}"
                             Content="{x:Bind Name}"
                             Style="{StaticResource InsightsHyperlinkButtonStyle}" />
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Style="{StaticResource InsightsSecondaryTextBlockStyle}"
                       Text="{x:Bind StatText}" />
        </Grid>
    </DataTemplate>

    <localControls:InsightsItemTemplateSelector x:Key="InsightsItemTemplateSelector"
                                                AlbumTemplate="{StaticResource TopAlbumItemTemplate}"
                                                ArtistTemplate="{StaticResource TopArtistItemTemplate}"
                                                GenreTemplate="{StaticResource TopGenreItemTemplate}"
                                                SongTemplate="{StaticResource TopSongItemTemplate}" />

</ResourceDictionary>
