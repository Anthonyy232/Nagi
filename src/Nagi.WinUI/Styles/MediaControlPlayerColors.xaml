<?xml version="1.0" encoding="utf-8"?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Style x:Key="MediaControlButtonStyle" TargetType="Button" BasedOn="{StaticResource AnimatedIconButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource AppPrimaryColorBrush}" />
    </Style>

    <Style x:Key="MediaOnImageControlButtonStyle" TargetType="Button" BasedOn="{StaticResource MediaControlButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource MediaOnImageAccentBrush}" />
    </Style>

    <Style x:Key="MediaSeekerSliderStyle" TargetType="controls:Slider" BasedOn="{StaticResource DefaultSliderStyle}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="StepFrequency" Value="0.1" />
        <Setter Property="SnapsTo" Value="StepValues" />
    </Style>

    <Style x:Key="MediaOnImageSeekerSliderStyle" TargetType="controls:Slider" BasedOn="{StaticResource MediaSeekerSliderStyle}">
        <Setter Property="Background" Value="{StaticResource MediaOnImageControlTrackBrush}" />
        <Setter Property="Foreground" Value="{StaticResource MediaOnImageAccentBrush}" />
    </Style>

    <Style x:Key="VolumeSliderStyle" TargetType="controls:Slider" BasedOn="{StaticResource MediaSeekerSliderStyle}">
        <Setter Property="StepFrequency" Value="1" />
        <Setter Property="Width" Value="100" />
    </Style>

</ResourceDictionary>
