<?xml version="1.0" encoding="utf-8"?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="LyricLineTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="42" />
    </Style>

    <Style x:Key="RomanizedLyricLineTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource LyricLineTextBlockStyle}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="LineHeight" Value="26" />
    </Style>

    <Style x:Key="InactiveLyricLineStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="LineHeight" Value="28" />
    </Style>

    <Style x:Key="RomanizedInactiveLyricLineStyle" TargetType="TextBlock" BasedOn="{StaticResource InactiveLyricLineStyle}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="0,-6,0,10" />
        <Setter Property="Opacity" Value="0.75" />
        <Setter Property="LineHeight" Value="22" />
    </Style>

    <Style x:Key="LyricsProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
    </Style>

</ResourceDictionary>
