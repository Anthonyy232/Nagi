<ResourceDictionary
    x:Class="Nagi.WinUI.Styles.SettingCardTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:resources="using:Nagi.Presentation.Resources"
    xmlns:uicontrols="using:Nagi.WinUI.Controls"
    xmlns:settings="using:Nagi.Presentation.Settings">

    <!--
        Setting cards shown on both the settings page and onboarding. A page shows one with a ContentControl
        whose content is the card's view model; the page's implicit styles still apply to the card's controls.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Styles/Converters.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="SettingCardHostStyle" TargetType="ContentControl">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
    </Style>

    <DataTemplate x:Key="BackdropMaterialSettingCard" x:DataType="settings:AppearanceSettingsViewModel">
        <controls:SettingsCard
            Header="{x:Bind resources:Strings.SettingsPage_WindowMaterial_Header}"
            Description="{x:Bind resources:Strings.SettingsPage_WindowMaterial_Description}">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE81E;" />
            </controls:SettingsCard.HeaderIcon>
            <ComboBox
                HorizontalAlignment="Right"
                AutomationProperties.Name="{x:Bind resources:Strings.SettingsPage_WindowMaterial_Header}"
                ItemsSource="{x:Bind BackdropMaterialOptions}"
                DisplayMemberPath="DisplayName"
                SelectedItem="{x:Bind SelectedBackdropMaterial, Mode=TwoWay}" />
        </controls:SettingsCard>
    </DataTemplate>

    <DataTemplate x:Key="DynamicThemingSettingCard" x:DataType="settings:AppearanceSettingsViewModel">
        <controls:SettingsCard
            Header="{x:Bind resources:Strings.SettingsPage_DynamicTheming_Header}"
            Description="{x:Bind resources:Strings.SettingsPage_DynamicTheming_Description}">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE790;" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch
                HorizontalAlignment="Right"
                AutomationProperties.Name="{x:Bind resources:Strings.SettingsPage_DynamicTheming_Header}"
                IsOn="{x:Bind IsDynamicThemingEnabled, Mode=TwoWay}" />
        </controls:SettingsCard>
    </DataTemplate>

    <DataTemplate x:Key="AutoLaunchSettingCard" x:DataType="settings:SettingsViewModel">
        <controls:SettingsCard
            Header="{x:Bind resources:Strings.SettingsPage_AutoLaunch_Header}"
            Description="{x:Bind resources:Strings.SettingsPage_AutoLaunch_Description}">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE7E8;" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch
                HorizontalAlignment="Right"
                AutomationProperties.Name="{x:Bind resources:Strings.SettingsPage_AutoLaunch_Header}"
                IsEnabled="{x:Bind IsUpdatingAutoLaunch, Mode=OneWay, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                IsOn="{x:Bind IsAutoLaunchEnabled, Mode=TwoWay}" />
        </controls:SettingsCard>
    </DataTemplate>

    <DataTemplate x:Key="MinimizeToMiniPlayerSettingCard" x:DataType="settings:SettingsViewModel">
        <controls:SettingsCard
            Header="{x:Bind resources:Strings.SettingsPage_MinimizeToMiniPlayer_Header}"
            Description="{x:Bind resources:Strings.SettingsPage_MinimizeToMiniPlayer_Description}">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE73F;" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch
                HorizontalAlignment="Right"
                AutomationProperties.Name="{x:Bind resources:Strings.SettingsPage_MinimizeToMiniPlayer_Header}"
                IsOn="{x:Bind IsMinimizeToMiniPlayerEnabled, Mode=TwoWay}" />
        </controls:SettingsCard>
    </DataTemplate>

    <DataTemplate x:Key="HideToTraySettingCard" x:DataType="settings:SettingsViewModel">
        <controls:SettingsCard
            Header="{x:Bind resources:Strings.SettingsPage_HideToTray_Header}"
            Description="{x:Bind resources:Strings.SettingsPage_HideToTray_Description}">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE90E;" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch
                HorizontalAlignment="Right"
                AutomationProperties.Name="{x:Bind resources:Strings.SettingsPage_HideToTray_Header}"
                IsOn="{x:Bind IsHideToTrayEnabled, Mode=TwoWay}" />
        </controls:SettingsCard>
    </DataTemplate>

    <DataTemplate x:Key="DiscordSettingCard" x:DataType="settings:SettingsViewModel">
        <controls:SettingsCard
            Header="{x:Bind resources:Strings.SettingsPage_Discord_Header}"
            Description="{x:Bind resources:Strings.SettingsPage_Discord_Description}">
            <controls:SettingsCard.HeaderIcon>
                <uicontrols:DiscordIcon Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch
                HorizontalAlignment="Right"
                AutomationProperties.Name="{x:Bind resources:Strings.SettingsPage_Discord_Header}"
                IsOn="{x:Bind IsDiscordRichPresenceEnabled, Mode=TwoWay}" />
        </controls:SettingsCard>
    </DataTemplate>
</ResourceDictionary>
