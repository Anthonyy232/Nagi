<ResourceDictionary x:Class="Nagi.WinUI.Styles.SettingCardTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
                    xmlns:resources="using:Nagi.Presentation.Resources"
                    xmlns:settings="using:Nagi.Presentation.Settings"
                    xmlns:uicontrols="using:Nagi.WinUI.Controls">

    <!--
        Setting cards shown on both the settings page and onboarding. A page shows one with a ContentControl
        whose content is the card's view model; the page's implicit styles still apply to the card's controls.
        A card names its control after its header, so the controls here need no accessible name of their own.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Styles/Converters.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="SettingCardHostStyle" TargetType="ContentControl">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
    </Style>

    <DataTemplate x:Key="BackdropMaterialSettingCard" x:DataType="settings:AppearanceSettingsViewModel">
        <controls:SettingsCard Description="{x:Bind resources:Strings.SettingsPage_WindowMaterial_Description}" Header="{x:Bind resources:Strings.SettingsPage_WindowMaterial_Header}">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE81E;" />
            </controls:SettingsCard.HeaderIcon>
            <ComboBox HorizontalAlignment="Right"
                      DisplayMemberPath="DisplayName"
                      ItemsSource="{x:Bind BackdropMaterialOptions}"
                      SelectedItem="{x:Bind SelectedBackdropMaterial, Mode=TwoWay}" />
        </controls:SettingsCard>
    </DataTemplate>

    <DataTemplate x:Key="DynamicThemingSettingCard" x:DataType="settings:AppearanceSettingsViewModel">
        <controls:SettingsCard Description="{x:Bind resources:Strings.SettingsPage_DynamicTheming_Description}" Header="{x:Bind resources:Strings.SettingsPage_DynamicTheming_Header}">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE790;" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind IsDynamicThemingEnabled, Mode=TwoWay}" />
        </controls:SettingsCard>
    </DataTemplate>

    <DataTemplate x:Key="AutoLaunchSettingCard" x:DataType="settings:SettingsViewModel">
        <controls:SettingsCard Description="{x:Bind resources:Strings.SettingsPage_AutoLaunch_Description}" Header="{x:Bind resources:Strings.SettingsPage_AutoLaunch_Header}">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE7E8;" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch HorizontalAlignment="Right"
                          IsEnabled="{x:Bind IsUpdatingAutoLaunch, Mode=OneWay, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                          IsOn="{x:Bind IsAutoLaunchEnabled, Mode=TwoWay}" />
        </controls:SettingsCard>
    </DataTemplate>

    <DataTemplate x:Key="MinimizeToMiniPlayerSettingCard" x:DataType="settings:SettingsViewModel">
        <controls:SettingsCard Description="{x:Bind resources:Strings.SettingsPage_MinimizeToMiniPlayer_Description}" Header="{x:Bind resources:Strings.SettingsPage_MinimizeToMiniPlayer_Header}">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE73F;" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind IsMinimizeToMiniPlayerEnabled, Mode=TwoWay}" />
        </controls:SettingsCard>
    </DataTemplate>

    <DataTemplate x:Key="HideToTraySettingCard" x:DataType="settings:SettingsViewModel">
        <controls:SettingsCard Description="{x:Bind resources:Strings.SettingsPage_HideToTray_Description}" Header="{x:Bind resources:Strings.SettingsPage_HideToTray_Header}">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE90E;" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind IsHideToTrayEnabled, Mode=TwoWay}" />
        </controls:SettingsCard>
    </DataTemplate>

    <DataTemplate x:Key="DiscordSettingCard" x:DataType="settings:SettingsViewModel">
        <controls:SettingsCard Description="{x:Bind resources:Strings.SettingsPage_Discord_Description}" Header="{x:Bind resources:Strings.SettingsPage_Discord_Header}">
            <controls:SettingsCard.HeaderIcon>
                <uicontrols:DiscordIcon Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind IsDiscordRichPresenceEnabled, Mode=TwoWay}" />
        </controls:SettingsCard>
    </DataTemplate>
</ResourceDictionary>
