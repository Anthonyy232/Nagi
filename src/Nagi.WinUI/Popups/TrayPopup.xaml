<Window
    x:Class="Nagi.WinUI.Popups.TrayPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:muxm="using:Microsoft.UI.Xaml.Media"
    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
    xmlns:controls="using:Nagi.WinUI.Controls">

    <Window.SystemBackdrop>
        <muxm:DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Border x:Name="OuterBorder"
            Background="Transparent"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            CornerRadius="{ThemeResource OverlayCornerRadius}">

        <Grid>
            <Grid CornerRadius="{ThemeResource OverlayCornerRadius}"
                  Visibility="{x:Bind ViewModel.IsTrayCoverArtVisible, Mode=OneWay}">
                <Border Opacity="0.7">
                    <Border.Background>
                        <media:ImageBlendBrush Source="{x:Bind uihelpers:BitmapImageFactory.CreateDecoded(ViewModel.AlbumArtUri, 400), Mode=OneWay}"
                                               Mode="Multiply"
                                               Stretch="UniformToFill" />
                    </Border.Background>
                </Border>

                <Border Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}" Opacity="0.3" />
            </Grid>

            <controls:CompactPlayerView x:Name="Player" />
        </Grid>
    </Border>
</Window>
