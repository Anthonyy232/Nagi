<pages:ViewModelPage x:Class="Nagi.WinUI.Pages.InsightsPage"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:insights="using:Nagi.Presentation.Insights"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:pages="using:Nagi.WinUI.Pages"
                     xmlns:resources="using:Nagi.Presentation.Resources"
                     xmlns:uicontrols="using:Nagi.WinUI.Controls"
                     xmlns:uihelpers="using:Nagi.WinUI.Helpers"
                     Background="Transparent"
                     mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="InsightsCategoryCardTemplate" x:DataType="insights:InsightsCategoryViewModel">
            <Grid Style="{StaticResource InsightsSectionStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Margin="0"
                               VerticalAlignment="Center"
                               Style="{StaticResource InsightsCardHeaderStyle}"
                               Text="{x:Bind Title}" />
                    <uicontrols:SortButton Grid.Column="1"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Selection="{x:Bind Sort}" />
                    <Button Grid.Column="2"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind resources:Strings.InsightsPage_SeeAll_ToolTip}"
                            Command="{x:Bind OpenSeeAllCommand}"
                            Style="{StaticResource SongListViewPageIconButton}"
                            ToolTipService.ToolTip="{x:Bind resources:Strings.InsightsPage_SeeAll_ToolTip}">
                        <FontIcon FontSize="16" Glyph="&#xE76C;" />
                    </Button>
                </Grid>

                <ListView Grid.Row="1"
                          IsItemClickEnabled="False"
                          ItemContainerStyle="{StaticResource SeeAllListItemStyle}"
                          ItemTemplateSelector="{StaticResource InsightsItemTemplateSelector}"
                          ItemsSource="{x:Bind TopItems}"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          SelectionMode="None" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="{StaticResource PageContainerPaddingVertical}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMarginIndented}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Text="{x:Bind resources:Strings.InsightsPage_Title, Mode=OneTime}" />

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                <ComboBox MinWidth="140"
                          AutomationProperties.Name="{x:Bind resources:Strings.InsightsPage_TimeRange_Name, Mode=OneTime}"
                          DisplayMemberPath="Label"
                          ItemsSource="{x:Bind insights:InsightsViewModel.TimeRanges}"
                          SelectedItem="{x:Bind ViewModel.SelectedTimeRange, Mode=TwoWay}" />
                <Button AutomationProperties.Name="{x:Bind resources:Strings.InsightsPage_Reset_ToolTip, Mode=OneTime}"
                        Command="{x:Bind ViewModel.ResetListenHistoryCommand}"
                        Style="{StaticResource SongListViewPageIconButton}"
                        ToolTipService.ToolTip="{x:Bind resources:Strings.InsightsPage_Reset_ToolTip, Mode=OneTime}">
                    <FontIcon FontSize="16" Glyph="&#xE74D;" />
                </Button>
            </StackPanel>
        </Grid>

        <ProgressRing Grid.Row="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <ScrollViewer Grid.Row="1"
                      uihelpers:ScrollEdgeFade.IsEnabled="True"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

            <Grid Visibility="{x:Bind ViewModel.HasData, Mode=OneWay}">
                <StackPanel Padding="{StaticResource PageContentPadding}" Spacing="24">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="40" />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <Grid x:Name="HeroGrid" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="HeroCard1"
                              Grid.Row="0"
                              Grid.Column="0">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          VerticalAlignment="Center"
                                          FontSize="32"
                                          Foreground="{StaticResource AccentTextBrush}"
                                          Glyph="&#xE7F6;" />
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.TotalListenTimeText, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource InsightsHeroCaptionStyle}" Text="{x:Bind resources:Strings.InsightsPage_TotalTime, Mode=OneTime}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Grid x:Name="HeroCard2"
                              Grid.Row="0"
                              Grid.Column="1">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          VerticalAlignment="Center"
                                          FontSize="32"
                                          Foreground="{StaticResource AccentTextBrush}"
                                          Glyph="&#xE8D6;" />
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.UniqueSongsPlayed.ToString(), Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource InsightsHeroCaptionStyle}" Text="{x:Bind resources:Strings.InsightsPage_UniqueSongs, Mode=OneTime}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Grid x:Name="HeroCard3"
                              Grid.Row="0"
                              Grid.Column="2">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          VerticalAlignment="Center"
                                          FontSize="32"
                                          Foreground="{StaticResource AccentTextBrush}"
                                          Glyph="&#xE823;" />
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.PeakHourText, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource InsightsHeroCaptionStyle}" Text="{x:Bind resources:Strings.InsightsPage_PeakHour, Mode=OneTime}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Grid x:Name="HeroCard4"
                              Grid.Row="0"
                              Grid.Column="3">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          VerticalAlignment="Center"
                                          FontSize="32"
                                          Foreground="{StaticResource AccentTextBrush}"
                                          Glyph="&#xE787;" />
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.MostActiveDayText, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource InsightsHeroCaptionStyle}" Text="{x:Bind resources:Strings.InsightsPage_MostActiveDay, Mode=OneTime}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>

                    <Grid x:Name="Row2Grid" ColumnSpacing="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ContentPresenter x:Name="TopSongsCard"
                                          Grid.Row="0"
                                          Grid.Column="0"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch"
                                          Content="{x:Bind ViewModel.Songs}"
                                          ContentTemplate="{StaticResource InsightsCategoryCardTemplate}" />

                        <ContentPresenter x:Name="TopArtistsCard"
                                          Grid.Row="0"
                                          Grid.Column="1"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch"
                                          Content="{x:Bind ViewModel.Artists}"
                                          ContentTemplate="{StaticResource InsightsCategoryCardTemplate}" />
                    </Grid>

                    <Grid x:Name="Row3Grid" ColumnSpacing="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ContentPresenter x:Name="TopAlbumsCard"
                                          Grid.Row="0"
                                          Grid.Column="0"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch"
                                          Content="{x:Bind ViewModel.Albums}"
                                          ContentTemplate="{StaticResource InsightsCategoryCardTemplate}" />

                        <ContentPresenter x:Name="TopGenresCard"
                                          Grid.Row="0"
                                          Grid.Column="1"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch"
                                          Content="{x:Bind ViewModel.Genres}"
                                          ContentTemplate="{StaticResource InsightsCategoryCardTemplate}" />
                    </Grid>

                    <Grid Style="{StaticResource InsightsSectionStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource InsightsCardHeaderStyle}"
                                   Text="{x:Bind resources:Strings.InsightsPage_Sources, Mode=OneTime}"
                                   Visibility="{x:Bind ViewModel.SourceSegments.Count, Mode=OneWay, Converter={StaticResource CollectionCountToVisibilityConverter}}" />

                        <ItemsRepeater Grid.Row="1"
                                       Margin="0,12,0,0"
                                       ItemsSource="{x:Bind ViewModel.SourceSegments, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="insights:SourceSegment">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   FontSize="{StaticResource CaptionTextBlockFontSize}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind Label}" />

                                        <ProgressBar Grid.Column="1"
                                                     Height="8"
                                                     VerticalAlignment="Center"
                                                     AutomationProperties.AccessibilityView="Raw"
                                                     CornerRadius="{ThemeResource ControlCornerRadius}"
                                                     Foreground="{x:Bind uihelpers:PlaybackContextBrushes.For(ContextType)}"
                                                     Maximum="100"
                                                     Value="{x:Bind Percentage}" />

                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   FontSize="{StaticResource CaptionTextBlockFontSize}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind PercentageText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Grid>

                </StackPanel>
            </Grid>

        </ScrollViewer>

        <uicontrols:EmptyState Title="{x:Bind resources:Strings.InsightsPage_Empty_Title, Mode=OneTime}"
                               Grid.Row="1"
                               Glyph="&#xE9D2;"
                               IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                               Subtitle="{x:Bind resources:Strings.InsightsPage_Empty_Subtitle, Mode=OneTime}" />
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HeroLayoutStates">
                <VisualState x:Name="WideHeroes">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="CompactHeroes">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeroGrid.RowSpacing" Value="16" />
                        <Setter Target="HeroCard1.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeroCard2.(Grid.Column)" Value="2" />
                        <Setter Target="HeroCard2.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeroCard3.(Grid.Column)" Value="0" />
                        <Setter Target="HeroCard3.(Grid.Row)" Value="1" />
                        <Setter Target="HeroCard3.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeroCard4.(Grid.Column)" Value="2" />
                        <Setter Target="HeroCard4.(Grid.Row)" Value="1" />
                        <Setter Target="HeroCard4.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="ListLayoutStates">
                <VisualState x:Name="SideBySideLists">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="600" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="StackedLists">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Row2Grid.RowSpacing" Value="24" />
                        <Setter Target="TopSongsCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="TopArtistsCard.(Grid.Column)" Value="0" />
                        <Setter Target="TopArtistsCard.(Grid.Row)" Value="1" />
                        <Setter Target="TopArtistsCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="Row3Grid.RowSpacing" Value="24" />
                        <Setter Target="TopAlbumsCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="TopGenresCard.(Grid.Column)" Value="0" />
                        <Setter Target="TopGenresCard.(Grid.Row)" Value="1" />
                        <Setter Target="TopGenresCard.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</pages:ViewModelPage>
