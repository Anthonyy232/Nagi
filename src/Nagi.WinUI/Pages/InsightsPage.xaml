<pages:ViewModelPage
    xmlns:pages="using:Nagi.WinUI.Pages"
    x:Class="Nagi.WinUI.Pages.InsightsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="using:Nagi.Presentation.Resources"
    xmlns:insights="using:Nagi.Presentation.Insights"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="InsightsCategoryCardTemplate" x:DataType="insights:InsightsCategoryViewModel">
            <Grid Style="{StaticResource InsightsCardStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind Title}"
                               Style="{StaticResource InsightsCardHeaderStyle}"
                               Margin="0"
                               VerticalAlignment="Center" />
                    <DropDownButton Grid.Column="1"
                                    Content="{x:Bind SortLabel, Mode=OneWay}"
                                    FontSize="11" Height="28" Padding="8,0"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <!-- RadioMenuFlyoutItem groups by name across menus, so each card needs its own group. -->
                                <RadioMenuFlyoutItem Text="{x:Bind resources:Strings.InsightsPage_SortBy_PlayCount}" GroupName="{x:Bind Title}"
                                                     IsChecked="{x:Bind IsByPlayCount, Mode=OneWay}"
                                                     Command="{x:Bind SetMetricCommand}" CommandParameter="PlayCount" />
                                <RadioMenuFlyoutItem Text="{x:Bind resources:Strings.InsightsPage_SortBy_Duration}" GroupName="{x:Bind Title}"
                                                     IsChecked="{x:Bind IsByDuration, Mode=OneWay}"
                                                     Command="{x:Bind SetMetricCommand}" CommandParameter="Duration" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button Grid.Column="2"
                            Command="{x:Bind OpenSeeAllCommand}"
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="28" Height="28" Padding="0"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind resources:Strings.InsightsPage_SeeAll_ToolTip}"
                            AutomationProperties.Name="{x:Bind resources:Strings.InsightsPage_SeeAll_ToolTip}">
                        <FontIcon Glyph="&#xE76C;" FontSize="11" />
                    </Button>
                </Grid>

                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind TopItems}"
                          SelectionMode="None"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                          IsItemClickEnabled="False"
                          ItemContainerStyle="{StaticResource SeeAllListItemStyle}"
                          ItemTemplateSelector="{StaticResource InsightsItemTemplateSelector}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="{StaticResource PageContainerPaddingVertical}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HeroLayoutStates">
                <VisualState x:Name="WideHeroes">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="CompactHeroes">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeroGrid.RowSpacing" Value="16" />
                        <Setter Target="HeroCard1.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeroCard2.(Grid.Column)" Value="2" />
                        <Setter Target="HeroCard2.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeroCard3.(Grid.Column)" Value="0" />
                        <Setter Target="HeroCard3.(Grid.Row)" Value="1" />
                        <Setter Target="HeroCard3.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeroCard4.(Grid.Column)" Value="2" />
                        <Setter Target="HeroCard4.(Grid.Row)" Value="1" />
                        <Setter Target="HeroCard4.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="ListLayoutStates">
                <VisualState x:Name="SideBySideLists">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="600" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="StackedLists">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Row2Grid.RowSpacing" Value="16" />
                        <Setter Target="TopSongsCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="TopArtistsCard.(Grid.Column)" Value="0" />
                        <Setter Target="TopArtistsCard.(Grid.Row)" Value="1" />
                        <Setter Target="TopArtistsCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="Row3Grid.RowSpacing" Value="16" />
                        <Setter Target="TopAlbumsCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="TopGenresCard.(Grid.Column)" Value="0" />
                        <Setter Target="TopGenresCard.(Grid.Row)" Value="1" />
                        <Setter Target="TopGenresCard.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMarginIndented}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{x:Bind resources:Strings.InsightsPage_Title, Mode=OneTime}"
                       Style="{StaticResource PageTitleTextStyle}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox
                          AutomationProperties.Name="{x:Bind resources:Strings.InsightsPage_TimeRange_Name, Mode=OneTime}"
                          ItemsSource="{x:Bind insights:InsightsViewModel.TimeRanges}"
                          DisplayMemberPath="Label"
                          SelectedItem="{x:Bind ViewModel.SelectedTimeRange, Mode=TwoWay}"
                          MinWidth="140" />
                <Button Command="{x:Bind ViewModel.ResetListenHistoryCommand}"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind resources:Strings.InsightsPage_Reset_ToolTip, Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind resources:Strings.InsightsPage_Reset_ToolTip, Mode=OneTime}">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <ProgressRing
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <ScrollViewer uihelpers:ScrollEdgeFade.IsEnabled="True" Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

            <Grid Visibility="{x:Bind ViewModel.HasData, Mode=OneWay}">
                <StackPanel Padding="{StaticResource PageContentPadding}" Spacing="16">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="40" />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <Grid x:Name="HeroGrid" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="HeroCard1" Grid.Column="0" Grid.Row="0" Style="{StaticResource InsightsHeroCardStyle}">
                            <Grid ColumnSpacing="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE7F6;" FontSize="32"
                                          Foreground="{ThemeResource AppPrimaryColorBrush}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.TotalListenTimeText, Mode=OneWay}"
                                               Style="{StaticResource InsightsHeroValueStyle}" />
                                    <TextBlock Text="{x:Bind resources:Strings.InsightsPage_TotalTime, Mode=OneTime}"
                                               Style="{StaticResource InsightsHeroCaptionStyle}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Grid x:Name="HeroCard2" Grid.Column="1" Grid.Row="0" Style="{StaticResource InsightsHeroCardStyle}">
                            <Grid ColumnSpacing="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE8D6;" FontSize="32"
                                          Foreground="{ThemeResource AppPrimaryColorBrush}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.UniqueSongsPlayed.ToString(), Mode=OneWay}"
                                               Style="{StaticResource InsightsHeroValueStyle}" />
                                    <TextBlock Text="{x:Bind resources:Strings.InsightsPage_UniqueSongs, Mode=OneTime}"
                                               Style="{StaticResource InsightsHeroCaptionStyle}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Grid x:Name="HeroCard3" Grid.Column="2" Grid.Row="0" Style="{StaticResource InsightsHeroCardStyle}">
                            <Grid ColumnSpacing="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE823;" FontSize="32"
                                          Foreground="{ThemeResource AppPrimaryColorBrush}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.PeakHourText, Mode=OneWay}"
                                               Style="{StaticResource InsightsHeroValueStyle}" />
                                    <TextBlock Text="{x:Bind resources:Strings.InsightsPage_PeakHour, Mode=OneTime}"
                                               Style="{StaticResource InsightsHeroCaptionStyle}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Grid x:Name="HeroCard4" Grid.Column="3" Grid.Row="0" Style="{StaticResource InsightsHeroCardStyle}">
                            <Grid ColumnSpacing="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE787;" FontSize="32"
                                          Foreground="{ThemeResource AppPrimaryColorBrush}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.MostActiveDayText, Mode=OneWay}"
                                               Style="{StaticResource InsightsHeroValueStyle}" />
                                    <TextBlock Text="{x:Bind resources:Strings.InsightsPage_MostActiveDay, Mode=OneTime}"
                                               Style="{StaticResource InsightsHeroCaptionStyle}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>

                    <Grid x:Name="Row2Grid" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ContentPresenter x:Name="TopSongsCard" Grid.Column="0" Grid.Row="0"
                                          Content="{x:Bind ViewModel.Songs}"
                                          ContentTemplate="{StaticResource InsightsCategoryCardTemplate}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch" />

                        <ContentPresenter x:Name="TopArtistsCard" Grid.Column="1" Grid.Row="0"
                                          Content="{x:Bind ViewModel.Artists}"
                                          ContentTemplate="{StaticResource InsightsCategoryCardTemplate}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch" />
                    </Grid>

                    <Grid x:Name="Row3Grid" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ContentPresenter x:Name="TopAlbumsCard" Grid.Column="0" Grid.Row="0"
                                          Content="{x:Bind ViewModel.Albums}"
                                          ContentTemplate="{StaticResource InsightsCategoryCardTemplate}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch" />

                        <ContentPresenter x:Name="TopGenresCard" Grid.Column="1" Grid.Row="0"
                                          Content="{x:Bind ViewModel.Genres}"
                                          ContentTemplate="{StaticResource InsightsCategoryCardTemplate}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch" />
                    </Grid>

                    <Grid Style="{StaticResource InsightsCardStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{x:Bind resources:Strings.InsightsPage_Sources, Mode=OneTime}"
                                   Style="{StaticResource InsightsCardHeaderStyle}"
                                   Visibility="{x:Bind ViewModel.SourceSegments.Count, Mode=OneWay, Converter={StaticResource CollectionCountToVisibilityConverter}}" />

                        <ItemsRepeater Grid.Row="1"
                                       ItemsSource="{x:Bind ViewModel.SourceSegments, Mode=OneWay}"
                                       Margin="0,12,0,0">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="insights:SourceSegment">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind Label}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <ProgressBar Grid.Column="1"
                                                     AutomationProperties.AccessibilityView="Raw"
                                                     Value="{x:Bind Percentage}"
                                                     Maximum="100"
                                                     Height="8"
                                                     Foreground="{x:Bind uihelpers:PlaybackContextBrushes.For(ContextType)}"
                                                     CornerRadius="{ThemeResource ControlCornerRadius}"
                                                     VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Text="{x:Bind PercentageText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Grid>

                </StackPanel>
            </Grid>

        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="20" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <FontIcon Glyph="&#xE9D2;"
                      FontSize="48"
                      Margin="0,0,0,12"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      HorizontalAlignment="Center" />
            <TextBlock HorizontalAlignment="Center"
                       Text="{x:Bind resources:Strings.InsightsPage_Empty_Title, Mode=OneTime}"
                       Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock HorizontalAlignment="Center"
                       Text="{x:Bind resources:Strings.InsightsPage_Empty_Subtitle, Mode=OneTime}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>

    </Grid>
</pages:ViewModelPage>
