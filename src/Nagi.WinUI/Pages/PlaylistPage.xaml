<Page
    x:Class="Nagi.WinUI.Pages.PlaylistPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lists="using:Nagi.Presentation.Lists"
    xmlns:resources="using:Nagi.Presentation.Resources"
    xmlns:uicontrols="using:Nagi.WinUI.Controls"
    xmlns:controls="using:ImageEx"
    x:Name="PlaylistPageRoot"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="PlaylistBadgeStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{StaticResource AppPrimaryColorBrush}" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PageContainerPaddingVertical}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              ColumnSpacing="8"
              Margin="{StaticResource CollectionPageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind resources:Strings.PlaylistPage_Title, Mode=OneTime}" Style="{StaticResource PageTitleTextStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <uicontrols:SearchToggle SearchTerm="{x:Bind ViewModel.SearchTerm, Mode=TwoWay}" PlaceholderText="{x:Bind resources:Strings.PlaylistPage_SearchBox_Placeholder, Mode=OneTime}" SearchToolTip="{x:Bind resources:Strings.PlaylistPage_SearchButton_Search_ToolTip, Mode=OneTime}" />

                <uicontrols:SortButton Selection="{x:Bind ViewModel.Sort}" />

                <Button
                        ToolTipService.ToolTip="{x:Bind resources:Strings.Generic_PickRandom, Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind resources:Strings.Generic_PickRandom, Mode=OneTime}"
                        Style="{StaticResource SongListViewPageIconButton}"
                        Command="{x:Bind ViewModel.PlayRandomPlaylistCommand}"
                        Margin="0,0,1,0"
                        ContentTemplate="{StaticResource RandomPlayIconTemplate}" />

            </StackPanel>

            <DropDownButton
                Grid.Column="2"
                IsEnabled="{x:Bind ViewModel.IsAnyOperationInProgress, Converter={StaticResource BooleanToInverseBooleanConverter}, Mode=OneWay}"
                Style="{StaticResource AnimatedAccentButtonStyle}"
                ToolTipService.ToolTip="{x:Bind resources:Strings.PlaylistPage_NewPlaylistButton_ToolTip, Mode=OneTime}"
                AutomationProperties.Name="{x:Bind resources:Strings.PlaylistPage_NewPlaylistButton_ToolTip, Mode=OneTime}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" />
                    <TextBlock Text="{x:Bind resources:Strings.PlaylistPage_NewPlaylistButton_Content, Mode=OneTime}" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="{x:Bind resources:Strings.PlaylistPage_NewPlaylistMenu_Regular, Mode=OneTime}" Command="{x:Bind ViewModel.CreatePlaylistCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE90B;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="{x:Bind resources:Strings.PlaylistPage_NewPlaylistMenu_Smart, Mode=OneTime}" Command="{x:Bind ViewModel.CreateSmartPlaylistCommand}">
                            <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE71C;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <Grid Grid.Row="1">
            <GridView uihelpers:ScrollEdgeFade.IsEnabled="True"
                IsItemClickEnabled="True"
                ItemClick="PlaylistsGridView_ItemClick"
                Padding="{StaticResource PageContentPadding}"
                ItemContainerStyle="{StaticResource AnimatedGridViewItemStyle}"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.HasItems, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid ItemWidth="{StaticResource CollectionGridItemWidth}" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="lists:PlaylistViewModelItem">
                    <Grid
                        Width="{StaticResource CollectionCardWidth}"
                        Height="{StaticResource CollectionCardHeight}"
                        Margin="{StaticResource CollectionCardMargin}"
                        Background="Transparent">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    Command="{Binding DataContext.PlayPlaylistCommand, ElementName=PlaylistPageRoot}"
                                    CommandParameter="{x:Bind}"
                                    Text="{x:Bind resources:Strings.Generic_Play, Mode=OneTime}"
                                    IsEnabled="{Binding DataContext.IsAnyOperationInProgress, ElementName=PlaylistPageRoot, Converter={StaticResource BooleanToInverseBooleanConverter}}" />
                                <MenuFlyoutItem Text="{x:Bind resources:Strings.PlaylistPage_Context_Rename, Mode=OneTime}" Command="{Binding DataContext.RenamePlaylistCommand, ElementName=PlaylistPageRoot}" CommandParameter="{x:Bind}"
                                    Visibility="{x:Bind IsFromServer, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <MenuFlyoutSeparator Visibility="{x:Bind IsFromServer, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <MenuFlyoutItem Text="{x:Bind resources:Strings.Generic_ChangeImage, Mode=OneTime}" Command="{Binding DataContext.ChangePlaylistCoverCommand, ElementName=PlaylistPageRoot}" CommandParameter="{x:Bind}"
                                    Visibility="{x:Bind IsFromServer, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <MenuFlyoutItem
                                    Command="{Binding DataContext.RemovePlaylistCoverCommand, ElementName=PlaylistPageRoot}"
                                    CommandParameter="{x:Bind}"
                                    Text="{x:Bind resources:Strings.Generic_RemoveImage, Mode=OneTime}"
                                    Visibility="{x:Bind IsCustomImage, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <MenuFlyoutSeparator Visibility="{x:Bind IsFromServer, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <MenuFlyoutItem Text="{x:Bind resources:Strings.PlaylistPage_Context_Delete, Mode=OneTime}" Command="{Binding DataContext.DeletePlaylistCommand, ElementName=PlaylistPageRoot}" CommandParameter="{x:Bind}"
                                    Visibility="{x:Bind IsFromServer, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            Grid.Row="0"
                            Width="{StaticResource CollectionCardImageSize}"
                            Height="{StaticResource CollectionCardImageSize}"
                            HorizontalAlignment="Center">
                            <Border
                                CornerRadius="{StaticResource ArtworkCornerRadius}"
                                Visibility="{x:Bind IsArtworkAvailable, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                <controls:ImageEx Width="{StaticResource CollectionCardImageSize}" Height="{StaticResource CollectionCardImageSize}"
                                    IsCacheEnabled="True"
                                    Source="{x:Bind CoverImageUri, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}, FallbackValue=null}"
                                    DecodePixelWidth="{StaticResource CollectionCardImageSize}"
                                    DecodePixelType="Logical"
                                    Stretch="UniformToFill" />
                            </Border>
                            <Grid
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="{StaticResource ArtworkCornerRadius}"
                                Visibility="{x:Bind IsArtworkAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="48"
                                    Glyph="&#xE90B;" />
                            </Grid>
                            <Border Style="{StaticResource PlaylistBadgeStyle}" Visibility="{x:Bind IsSmart, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE71C;" FontSize="12" Foreground="{StaticResource TextOnAppPrimaryBrush}" />
                            </Border>
                            <Border Style="{StaticResource PlaylistBadgeStyle}" Visibility="{x:Bind IsFromServer, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE8CE;" FontSize="12" Foreground="{StaticResource TextOnAppPrimaryBrush}" />
                            </Border>
                        </Grid>

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{x:Bind Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            Grid.Row="2"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            Opacity="0.7"
                            Text="{x:Bind Subtitle, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
            </GridView>

            <uicontrols:EmptyState Glyph="&#xE90B;"
                                   Title="{x:Bind resources:Strings.PlaylistPage_EmptyState_Title, Mode=OneTime}"
                                   Subtitle="{x:Bind resources:Strings.PlaylistPage_EmptyState_Subtitle, Mode=OneTime}"
                                   IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                                   HasLoadError="{x:Bind ViewModel.HasLoadError, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
