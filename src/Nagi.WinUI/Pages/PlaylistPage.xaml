<pages:CollectionPage x:Class="Nagi.WinUI.Pages.PlaylistPage"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:lists="using:Nagi.Presentation.Lists"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:pages="using:Nagi.WinUI.Pages"
                      xmlns:resources="using:Nagi.Presentation.Resources"
                      xmlns:uicontrols="using:Nagi.WinUI.Controls"
                      x:Name="Root"
                      Background="Transparent"
                      NavigationCacheMode="Enabled"
                      mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="PlaylistBadgeStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{StaticResource AppPrimaryColorBrush}" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PageContainerPaddingVertical}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <uicontrols:CollectionPageHeader Title="{x:Bind resources:Strings.PlaylistPage_Title}"
                                         Grid.Row="0"
                                         Margin="{StaticResource CollectionPageHeaderMargin}"
                                         SearchPlaceholder="{x:Bind resources:Strings.PlaylistPage_SearchBox_Placeholder}"
                                         SearchToolTip="{x:Bind resources:Strings.PlaylistPage_SearchButton_Search_ToolTip}"
                                         ViewModel="{x:Bind ViewModel}">
            <uicontrols:CollectionPageHeader.ExtraContent>
                <DropDownButton AutomationProperties.Name="{x:Bind resources:Strings.PlaylistPage_NewPlaylistButton_ToolTip, Mode=OneTime}"
                                IsEnabled="{x:Bind ViewModel.IsAnyOperationInProgress, Converter={StaticResource BooleanToInverseBooleanConverter}, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind resources:Strings.PlaylistPage_NewPlaylistButton_ToolTip, Mode=OneTime}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" />
                        <TextBlock Text="{x:Bind resources:Strings.PlaylistPage_NewPlaylistButton_Content, Mode=OneTime}" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Command="{x:Bind ViewModel.CreatePlaylistCommand}" Text="{x:Bind resources:Strings.PlaylistPage_NewPlaylistMenu_Regular, Mode=OneTime}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE90B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind ViewModel.CreateSmartPlaylistCommand}" Text="{x:Bind resources:Strings.PlaylistPage_NewPlaylistMenu_Smart, Mode=OneTime}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE71C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </uicontrols:CollectionPageHeader.ExtraContent>
        </uicontrols:CollectionPageHeader>

        <Grid Grid.Row="1">
            <GridView x:Name="CollectionGrid"
                      ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                      Style="{StaticResource CollectionGridViewStyle}">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid ItemWidth="{StaticResource CollectionGridItemWidth}" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="lists:PlaylistViewModelItem">
                        <Grid Width="{StaticResource CollectionCardWidth}"
                              Height="{StaticResource CollectionCardHeight}"
                              Margin="{StaticResource CollectionCardMargin}"
                              Background="Transparent">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Command="{Binding ViewModel.PlayPlaylistCommand, ElementName=Root}"
                                                    CommandParameter="{x:Bind}"
                                                    Text="{x:Bind resources:Strings.Generic_Play, Mode=OneTime}" />
                                    <MenuFlyoutItem Command="{Binding ViewModel.RenamePlaylistCommand, ElementName=Root}"
                                                    CommandParameter="{x:Bind}"
                                                    Text="{x:Bind resources:Strings.PlaylistPage_Context_Rename, Mode=OneTime}"
                                                    Visibility="{x:Bind IsFromServer, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <MenuFlyoutSeparator Visibility="{x:Bind IsFromServer, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <MenuFlyoutItem Command="{Binding ViewModel.ChangePlaylistCoverCommand, ElementName=Root}"
                                                    CommandParameter="{x:Bind}"
                                                    Text="{x:Bind resources:Strings.Generic_ChangeImage, Mode=OneTime}"
                                                    Visibility="{x:Bind IsFromServer, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <MenuFlyoutItem Command="{Binding ViewModel.RemovePlaylistCoverCommand, ElementName=Root}"
                                                    CommandParameter="{x:Bind}"
                                                    Text="{x:Bind resources:Strings.Generic_RemoveImage, Mode=OneTime}"
                                                    Visibility="{x:Bind IsCustomImage, Mode=OneWay}" />
                                    <MenuFlyoutSeparator Visibility="{x:Bind IsFromServer, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <MenuFlyoutItem Command="{Binding ViewModel.DeletePlaylistCommand, ElementName=Root}"
                                                    CommandParameter="{x:Bind}"
                                                    Text="{x:Bind resources:Strings.PlaylistPage_Context_Delete, Mode=OneTime}"
                                                    Visibility="{x:Bind IsFromServer, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Width="{StaticResource CollectionCardImageSize}"
                                  Height="{StaticResource CollectionCardImageSize}"
                                  HorizontalAlignment="Center">
                                <uicontrols:ArtworkImage PlaceholderGlyph="&#xE90B;"
                                                         Size="{StaticResource CollectionCardImageSize}"
                                                         Source="{x:Bind CoverImageUri, Mode=OneWay}" />
                                <Border Style="{StaticResource PlaylistBadgeStyle}" Visibility="{x:Bind IsSmart}">
                                    <FontIcon FontSize="12"
                                              Foreground="{StaticResource TextOnAppPrimaryBrush}"
                                              Glyph="&#xE71C;" />
                                </Border>
                                <Border Style="{StaticResource PlaylistBadgeStyle}" Visibility="{x:Bind IsFromServer}">
                                    <FontIcon FontSize="12"
                                              Foreground="{StaticResource TextOnAppPrimaryBrush}"
                                              Glyph="&#xE8CE;" />
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource CollectionCardTitleTextBlockStyle}"
                                       Text="{x:Bind Name, Mode=OneWay}" />
                            <TextBlock Grid.Row="2"
                                       Style="{StaticResource CollectionCardSubtitleTextBlockStyle}"
                                       Text="{x:Bind Subtitle, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <uicontrols:EmptyState Title="{x:Bind resources:Strings.PlaylistPage_EmptyState_Title, Mode=OneTime}"
                                   Glyph="&#xE90B;"
                                   HasLoadError="{x:Bind ViewModel.HasLoadError, Mode=OneWay}"
                                   IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                                   Subtitle="{x:Bind resources:Strings.PlaylistPage_EmptyState_Subtitle, Mode=OneTime}" />
        </Grid>
    </Grid>
</pages:CollectionPage>
