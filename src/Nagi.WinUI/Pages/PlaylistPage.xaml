<pages:SearchablePage
    xmlns:pages="using:Nagi.WinUI.Pages"
    x:Class="Nagi.WinUI.Pages.PlaylistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Nagi.Presentation.ViewModels"
    xmlns:resources="using:Nagi.Presentation.Resources"
    xmlns:helpers="using:Nagi.Core.Helpers"
    xmlns:controls="using:ImageEx"
    x:Name="PlaylistPageRoot"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PageContainerPaddingVertical}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SearchStates">
                <VisualState x:Name="SearchCollapsed">
                    <VisualState.Setters>
                        <Setter Target="SearchTextBox.Width" Value="0" />
                        <Setter Target="SearchTextBox.Opacity" Value="0" />
                        <Setter Target="SearchTextBox.IsHitTestVisible" Value="False" />
                        <Setter Target="SearchTextBox.IsTabStop" Value="False" />
                        <Setter Target="SearchIcon.Glyph" Value="&#xE721;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SearchExpanded">
                    <VisualState.Setters>
                        <Setter Target="SearchTextBox.Width" Value="{StaticResource SearchBoxExpandedWidth}" />
                        <Setter Target="SearchTextBox.Opacity" Value="1" />
                        <Setter Target="SearchTextBox.IsHitTestVisible" Value="True" />
                        <Setter Target="SearchTextBox.IsTabStop" Value="True" />
                        <Setter Target="SearchIcon.Glyph" Value="&#xE711;" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              ColumnSpacing="8"
              Margin="{StaticResource CollectionPageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind resources:Strings.PlaylistPage_Title, Mode=OneTime}" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock
                    Margin="0,0,0,5"
                    VerticalAlignment="Bottom"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.StatusMessage, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Grid>
                    <TextBox x:Name="SearchTextBox"
                             PlaceholderText="{x:Bind resources:Strings.PlaylistPage_SearchBox_Placeholder, Mode=OneTime}"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Width="0"
                             Opacity="0"
                             IsHitTestVisible="False"
                             IsTabStop="False"
                             HorizontalAlignment="Right"
                             KeyDown="OnSearchTextBoxKeyDown"
                             Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Canvas.ZIndex="0">
                        <TextBox.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.15" />
                        </TextBox.OpacityTransition>
                    </TextBox>
                    <Button x:Name="SearchToggleButton"
                            ToolTipService.ToolTip="{x:Bind resources:Strings.PlaylistPage_SearchButton_Search_ToolTip, Mode=OneTime}"
                            AutomationProperties.Name="{x:Bind resources:Strings.PlaylistPage_SearchButton_Search_ToolTip, Mode=OneTime}"
                            Click="OnSearchToggleButtonClick"
                            Style="{StaticResource SongListViewPageIconButton}"
                            HorizontalAlignment="Right"
                            Margin="0,0,1,0"
                            Canvas.ZIndex="1">
                        <FontIcon x:Name="SearchIcon" FontSize="16" Glyph="&#xE721;" />
                    </Button>
                </Grid>

                <Button Style="{StaticResource SongListViewPageIconButton}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.CurrentSortOrderText, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.CurrentSortOrderText, Mode=OneWay}">
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <RadioMenuFlyoutItem GroupName="PlaylistSort" Command="{x:Bind ViewModel.ChangeSortOrderCommand}"
                                            CommandParameter="NameAsc" Text="{x:Bind helpers:SortOrderHelper.TitleAscLabel}"
                                            IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=NameAsc}" />
                            <RadioMenuFlyoutItem GroupName="PlaylistSort" Command="{x:Bind ViewModel.ChangeSortOrderCommand}"
                                            CommandParameter="NameDesc" Text="{x:Bind helpers:SortOrderHelper.TitleDescLabel}"
                                            IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=NameDesc}" />
                            <RadioMenuFlyoutItem GroupName="PlaylistSort" Command="{x:Bind ViewModel.ChangeSortOrderCommand}"
                                            CommandParameter="DateCreatedAsc"
                                            Text="{x:Bind helpers:SortOrderHelper.DateCreatedOldestLabel}"
                                            IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=DateCreatedAsc}" />
                            <RadioMenuFlyoutItem GroupName="PlaylistSort" Command="{x:Bind ViewModel.ChangeSortOrderCommand}"
                                            CommandParameter="DateCreatedDesc"
                                            Text="{x:Bind helpers:SortOrderHelper.DateCreatedNewestLabel}"
                                            IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=DateCreatedDesc}" />
                            <RadioMenuFlyoutItem GroupName="PlaylistSort" Command="{x:Bind ViewModel.ChangeSortOrderCommand}"
                                            CommandParameter="DateModifiedAsc"
                                            Text="{x:Bind helpers:SortOrderHelper.ModifiedOldestLabel}"
                                            IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=DateModifiedAsc}" />
                            <RadioMenuFlyoutItem GroupName="PlaylistSort" Command="{x:Bind ViewModel.ChangeSortOrderCommand}"
                                            CommandParameter="DateModifiedDesc"
                                            Text="{x:Bind helpers:SortOrderHelper.ModifiedNewestLabel}"
                                            IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=DateModifiedDesc}" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <FontIcon FontSize="16" Glyph="&#xE8CB;" />
                </Button>

                <Button x:Name="RandomPlaylistButton"
                        ToolTipService.ToolTip="{x:Bind resources:Strings.PlaylistPage_RandomButton_ToolTip, Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind resources:Strings.PlaylistPage_RandomButton_ToolTip, Mode=OneTime}"
                        Style="{StaticResource SongListViewPageIconButton}"
                        Command="{x:Bind ViewModel.PlayRandomPlaylistCommand}"
                        Margin="0,0,1,0"
                        ContentTemplate="{StaticResource RandomPlayIconTemplate}" />

            </StackPanel>

            <DropDownButton
                Grid.Column="2"
                IsEnabled="{x:Bind ViewModel.IsAnyOperationInProgress, Converter={StaticResource BooleanToInverseBooleanConverter}, Mode=OneWay}"
                Style="{StaticResource AnimatedAccentButtonStyle}"
                ToolTipService.ToolTip="{x:Bind resources:Strings.PlaylistPage_NewPlaylistButton_ToolTip, Mode=OneTime}"
                AutomationProperties.Name="{x:Bind resources:Strings.PlaylistPage_NewPlaylistButton_ToolTip, Mode=OneTime}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" />
                    <TextBlock Text="{x:Bind resources:Strings.PlaylistPage_NewPlaylistButton_Content, Mode=OneTime}" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="{x:Bind resources:Strings.PlaylistPage_NewPlaylistMenu_Regular, Mode=OneTime}" Command="{x:Bind ViewModel.CreatePlaylistCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE90B;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="{x:Bind resources:Strings.PlaylistPage_NewPlaylistMenu_Smart, Mode=OneTime}" Command="{x:Bind ViewModel.CreateSmartPlaylistCommand}">
                            <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE71C;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <Grid Grid.Row="1">
            <GridView uihelpers:ScrollEdgeFade.IsEnabled="True"
                IsItemClickEnabled="True"
                ItemClick="PlaylistsGridView_ItemClick"
                Padding="{StaticResource PageContentPadding}"
                ItemContainerStyle="{StaticResource AnimatedGridViewItemStyle}"
                ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.HasPlaylists, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid ItemWidth="{StaticResource CollectionGridItemWidth}" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:PlaylistViewModelItem">
                    <Grid
                        Width="{StaticResource CollectionCardWidth}"
                        Height="{StaticResource CollectionCardHeight}"
                        Margin="{StaticResource CollectionCardMargin}"
                        Background="Transparent">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    Command="{Binding DataContext.PlayPlaylistCommand, ElementName=PlaylistPageRoot}"
                                    CommandParameter="{x:Bind}"
                                    Text="{x:Bind resources:Strings.PlaylistPage_Context_Play, Mode=OneTime}"
                                    IsEnabled="{Binding DataContext.IsAnyOperationInProgress, ElementName=PlaylistPageRoot, Converter={StaticResource BooleanToInverseBooleanConverter}}" />
                                <MenuFlyoutItem Text="{x:Bind resources:Strings.PlaylistPage_Context_Rename, Mode=OneTime}" Command="{Binding DataContext.RenamePlaylistCommand, ElementName=PlaylistPageRoot}" CommandParameter="{x:Bind}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="{x:Bind resources:Strings.PlaylistPage_Context_ChangeImage, Mode=OneTime}" Command="{Binding DataContext.ChangePlaylistCoverCommand, ElementName=PlaylistPageRoot}" CommandParameter="{x:Bind}" />
                                <MenuFlyoutItem
                                    Command="{Binding DataContext.RemovePlaylistCoverCommand, ElementName=PlaylistPageRoot}"
                                    CommandParameter="{x:Bind}"
                                    Text="{x:Bind resources:Strings.PlaylistPage_Context_RemoveImage, Mode=OneTime}"
                                    Visibility="{x:Bind IsCustomImage, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="{x:Bind resources:Strings.PlaylistPage_Context_Delete, Mode=OneTime}" Command="{Binding DataContext.DeletePlaylistCommand, ElementName=PlaylistPageRoot}" CommandParameter="{x:Bind}" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            Grid.Row="0"
                            Width="{StaticResource CollectionCardImageSize}"
                            Height="{StaticResource CollectionCardImageSize}"
                            HorizontalAlignment="Center">
                            <Border
                                CornerRadius="{StaticResource ArtworkCornerRadius}"
                                Visibility="{x:Bind IsArtworkAvailable, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                <controls:ImageEx Width="{StaticResource CollectionCardImageSize}" Height="{StaticResource CollectionCardImageSize}"
                                    IsCacheEnabled="True"
                                    Source="{x:Bind CoverImageUri, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}, FallbackValue=null}"
                                    DecodePixelWidth="{StaticResource CollectionCardImageSize}"
                                    DecodePixelType="Logical"
                                    Stretch="UniformToFill" />
                            </Border>
                            <Grid
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="{StaticResource ArtworkCornerRadius}"
                                Visibility="{x:Bind IsArtworkAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="48"
                                    Glyph="&#xE90B;" />
                            </Grid>
                            <!-- Smart playlist badge -->
                            <Border
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,4,4"
                                Padding="8,4"
                                Background="{StaticResource AppPrimaryColorBrush}"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Visibility="{x:Bind IsSmart, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE71C;" FontSize="12" Foreground="{StaticResource TextOnAppPrimaryBrush}" />
                            </Border>
                        </Grid>

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{x:Bind Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            Grid.Row="2"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            Opacity="0.7"
                            Text="{x:Bind SongCountText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
            </GridView>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                Visibility="{x:Bind ViewModel.HasPlaylists, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="20" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <FontIcon
                    Glyph="&#xE90B;"
                    FontSize="48"
                    Margin="0,0,0,12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind resources:Strings.PlaylistPage_EmptyState_Title, Mode=OneTime}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind resources:Strings.PlaylistPage_EmptyState_Subtitle, Mode=OneTime}" />
            </StackPanel>
        </Grid>
    </Grid>
</pages:SearchablePage>
