<pages:ViewModelPage x:Class="Nagi.WinUI.Pages.LyricsPage"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:helpers="using:Nagi.WinUI.Helpers"
                     xmlns:lyrics="using:Nagi.Core.Lyrics"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:pages="using:Nagi.WinUI.Pages"
                     xmlns:resources="using:Nagi.Presentation.Resources"
                     xmlns:uicontrols="using:Nagi.WinUI.Controls"
                     Background="Transparent"
                     Loaded="OnPageLoaded"
                     mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <Storyboard x:Key="PageLoadStoryboard">
                <DoubleAnimation Storyboard.TargetName="LyricsContainer"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0"
                                 To="1"
                                 Duration="0:0:0.5">
                    <DoubleAnimation.EasingFunction>
                        <ExponentialEase EasingMode="EaseOut" Exponent="3" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="LyricsContainer"
          Padding="{StaticResource PageContainerPaddingVertical}"
          Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMarginIndented}">
            <TextBlock MaxWidth="1200"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource AccentTextBrush}"
                       MaxLines="1"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Text="{x:Bind ViewModel.SongTitle, Mode=OneWay}"
                       TextWrapping="NoWrap" />
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind resources:Strings.LyricsPage_EditLyrics_ToolTip, Mode=OneTime}"
                    Command="{x:Bind ViewModel.EditLyricsCommand}"
                    IsEnabled="{x:Bind ViewModel.CanEditLyrics, Mode=OneWay}"
                    Style="{StaticResource SongListViewPageIconButton}"
                    ToolTipService.ToolTip="{x:Bind resources:Strings.LyricsPage_EditLyrics_ToolTip, Mode=OneTime}">
                <FontIcon FontSize="16" Glyph="&#xE70F;" />
            </Button>
        </Grid>

        <ProgressBar x:Name="LyricsProgressBar"
                     Grid.Row="1"
                     MaxWidth="600"
                     Margin="{StaticResource PageHeaderMarginIndented}"
                     Maximum="100"
                     Style="{StaticResource LyricsProgressBarStyle}"
                     Visibility="{x:Bind ViewModel.HasLyrics, Mode=OneWay}" />

        <ScrollViewer x:Name="LyricsScrollViewer"
                      Grid.Row="2"
                      Background="Transparent"
                      HorizontalScrollBarVisibility="Disabled"
                      SizeChanged="LyricsScrollViewer_SizeChanged"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{x:Bind ViewModel.HasLyrics, Mode=OneWay}">
            <StackPanel>
                <Border x:Name="TopSpacer" />
                <ItemsRepeater x:Name="LyricsRepeater"
                               ElementClearing="LyricsRepeater_ElementClearing"
                               ElementPrepared="LyricsRepeater_ElementPrepared"
                               ItemsSource="{x:Bind ViewModel.LyricLines, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <helpers:NonVirtualizingStackLayout />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="lyrics:LyricLine">
                            <Grid Padding="32,28"
                                  Background="Transparent"
                                  CornerRadius="{ThemeResource ControlCornerRadius}"
                                  PointerEntered="LyricItem_PointerEntered"
                                  PointerExited="LyricItem_PointerExited"
                                  Tag="{x:Bind}"
                                  Tapped="LyricItem_Tapped">
                                <StackPanel x:Name="BaseLayer" Spacing="8">
                                    <TextBlock Style="{StaticResource LyricLineTextBlockStyle}" Text="{x:Bind Text}" />
                                    <TextBlock Style="{StaticResource SecondaryLyricLineTextBlockStyle}"
                                               Text="{x:Bind RomanizedText}"
                                               Visibility="{x:Bind HasRomanizedText, Mode=OneTime}" />
                                    <TextBlock Style="{StaticResource SecondaryLyricLineTextBlockStyle}"
                                               Text="{x:Bind TranslatedText}"
                                               Visibility="{x:Bind HasTranslatedText, Mode=OneTime}" />
                                </StackPanel>
                                <!--  Opacity is set through Composition.  -->
                                <StackPanel x:Name="ActiveLayer" Spacing="8">
                                    <TextBlock Foreground="{StaticResource AccentTextBrush}"
                                               Style="{StaticResource LyricLineTextBlockStyle}"
                                               Text="{x:Bind Text}" />
                                    <TextBlock Foreground="{StaticResource AccentTextBrush}"
                                               Style="{StaticResource SecondaryLyricLineTextBlockStyle}"
                                               Text="{x:Bind RomanizedText}"
                                               Visibility="{x:Bind HasRomanizedText, Mode=OneTime}" />
                                    <TextBlock Foreground="{StaticResource AccentTextBrush}"
                                               Style="{StaticResource SecondaryLyricLineTextBlockStyle}"
                                               Text="{x:Bind TranslatedText}"
                                               Visibility="{x:Bind HasTranslatedText, Mode=OneTime}" />
                                </StackPanel>
                                <!--  Drawn beneath the text, out over the padding.  -->
                                <Border x:Name="HoverBackground"
                                        Margin="-32,-28"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        Canvas.ZIndex="-1"
                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <Border x:Name="BottomSpacer" />
            </StackPanel>
        </ScrollViewer>

        <ListView Grid.Row="2"
                  Padding="{StaticResource PageContentPadding}"
                  HorizontalContentAlignment="Stretch"
                  Background="Transparent"
                  IsItemClickEnabled="False"
                  ItemContainerStyle="{StaticResource PaddedListViewItemStyle}"
                  ItemsSource="{x:Bind ViewModel.UnsyncedLyricLines, Mode=OneWay}"
                  SelectionMode="None"
                  Visibility="{x:Bind ViewModel.HasUnsyncedLyrics, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="lyrics:LyricLine">
                    <StackPanel>
                        <TextBlock Opacity="1.0"
                                   Style="{StaticResource InactiveLyricLineStyle}"
                                   Text="{x:Bind Text}" />
                        <TextBlock Style="{StaticResource SecondaryInactiveLyricLineStyle}"
                                   Text="{x:Bind RomanizedText}"
                                   Visibility="{x:Bind HasRomanizedText, Mode=OneTime}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <uicontrols:EmptyState Title="{x:Bind resources:Strings.LyricsPage_NoLyrics_Title, Mode=OneTime}"
                               Grid.Row="2"
                               Glyph="&#xED1E;"
                               IsShown="{x:Bind ViewModel.ShowNoLyricsMessage, Mode=OneWay}"
                               Subtitle="{x:Bind resources:Strings.LyricsPage_NoLyrics_Subtitle, Mode=OneTime}" />

        <ProgressRing Grid.Row="2"
                      Width="48"
                      Height="48"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
    </Grid>
</pages:ViewModelPage>
