                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE713;" />
                            </controls:SettingsExpander.HeaderIcon>
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard
                                    Header="{x:Bind resources:Strings.SettingsPage_ListenBrainz_ServerUrlLabel, Mode=OneTime}">
                                    <TextBox
                                        Width="300"
                                        HorizontalAlignment="Right"
                                        PlaceholderText="{x:Bind resources:Strings.SettingsPage_ListenBrainz_ServerUrlPlaceholder, Mode=OneTime}"
                                        Text="{x:Bind ViewModel.Scrobbling.ListenBrainzServerUrl, Mode=TwoWay}" />
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
