                    </TextBlock>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <HyperlinkButton
                                    Content="{x:Bind resources:Strings.SettingsPage_About_Licenses_Content, Mode=OneTime}"
                                    Style="{StaticResource AnimatedHyperlinkButtonStyle}"
                                    NavigateUri="https://github.com/Anthonyy232/Nagi/blob/master/LICENSE" />
                                <HyperlinkButton
                                    Content="{x:Bind resources:Strings.SettingsPage_About_SourceCode_Content, Mode=OneTime}"
                                    Style="{StaticResource AnimatedHyperlinkButtonStyle}"
                                    NavigateUri="https://github.com/Anthonyy232/Nagi" />
                            </StackPanel>
                        </controls:SettingsCard>
