                                <Button
                                    Command="{x:Bind ViewModel.Scrobbling.TestListenBrainzConnectionCommand}"
                                    Content="{x:Bind resources:Strings.SettingsPage_ListenBrainz_TestConnection, Mode=OneTime}" />
                            </StackPanel>
