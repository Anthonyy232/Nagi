<Page
    x:Class="Nagi.WinUI.Pages.SettingsPage"
    x:Name="SettingsPageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreModels="using:Nagi.Core.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:localConverters="using:Nagi.WinUI.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Nagi.WinUI.Models"
    xmlns:navigation="using:Nagi.WinUI.Navigation"
    xmlns:resources="using:Nagi.WinUI.Resources"
    xmlns:viewmodels="using:Nagi.WinUI.ViewModels"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Required">


    <Page.Resources>
        <Style TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
        </Style>
        <localConverters:AppThemeToFriendlyStringConverter x:Key="ThemeToStringConverter" />
        <localConverters:ArgbColorToColorConverter x:Key="ArgbColorToColorConverter" />
        <localConverters:BackdropMaterialToStringConverter x:Key="BackdropMaterialToStringConverter" />
        <localConverters:FloatToDecimalStringConverter x:Key="FloatToDecimalStringConverter" />
        <localConverters:PlayerBackgroundMaterialToStringConverter x:Key="PlayerBackgroundMaterialToStringConverter" />
        <localConverters:DoubleToPercentageConverter x:Key="DoubleToPercentageConverter" />

        <!-- Shared template for service provider items in Lyrics and Metadata source lists -->
        <DataTemplate x:Key="ServiceProviderItemTemplate" x:DataType="viewmodels:ServiceProviderSettingViewModel">
            <Grid x:Name="ProviderItemRoot" Padding="12,8" VerticalAlignment="Center"
                  ToolTipService.ToolTip="{x:Bind Description}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Drag Handle -->
                <FontIcon
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE76F;" />

                <FontIcon
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    Foreground="{ThemeResource AppPrimaryColorBrush}"
                    Glyph="&#xE774;" />

                <TextBlock
                    Grid.Column="2"
                    Margin="8,0,12,0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Bind DisplayName}" />

                <ToggleSwitch
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RomanizationPackItemTemplate" x:DataType="viewmodels:RomanizationPackViewModel">
            <Border
                Padding="16,12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{x:Bind DisplayName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <Border
                                Grid.Column="1"
                                Padding="8,4"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind StatusText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </Border>
                        </Grid>

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Description, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind DetailsText, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <ProgressRing
                            Width="20"
                            Height="20"
                            IsActive="{x:Bind IsBusy, Mode=OneWay}"
                            Visibility="{x:Bind IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button
                            MinWidth="86"
                            Command="{Binding DataContext.Romanization.InstallRomanizationPackCommand, ElementName=SettingsPageRoot}"
                            CommandParameter="{x:Bind}"
                            Content="{x:Bind resources:Strings.SettingsPage_RomanizationPacks_Install, Mode=OneTime}"
                            IsEnabled="{x:Bind CanInstall, Mode=OneWay}"
                            Visibility="{x:Bind IsInstalled, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        <Button
                            MinWidth="86"
                            Command="{Binding DataContext.Romanization.InstallRomanizationPackCommand, ElementName=SettingsPageRoot}"
                            CommandParameter="{x:Bind}"
                            Content="{x:Bind resources:Strings.SettingsPage_RomanizationPacks_Update, Mode=OneTime}"
                            IsEnabled="{x:Bind CanInstall, Mode=OneWay}"
                            Visibility="{x:Bind IsUpdateAvailable, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button
                            MinWidth="86"
                            Command="{Binding DataContext.Romanization.RemoveRomanizationPackCommand, ElementName=SettingsPageRoot}"
                            CommandParameter="{x:Bind}"
                            Content="{x:Bind resources:Strings.SettingsPage_RomanizationPacks_Remove, Mode=OneTime}"
                            IsEnabled="{x:Bind CanRemove, Mode=OneWay}"
                            Visibility="{x:Bind IsInstalled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="{StaticResource PageContainerPaddingVertical}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            MaxWidth="1200"
            Margin="{StaticResource PageHeaderMarginIndented}"
            Style="{StaticResource SettingsPageTitleTextStyle}"
            Text="{x:Bind resources:Strings.SettingsPage_Title, Mode=OneTime}" />

        <ScrollViewer uihelpers:ScrollEdgeFade.IsEnabled="True"
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled">
            <Grid Padding="{StaticResource PageContentPadding}">
                <StackPanel
                    MaxWidth="1200"
                    HorizontalAlignment="Stretch"
                    Spacing="{StaticResource SettingsCardSpacing}">

                <TextBlock Margin="0,0,0,8" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Bind resources:Strings.SettingsPage_Section_Appearance, Mode=OneTime}" />

                <controls:SettingsExpander
                    x:Name="ThemeSettingsExpander"
                    Header="{x:Bind resources:Strings.SettingsPage_Theme_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_Theme_Description, Mode=OneTime}"
                    IsExpanded="False">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE793;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <ComboBox
                        MinWidth="300"
                        HorizontalAlignment="Right"
                        ItemsSource="{x:Bind ViewModel.Appearance.AvailableThemes}"
                        SelectedItem="{x:Bind ViewModel.Appearance.SelectedTheme, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:AppTheme">
                                <TextBlock Text="{x:Bind Converter={StaticResource ThemeToStringConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind resources:Strings.SettingsPage_AccentColor, Mode=OneTime}" VerticalAlignment="Center" />
                                    <HyperlinkButton
                                        VerticalAlignment="Center"
                                        Command="{x:Bind ViewModel.Appearance.ResetAccentColorCommand}"
                                        Style="{StaticResource AnimatedHyperlinkButtonStyle}"
                                        Content="{x:Bind resources:Strings.SettingsPage_ResetAccentColor_Content, Mode=OneTime}"
                                        FontSize="12"
                                        Padding="4,2" />
                                </StackPanel>
                            </controls:SettingsCard.Header>
                            <ColorPicker
                                HorizontalAlignment="Right"
                                Color="{x:Bind ViewModel.Appearance.AccentColor, Mode=TwoWay, Converter={StaticResource ArgbColorToColorConverter}}"
                                IsAlphaEnabled="False"
                                IsColorChannelTextInputVisible="False"
                                IsColorSliderVisible="True"
                                IsColorSpectrumVisible="True"
                                IsHexInputVisible="True" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_WindowMaterial_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_WindowMaterial_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE81E;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox
                        MinWidth="300"
                        HorizontalAlignment="Right"
                        ItemsSource="{x:Bind ViewModel.Appearance.AvailableBackdropMaterials}"
                        SelectedItem="{x:Bind ViewModel.Appearance.SelectedBackdropMaterial, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:BackdropMaterial">
                                <TextBlock
                                    Text="{x:Bind Converter={StaticResource BackdropMaterialToStringConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_DynamicTheming_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_DynamicTheming_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE790;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.Appearance.IsDynamicThemingEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <!-- Player Styling Settings -->
                <controls:SettingsExpander
                    Description="{x:Bind resources:Strings.SettingsPage_PlayerStyling_Description, Mode=OneTime}">
                    <controls:SettingsExpander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind resources:Strings.SettingsPage_PlayerStyling_Header, Mode=OneTime}" VerticalAlignment="Center" />
                            <HyperlinkButton
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.Appearance.ResetPlayerDesignSettingsCommand}"
                                Style="{StaticResource AnimatedHyperlinkButtonStyle}"
                                Content="{x:Bind resources:Strings.SettingsPage_ResetAccentColor_Content, Mode=OneTime}"
                                FontSize="12"
                                Padding="4,2" />
                        </StackPanel>
                    </controls:SettingsExpander.Header>
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE790;" />
                    </controls:SettingsExpander.HeaderIcon>

                    <ComboBox
                        MinWidth="300"
                        HorizontalAlignment="Right"
                        ItemsSource="{x:Bind ViewModel.Appearance.AvailablePlayerBackgroundMaterials}"
                        SelectedItem="{x:Bind ViewModel.Appearance.SelectedPlayerBackgroundMaterial, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:PlayerBackgroundMaterial">
                                <TextBlock Text="{x:Bind Converter={StaticResource PlayerBackgroundMaterialToStringConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                <StackPanel Orientation="Vertical" Spacing="4">
                                    <TextBlock Text="{x:Bind resources:Strings.SettingsPage_TintIntensity_Header, Mode=OneTime}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind resources:Strings.SettingsPage_TintIntensity_Description, Mode=OneTime}" />
                                </StackPanel>
                            </controls:SettingsCard.Header>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                                <Slider
                                    Width="300"
                                    VerticalAlignment="Center"
                                    Maximum="1.0"
                                    Minimum="0.0"
                                    StepFrequency="0.01"
                                    Style="{StaticResource DefaultSliderStyle}"
                                    ThumbToolTipValueConverter="{StaticResource DoubleToPercentageConverter}"
                                    Value="{x:Bind ViewModel.Appearance.PlayerTintIntensity, Mode=TwoWay}" />
                                <TextBlock
                                    Width="40"
                                    VerticalAlignment="Center"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.Appearance.PlayerTintIntensity, Mode=OneWay, Converter={StaticResource DoubleToPercentageConverter}}" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_Language_Header, Mode=OneTime}"
                    controls:SettingsCard.Description="{x:Bind resources:Strings.SettingsPage_Language_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE774;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox
                        MinWidth="200"
                        HorizontalAlignment="Right"
                        ItemsSource="{x:Bind ViewModel.Appearance.AvailableLanguages}"
                        SelectedItem="{x:Bind ViewModel.Appearance.SelectedLanguage, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:LanguageModel">
                                <TextBlock Text="{x:Bind DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_RememberWindowSize_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_RememberWindowSize_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE740;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.Appearance.IsRememberWindowSizeEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_RememberWindowPosition_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_RememberWindowPosition_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE707;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.Appearance.IsRememberWindowPositionEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_RememberNavState_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_RememberNavState_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE700;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.Appearance.IsRememberPaneStateEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_CustomizeNav_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_CustomizeNav_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE700;" />
                    </controls:SettingsCard.HeaderIcon>

                    <ListView
                        Width="350"
                        HorizontalAlignment="Right"
                        AllowDrop="True"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CanDragItems="True"
                        CanReorderItems="True"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        ItemContainerStyle="{StaticResource NavigationListViewItemStyle}"
                        ItemsSource="{x:Bind ViewModel.Appearance.NavigationItems}"
                        SelectionMode="Single">

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="navigation:NavigationItemSetting">
                                <Grid x:Name="NavItemRoot" Padding="12,8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Drag Handle -->
                                    <FontIcon
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE76F;" />

                                    <FontIcon
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        Foreground="{ThemeResource AppPrimaryColorBrush}"
                                        Glyph="{x:Bind IconGlyph}" />

                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="8,0,12,0"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind DisplayName}" />

                                    <ToggleSwitch
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </controls:SettingsCard>

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Bind resources:Strings.SettingsPage_Section_Player, Mode=OneTime}" />

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_VolumeNormalization_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_VolumeNormalization_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE995;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.Audio.IsVolumeNormalizationEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_WasapiExclusive_Header, Mode=OneTime}"
                    Description="{x:Bind resources:Strings.SettingsPage_WasapiExclusive_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7F6;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.Audio.IsWasapiExclusiveModeEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_AudioOutput_Header, Mode=OneTime}"
                    Description="{x:Bind resources:Strings.SettingsPage_AudioOutput_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7F5;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Spacing="8" MaxWidth="360">
                        <ComboBox
                            MinWidth="200"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="{x:Bind resources:Strings.SettingsPage_AudioOutput_Header, Mode=OneTime}"
                            ItemsSource="{x:Bind ViewModel.Audio.AudioOutputDevices, Mode=OneWay}"
                            DisplayMemberPath="DisplayName"
                            SelectedItem="{x:Bind ViewModel.Audio.SelectedAudioOutputDevice, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.Audio.IsAudioOutputBusy, Mode=OneWay, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                            DropDownOpened="AudioOutput_DropDownOpened"
                            SelectionChanged="AudioOutput_SelectionChanged" />
                        <TextBlock
                            Text="{x:Bind ViewModel.Audio.AudioOutputDeviceMessage, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Audio.AudioOutputDeviceMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"
                            TextWrapping="Wrap"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsExpander
                    Header="{x:Bind resources:Strings.SettingsPage_FadeOnPlayPause_Header, Mode=OneTime}"
                    Description="{x:Bind resources:Strings.SettingsPage_FadeOnPlayPause_Description, Mode=OneTime}">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9E9;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.Audio.IsFadeOnPlayPauseEnabled, Mode=TwoWay}" />
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind resources:Strings.SettingsPage_FadeInDuration_Header, Mode=OneTime}"
                            Description="{x:Bind resources:Strings.SettingsPage_FadeInDuration_Description, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                                <Slider
                                    Width="200"
                                    VerticalAlignment="Center"
                                    Maximum="1000"
                                    Minimum="0"
                                    StepFrequency="50"
                                    Style="{StaticResource DefaultSliderStyle}"
                                    Value="{x:Bind ViewModel.Audio.FadeInDurationMs, Mode=TwoWay}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}">
                                    <Run Text="{x:Bind ViewModel.Audio.FadeInDurationMs, Mode=OneWay}" />
                                    <Run Text="{x:Bind resources:Strings.SettingsPage_Unit_Milliseconds, Mode=OneTime}" />
                                </TextBlock>
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind resources:Strings.SettingsPage_FadeOutDuration_Header, Mode=OneTime}"
                            Description="{x:Bind resources:Strings.SettingsPage_FadeOutDuration_Description, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                                <Slider
                                    Width="200"
                                    VerticalAlignment="Center"
                                    Maximum="1000"
                                    Minimum="0"
                                    StepFrequency="50"
                                    Style="{StaticResource DefaultSliderStyle}"
                                    Value="{x:Bind ViewModel.Audio.FadeOutDurationMs, Mode=TwoWay}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}">
                                    <Run Text="{x:Bind ViewModel.Audio.FadeOutDurationMs, Mode=OneWay}" />
                                    <Run Text="{x:Bind resources:Strings.SettingsPage_Unit_Milliseconds, Mode=OneTime}" />
                                </TextBlock>
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind resources:Strings.SettingsPage_Equalizer, Mode=OneTime}" VerticalAlignment="Center" />
                            <HyperlinkButton
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.Audio.ResetEqualizerCommand}"
                                Style="{StaticResource AnimatedHyperlinkButtonStyle}"
                                Content="{x:Bind resources:Strings.SettingsPage_ResetEqualizer_Content, Mode=OneTime}"
                                FontSize="12"
                                Padding="4,2" />
                        </StackPanel>
                    </controls:SettingsCard.Header>
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9E9;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Spacing="20" HorizontalAlignment="Center">
                        <!-- Preamp slider -->
                        <StackPanel Spacing="6" Width="320">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind resources:Strings.SettingsPage_Equalizer_Preamp, Mode=OneTime}" HorizontalAlignment="Center" />
                            <Slider
                                Maximum="20"
                                Minimum="-20"
                                StepFrequency="0.1"
                                Style="{StaticResource DefaultSliderStyle}"
                                Value="{x:Bind ViewModel.Audio.EqualizerPreamp, Mode=TwoWay}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}">
                                <Run Text="{x:Bind ViewModel.Audio.EqualizerPreamp, Mode=OneWay, Converter={StaticResource FloatToDecimalStringConverter}}" />
                                <Run Text="{x:Bind resources:Strings.SettingsPage_Unit_Decibels, Mode=OneTime}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- EQ Bands -->
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Audio.EqualizerBands}" HorizontalAlignment="Center">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:EqualizerBandViewModel">
                                    <StackPanel Width="44" Spacing="6">
                                        <!-- 0 dB indicator and slider container -->
                                        <Grid Height="140">
                                            <!-- 0 dB center line -->
                                            <Border
                                                Height="1"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource TextFillColorTertiaryBrush}"
                                                Opacity="0.5" />
                                            <!-- Vertical slider -->
                                            <Slider
                                                HorizontalAlignment="Center"
                                                Maximum="20"
                                                Minimum="-20"
                                                Orientation="Vertical"
                                                StepFrequency="0.1"
                                                Style="{StaticResource DefaultSliderStyle}"
                                                Value="{x:Bind Gain, Mode=TwoWay}" />
                                        </Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind FrequencyLabel}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <ComboBox
                            HorizontalAlignment="Center"
                            MinWidth="160"
                            ItemsSource="{x:Bind ViewModel.Audio.AvailableEqualizerPresets}"
                            PlaceholderText="{x:Bind resources:Strings.SettingsPage_Equalizer_Preset_Custom_Placeholder, Mode=OneTime}"
                            SelectedItem="{x:Bind ViewModel.Audio.SelectedEqualizerPreset, Mode=TwoWay}">
