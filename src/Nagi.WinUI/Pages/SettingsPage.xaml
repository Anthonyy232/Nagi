                <controls:SettingsExpander
                    Header="{x:Bind resources:Strings.SettingsPage_AboutExpander_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_AboutExpander_Description, Mode=OneTime}"
                    IsExpanded="False">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE946;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True">
                        <Run Text="{x:Bind resources:Strings.SettingsPage_About_VersionPrefix, Mode=OneTime}" />
