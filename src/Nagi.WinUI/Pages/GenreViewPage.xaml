<pages:SongListPage
    xmlns:pages="using:Nagi.WinUI.Pages"
    x:Class="Nagi.WinUI.Pages.GenreViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:library="using:Nagi.Core.Library"
    xmlns:resources="using:Nagi.Presentation.Resources"
    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
    xmlns:uicontrols="using:Nagi.WinUI.Controls"
    x:Name="pageRoot"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid
          Padding="{StaticResource DetailPageContainerPadding}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="{StaticResource ViewPageHeaderPadding}">
            <Grid Margin="{StaticResource SectionHeaderMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="{StaticResource HeaderImageSize}"
                        Height="{StaticResource HeaderImageSize}"
                        CornerRadius="{StaticResource ArtworkCornerRadius}"
                        Background="{x:Bind ViewModel.PageTitle, Converter={StaticResource GenreToGradientConverter}, Mode=OneWay}" />

                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind resources:Strings.GenreViewPage_Header_Caption, Mode=OneTime}" />
                    <TextBlock Style="{ThemeResource HeaderTextBlockStyle}"
                               Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <uicontrols:SongListToolbar Margin="{StaticResource SectionHeaderMargin}" ViewModel="{x:Bind ViewModel}"
                                        SearchPlaceholder="{x:Bind resources:Strings.GenreViewPage_SearchBox_Placeholder}"
                                        SearchToolTip="{x:Bind resources:Strings.GenreViewPage_SearchButton_Search_ToolTip}" />
        </StackPanel>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Border x:Name="ColumnHeaderHost" Padding="{StaticResource PageContentPadding}" />
            <ListView uihelpers:ScrollEdgeFade.IsEnabled="True"
                x:Name="SongsListView"
                Grid.Row="1"
                Padding="{StaticResource PageContentPadding}"
                IsItemClickEnabled="True"
                ItemContainerStyle="{StaticResource SongListViewPageListViewItemStyle}"
                ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}"
                SelectionChanged="SongsListView_SelectionChanged"
                SelectionMode="Extended"
                DoubleTapped="SongsListView_DoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="library:Song">
                        <uicontrols:SongRow Song="{x:Bind}" ViewModel="{Binding DataContext, ElementName=pageRoot}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <uicontrols:PaginationControl
            Grid.Row="2"
            ViewModel="{x:Bind ViewModel}"
            HorizontalAlignment="Right"
            Margin="0,16,24,16" />
        <uicontrols:EmptyState Grid.Row="1"
                               Glyph="&#xE8D6;"
                               Title="{x:Bind resources:Strings.GenreViewPage_EmptyState_Title, Mode=OneTime}"
                               Subtitle="{x:Bind resources:Strings.Generic_TrySearchingElse, Mode=OneTime}"
                               IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                               HasLoadError="{x:Bind ViewModel.HasLoadError, Mode=OneWay}" />

    </Grid>
</pages:SongListPage>
