<pages:CollectionPage x:Class="Nagi.WinUI.Pages.FolderPage"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:lists="using:Nagi.Presentation.Lists"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:pages="using:Nagi.WinUI.Pages"
                      xmlns:resources="using:Nagi.Presentation.Resources"
                      xmlns:uicontrols="using:Nagi.WinUI.Controls"
                      x:Name="Root"
                      Background="Transparent"
                      NavigationCacheMode="Enabled"
                      mc:Ignorable="d">

    <Grid Padding="{StaticResource PageContainerPaddingVertical}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <uicontrols:CollectionPageHeader Title="{x:Bind resources:Strings.FolderPage_Title}"
                                         Grid.Row="0"
                                         Margin="{StaticResource CollectionPageHeaderMargin}"
                                         ViewModel="{x:Bind ViewModel}">
            <uicontrols:CollectionPageHeader.ExtraContent>
                <DropDownButton AutomationProperties.Name="{x:Bind resources:Strings.FolderPage_AddButton_ToolTip, Mode=OneTime}"
                                IsEnabled="{x:Bind ViewModel.IsAnyOperationInProgress, Converter={StaticResource BooleanToInverseBooleanConverter}, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind resources:Strings.FolderPage_AddButton_ToolTip, Mode=OneTime}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" />
                        <TextBlock Text="{x:Bind resources:Strings.Generic_Add, Mode=OneTime}" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Command="{x:Bind ViewModel.AddFolderCommand}" Text="{x:Bind resources:Strings.FolderPage_AddMenu_Folder, Mode=OneTime}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8F4;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind ViewModel.AddServerCommand}" Text="{x:Bind resources:Strings.FolderPage_AddMenu_Server, Mode=OneTime}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8CE;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </uicontrols:CollectionPageHeader.ExtraContent>
        </uicontrols:CollectionPageHeader>

        <GridView x:Name="CollectionGrid"
                  Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  Style="{StaticResource CollectionGridViewStyle}">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid ItemWidth="{StaticResource CollectionGridItemWidth}" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="lists:FolderViewModelItem">
                    <Grid Width="{StaticResource CollectionCardWidth}"
                          Height="{StaticResource CollectionCardHeight}"
                          Margin="{StaticResource CollectionCardMargin}"
                          Background="Transparent">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Command="{Binding ViewModel.PlayFolderCommand, ElementName=Root}"
                                                CommandParameter="{x:Bind Id}"
                                                Text="{x:Bind resources:Strings.Generic_Play, Mode=OneTime}" />
                                <MenuFlyoutItem Command="{Binding ViewModel.RescanFolderCommand, ElementName=Root}"
                                                CommandParameter="{x:Bind Id}"
                                                Text="{x:Bind resources:Strings.FolderPage_Menu_Rescan, Mode=OneTime}"
                                                Visibility="{x:Bind IsServer, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <MenuFlyoutItem Command="{Binding ViewModel.SyncServerCommand, ElementName=Root}"
                                                CommandParameter="{x:Bind Id}"
                                                Text="{x:Bind resources:Strings.FolderPage_Menu_Sync, Mode=OneTime}"
                                                Visibility="{x:Bind IsServer}" />
                                <MenuFlyoutItem Command="{Binding ViewModel.SignInToServerCommand, ElementName=Root}"
                                                CommandParameter="{x:Bind Id}"
                                                Text="{x:Bind resources:Strings.FolderPage_Menu_SignIn, Mode=OneTime}"
                                                Visibility="{x:Bind IsServer}" />
                                <MenuFlyoutItem Command="{Binding ViewModel.DeleteFolderCommand, ElementName=Root}"
                                                CommandParameter="{x:Bind Id}"
                                                Text="{x:Bind resources:Strings.FolderPage_Menu_Delete, Mode=OneTime}" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Width="{StaticResource CollectionCardImageSize}"
                              Height="{StaticResource CollectionCardImageSize}"
                              HorizontalAlignment="Center"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              CornerRadius="{StaticResource ArtworkCornerRadius}">
                            <FontIcon HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      FontSize="48"
                                      Glyph="&#xE8CE;"
                                      Visibility="{x:Bind IsServer}" />
                            <FontIcon HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      FontSize="48"
                                      Glyph="&#xE838;"
                                      Visibility="{x:Bind IsServer, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Style="{StaticResource CollectionCardTitleTextBlockStyle}"
                                   Text="{x:Bind Name}" />
                        <TextBlock Grid.Row="2"
                                   Style="{StaticResource CollectionCardSubtitleTextBlockStyle}"
                                   Text="{x:Bind SongCountText}" />
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <uicontrols:EmptyState Title="{x:Bind resources:Strings.FolderPage_Empty_Title, Mode=OneTime}"
                               Grid.Row="1"
                               Glyph="&#xED25;"
                               HasLoadError="{x:Bind ViewModel.HasLoadError, Mode=OneWay}"
                               IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                               Subtitle="{x:Bind resources:Strings.FolderPage_Empty_Subtitle, Mode=OneTime}" />
    </Grid>
</pages:CollectionPage>
