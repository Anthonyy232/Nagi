<Page
    x:Class="Nagi.WinUI.Pages.FolderPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uicontrols="using:Nagi.WinUI.Controls"
    xmlns:resources="using:Nagi.Presentation.Resources"
    xmlns:lists="using:Nagi.Presentation.Lists"
    x:Name="FolderPageRoot"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PageContainerPaddingVertical}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{StaticResource CollectionPageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{x:Bind resources:Strings.FolderPage_Title, Mode=OneTime}" Style="{StaticResource PageTitleTextStyle}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button
                        ToolTipService.ToolTip="{x:Bind resources:Strings.Generic_PickRandom, Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind resources:Strings.Generic_PickRandom, Mode=OneTime}"
                        Style="{StaticResource SongListViewPageIconButton}"
                        Command="{x:Bind ViewModel.PlayRandomFolderCommand}"
                        Margin="0,0,1,0"
                        ContentTemplate="{StaticResource RandomPlayIconTemplate}" />

                <DropDownButton
                    IsEnabled="{x:Bind ViewModel.IsAnyOperationInProgress, Converter={StaticResource BooleanToInverseBooleanConverter}, Mode=OneWay}"
                    Style="{StaticResource AnimatedAccentButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind resources:Strings.FolderPage_AddButton_ToolTip, Mode=OneTime}"
                    AutomationProperties.Name="{x:Bind resources:Strings.FolderPage_AddButton_ToolTip, Mode=OneTime}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" />
                        <TextBlock Text="{x:Bind resources:Strings.Generic_Add, Mode=OneTime}" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="{x:Bind resources:Strings.FolderPage_AddMenu_Folder, Mode=OneTime}" Command="{x:Bind ViewModel.AddFolderCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8F4;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="{x:Bind resources:Strings.FolderPage_AddMenu_Server, Mode=OneTime}" Command="{x:Bind ViewModel.AddServerCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8CE;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

            </StackPanel>
        </Grid>

        <GridView uihelpers:ScrollEdgeFade.IsEnabled="True"
            Grid.Row="1"
            IsItemClickEnabled="True"
            ItemClick="FoldersGridView_ItemClick"
            ItemContainerStyle="{StaticResource AnimatedGridViewItemStyle}"
            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
            SelectionMode="None"
            Padding="{StaticResource PageContentPadding}"
            Visibility="{x:Bind ViewModel.HasItems, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid ItemWidth="{StaticResource CollectionGridItemWidth}" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="lists:FolderViewModelItem">
                    <Grid
                        Width="{StaticResource CollectionCardWidth}"
                        Height="{StaticResource CollectionCardHeight}"
                        Margin="{StaticResource CollectionCardMargin}"
                        Background="Transparent">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    Text="{x:Bind resources:Strings.Generic_Play, Mode=OneTime}"
                                    Command="{Binding DataContext.PlayFolderCommand, ElementName=FolderPageRoot}"
                                    CommandParameter="{x:Bind Id}" />
                                <MenuFlyoutItem
                                    Text="{x:Bind resources:Strings.FolderPage_Menu_Rescan, Mode=OneTime}"
                                    Command="{Binding DataContext.RescanFolderCommand, ElementName=FolderPageRoot}"
                                    CommandParameter="{x:Bind Id}"
                                    Visibility="{x:Bind IsServer, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <MenuFlyoutItem
                                    Text="{x:Bind resources:Strings.FolderPage_Menu_Sync, Mode=OneTime}"
                                    Command="{Binding DataContext.SyncServerCommand, ElementName=FolderPageRoot}"
                                    CommandParameter="{x:Bind Id}"
                                    Visibility="{x:Bind IsServer, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <MenuFlyoutItem
                                    Text="{x:Bind resources:Strings.FolderPage_Menu_SignIn, Mode=OneTime}"
                                    Command="{Binding DataContext.SignInToServerCommand, ElementName=FolderPageRoot}"
                                    CommandParameter="{x:Bind Id}"
                                    Visibility="{x:Bind IsServer, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <MenuFlyoutItem Text="{x:Bind resources:Strings.FolderPage_Menu_Delete, Mode=OneTime}" Command="{Binding DataContext.DeleteFolderCommand, ElementName=FolderPageRoot}" CommandParameter="{x:Bind Id}" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            Grid.Row="0"
                            Width="{StaticResource CollectionCardImageSize}"
                            Height="{StaticResource CollectionCardImageSize}"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="{StaticResource ArtworkCornerRadius}">
                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="48" Glyph="&#xE8CE;"
                                      Visibility="{x:Bind IsServer, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="48"
                                      Visibility="{x:Bind IsServer, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                      Glyph="" />
                        </Grid>

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            Grid.Row="2"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            Opacity="0.7"
                            Text="{x:Bind SongCountText}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <uicontrols:EmptyState Grid.Row="1"
                               Glyph="&#xED25;"
                               Title="{x:Bind resources:Strings.FolderPage_Empty_Title, Mode=OneTime}"
                               Subtitle="{x:Bind resources:Strings.FolderPage_Empty_Subtitle, Mode=OneTime}"
                               IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                               HasLoadError="{x:Bind ViewModel.HasLoadError, Mode=OneWay}" />
    </Grid>
</Page>
