<pages:SongListPage x:Class="Nagi.WinUI.Pages.AlbumViewPage"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:library="using:Nagi.Core.Library"
                    xmlns:lists="using:Nagi.Presentation.Lists"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:pages="using:Nagi.WinUI.Pages"
                    xmlns:resources="using:Nagi.Presentation.Resources"
                    xmlns:uicontrols="using:Nagi.WinUI.Controls"
                    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
                    Background="Transparent"
                    mc:Ignorable="d">

    <Grid Padding="{StaticResource DetailPageContainerPadding}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="{StaticResource ViewPageHeaderPadding}">
            <uicontrols:DetailPageHeader Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                                         Margin="{StaticResource SectionHeaderMargin}"
                                         Caption="{x:Bind resources:Strings.AlbumViewPage_Header_Label, Mode=OneTime}">
                <uicontrols:DetailPageHeader.Artwork>
                    <uicontrols:ArtworkImage PlaceholderGlyph="&#xE93C;"
                                             PlaceholderGlyphSize="64"
                                             Size="{StaticResource HeaderImageSize}"
                                             Source="{x:Bind ViewModel.CoverArtUri, Mode=OneWay}" />
                </uicontrols:DetailPageHeader.Artwork>
                <uicontrols:DetailPageHeader.Details>
                    <StackPanel VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                        <uicontrols:ArtistLinks AlbumArtists="{x:Bind ViewModel.AlbumArtists, Mode=OneWay}"
                                                ArtistName="{x:Bind ViewModel.ArtistName, Mode=OneWay}"
                                                Command="{x:Bind ViewModel.GoToArtistCommand}"
                                                Style="{StaticResource SongListArtistLinksStyle}" />
                        <TextBlock Style="{StaticResource SongListViewPageSecondaryTextBlockStyle}"
                                   Text="•"
                                   Visibility="{x:Bind ViewModel.AlbumDetailsText, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource SongListViewPageSecondaryTextBlockStyle}" Text="{x:Bind ViewModel.AlbumDetailsText, Mode=OneWay}" />
                    </StackPanel>
                </uicontrols:DetailPageHeader.Details>
            </uicontrols:DetailPageHeader>

            <uicontrols:SongListToolbar Margin="{StaticResource SectionHeaderMargin}"
                                        SearchPlaceholder="{x:Bind resources:Strings.AlbumViewPage_SearchBox_Placeholder}"
                                        SearchToolTip="{x:Bind resources:Strings.AlbumViewPage_SearchButton_Search_ToolTip}"
                                        ViewModel="{x:Bind ViewModel}" />
        </StackPanel>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Border x:Name="ColumnHeaderHost" Padding="{StaticResource PageContentPadding}" />
            <ListView x:Name="GroupedSongsListView"
                      Grid.Row="1"
                      ItemContainerStyle="{x:Null}"
                      ItemsSource="{x:Bind ViewModel.GroupedSongsFlat, Mode=OneWay}"
                      Style="{StaticResource SongListViewStyle}"
                      Visibility="{x:Bind ViewModel.IsGroupedByDisc, Mode=OneWay}">
                <ListView.ItemContainerStyleSelector>
                    <uihelpers:HeaderedListStyleSelector>
                        <uihelpers:HeaderedListStyleSelector.HeaderStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="0,16,0,8" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </uihelpers:HeaderedListStyleSelector.HeaderStyle>
                        <uihelpers:HeaderedListStyleSelector.SongStyle>
                            <Style BasedOn="{StaticResource SongListViewPageListViewItemStyle}" TargetType="ListViewItem" />
                        </uihelpers:HeaderedListStyleSelector.SongStyle>
                    </uihelpers:HeaderedListStyleSelector>
                </ListView.ItemContainerStyleSelector>
                <ListView.ItemTemplateSelector>
                    <uihelpers:HeaderedListTemplateSelector>
                        <uihelpers:HeaderedListTemplateSelector.HeaderTemplate>
                            <DataTemplate x:DataType="lists:DiscHeader">
                                <TextBlock FontSize="{StaticResource CompactTextFontSize}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Text="{x:Bind Title}" />
                            </DataTemplate>
                        </uihelpers:HeaderedListTemplateSelector.HeaderTemplate>
                        <uihelpers:HeaderedListTemplateSelector.SongTemplate>
                            <DataTemplate x:DataType="library:Song">
                                <uicontrols:SongRow ShowDiscNumber="False" Song="{x:Bind}" />
                            </DataTemplate>
                        </uihelpers:HeaderedListTemplateSelector.SongTemplate>
                    </uihelpers:HeaderedListTemplateSelector>
                </ListView.ItemTemplateSelector>
            </ListView>

            <ListView x:Name="SongsListView"
                      Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}"
                      Style="{StaticResource SongListViewStyle}"
                      Visibility="{x:Bind ViewModel.IsGroupedByDisc, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="library:Song">
                        <uicontrols:SongRow Song="{x:Bind}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <uicontrols:PaginationControl Grid.Row="2" ViewModel="{x:Bind ViewModel}" />
        <uicontrols:EmptyState Title="{x:Bind resources:Strings.AlbumViewPage_Empty_Title, Mode=OneTime}"
                               Grid.Row="1"
                               Glyph="&#xE93C;"
                               HasLoadError="{x:Bind ViewModel.HasLoadError, Mode=OneWay}"
                               IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                               Subtitle="{x:Bind resources:Strings.Generic_TrySearchingElse, Mode=OneTime}" />

    </Grid>
</pages:SongListPage>
