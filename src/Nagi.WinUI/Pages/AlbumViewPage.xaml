<pages:SongListPage
    xmlns:pages="using:Nagi.WinUI.Pages"
    x:Class="Nagi.WinUI.Pages.AlbumViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ImageEx"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Nagi.Core.Models"
    xmlns:helpers="using:Nagi.Core.Helpers"
    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
    xmlns:viewmodels="using:Nagi.Presentation.ViewModels"
    xmlns:uicontrols="using:Nagi.WinUI.Controls"
    xmlns:resources="using:Nagi.Presentation.Resources"
    x:Name="pageRoot"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid
          Padding="{StaticResource DetailPageContainerPadding}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SearchStates">
                <VisualState x:Name="SearchCollapsed">
                    <VisualState.Setters>
                        <Setter Target="SearchTextBox.Width" Value="0" />
                        <Setter Target="SearchTextBox.Opacity" Value="0" />
                        <Setter Target="SearchTextBox.IsHitTestVisible" Value="False" />
                        <Setter Target="SearchTextBox.IsTabStop" Value="False" />
                        <Setter Target="SearchIcon.Glyph" Value="&#xE721;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SearchExpanded">
                    <VisualState.Setters>
                        <Setter Target="SearchTextBox.Width" Value="{StaticResource SearchBoxExpandedWidth}" />
                        <Setter Target="SearchTextBox.Opacity" Value="1" />
                        <Setter Target="SearchTextBox.IsHitTestVisible" Value="True" />
                        <Setter Target="SearchTextBox.IsTabStop" Value="True" />
                        <Setter Target="SearchIcon.Glyph" Value="&#xE711;" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="{StaticResource ViewPageHeaderPadding}">
            <Grid Margin="{StaticResource SectionHeaderMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="{StaticResource HeaderImageSize}"
                        Height="{StaticResource HeaderImageSize}"
                        CornerRadius="{StaticResource ArtworkCornerRadius}"
                        Visibility="{x:Bind ViewModel.IsArtworkAvailable, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                    <controls:ImageEx Width="{StaticResource HeaderImageSize}" Height="{StaticResource HeaderImageSize}"
                        IsCacheEnabled="True"
                        Source="{x:Bind ViewModel.CoverArtUri, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}, FallbackValue=null}"
                        DecodePixelWidth="{StaticResource HeaderImageSize}"
                        DecodePixelType="Logical"
                        Stretch="UniformToFill" />

                </Border>

                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Bottom" Spacing="8">
                    <TextBlock Text="{x:Bind resources:Strings.AlbumViewPage_Header_Label, Mode=OneTime}" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock Style="{ThemeResource HeaderTextBlockStyle}"
                               Text="{x:Bind ViewModel.AlbumTitle, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold"
                                   Style="{StaticResource SongListViewPageSecondaryTextBlockStyle}"
                                   uihelpers:MultiArtistHyperlinkHelper.ArtistName="{x:Bind ViewModel.ArtistName, Mode=OneWay}"
                                   uihelpers:MultiArtistHyperlinkHelper.AlbumArtists="{x:Bind ViewModel.AlbumArtists, Mode=OneWay}"
                                   uihelpers:MultiArtistHyperlinkHelper.Command="{Binding ViewModel.GoToArtistCommand, ElementName=pageRoot}" />
                        <TextBlock Opacity="0.8" Text="•"
                                   Visibility="{x:Bind ViewModel.AlbumDetailsText, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}" />
                        <TextBlock Opacity="0.8" Text="{x:Bind ViewModel.AlbumDetailsText, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Margin="{StaticResource SectionHeaderMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind resources:Strings.AlbumViewPage_Songs_Title, Mode=OneTime}" Style="{StaticResource SectionHeaderTextBlockStyle}" Foreground="{StaticResource AppPrimaryColorBrush}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.SelectedItemsCountText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasSelectedSongs, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{x:Bind ViewModel.TotalItemsText, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondary}" VerticalAlignment="Center"
                               FontSize="13"
                               Visibility="{x:Bind ViewModel.HasSelectedSongs, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Grid>
                        <TextBox x:Name="SearchTextBox"
                                 PlaceholderText="{x:Bind resources:Strings.AlbumViewPage_SearchBox_Placeholder, Mode=OneTime}"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Width="0"
                                 Opacity="0"
                                 IsHitTestVisible="False"
                             IsTabStop="False"
                                 HorizontalAlignment="Right"
                                 KeyDown="OnSearchTextBoxKeyDown"
                                 Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Canvas.ZIndex="0">
                            <TextBox.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.15" />
                            </TextBox.OpacityTransition>
                        </TextBox>

                        <Button x:Name="SearchToggleButton"
                                ToolTipService.ToolTip="{x:Bind resources:Strings.AlbumViewPage_SearchButton_ToolTip, Mode=OneTime}"
                                AutomationProperties.Name="{x:Bind resources:Strings.AlbumViewPage_SearchButton_ToolTip, Mode=OneTime}"
                                Click="OnSearchToggleButtonClick"
                                Style="{StaticResource SongListViewPageIconButton}"
                                HorizontalAlignment="Right"
                                Margin="0,0,1,0"
                                IsHitTestVisible="True"
                                Canvas.ZIndex="1">
                            <FontIcon x:Name="SearchIcon" FontSize="16" Glyph="&#xE721;" />
                        </Button>
                    </Grid>

                    <Button Style="{StaticResource SongListViewPageIconButton}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.CurrentSortOrderText, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.CurrentSortOrderText, Mode=OneWay}">
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <RadioMenuFlyoutItem GroupName="AlbumViewSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="TrackNumberAsc" Text="{x:Bind helpers:SortOrderHelper.TrackNumberAscLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=TrackNumberAsc}" />
                                <RadioMenuFlyoutItem GroupName="AlbumViewSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="TrackNumberDesc" Text="{x:Bind helpers:SortOrderHelper.TrackNumberDescLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=TrackNumberDesc}" />
                                <RadioMenuFlyoutItem GroupName="AlbumViewSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="TitleAsc" Text="{x:Bind helpers:SortOrderHelper.TitleAscLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=TitleAsc}" />
                                <RadioMenuFlyoutItem GroupName="AlbumViewSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="TitleDesc" Text="{x:Bind helpers:SortOrderHelper.TitleDescLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=TitleDesc}" />
                                <RadioMenuFlyoutItem GroupName="AlbumViewSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="YearAsc" Text="{x:Bind helpers:SortOrderHelper.YearOldestLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=YearAsc}" />
                                <RadioMenuFlyoutItem GroupName="AlbumViewSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="YearDesc" Text="{x:Bind helpers:SortOrderHelper.YearNewestLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=YearDesc}" />
                                <RadioMenuFlyoutItem GroupName="AlbumViewSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="FileCreatedDateAsc" Text="{x:Bind helpers:SortOrderHelper.DateCreatedOldestLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=FileCreatedDateAsc}" />
                                <RadioMenuFlyoutItem GroupName="AlbumViewSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="FileCreatedDateDesc" Text="{x:Bind helpers:SortOrderHelper.DateCreatedNewestLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=FileCreatedDateDesc}" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <FontIcon FontSize="16" Glyph="&#xE8CB;" />
                    </Button>

                    <Button ToolTipService.ToolTip="{x:Bind resources:Strings.AlbumViewPage_PlayAllButton_ToolTip, Mode=OneTime}" AutomationProperties.Name="{x:Bind resources:Strings.AlbumViewPage_PlayAllButton_ToolTip, Mode=OneTime}" Style="{StaticResource SongListViewPageIconButton}"
                            Command="{x:Bind ViewModel.PlayAllSongsCommand}">
                        <FontIcon Glyph="" FontSize="16" />
                    </Button>

                    <SplitButton Style="{StaticResource SongListViewPageShuffleButton}" ToolTipService.ToolTip="{x:Bind resources:Strings.AlbumViewPage_ShufflePlayButton_ToolTip, Mode=OneTime}" AutomationProperties.Name="{x:Bind resources:Strings.AlbumViewPage_ShufflePlayButton_ToolTip, Mode=OneTime}"
                            Command="{x:Bind ViewModel.ShuffleAndPlayAllSongsCommand}">
                        <SplitButton.Flyout><MenuFlyout Opening="ListeningOptions_Opening" /></SplitButton.Flyout>
                        <FontIcon Glyph="" FontSize="16" />
                    </SplitButton>

                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Grouped ListView for Disc mode -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Border x:Name="ColumnHeaderHost" Padding="{StaticResource PageContentPadding}" />
            <ListView uihelpers:ScrollEdgeFade.IsEnabled="True"
                Grid.Row="1"
                x:Name="GroupedSongsListView"
                Padding="{StaticResource PageContentPadding}"
                IsItemClickEnabled="True"
                ItemsSource="{x:Bind ViewModel.GroupedSongsFlat, Mode=OneWay}"
                SelectionChanged="SongsListView_SelectionChanged"
                SelectionMode="Extended"
                DoubleTapped="SongsListView_DoubleTapped"
                Visibility="{x:Bind ViewModel.IsGroupedByDisc, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListView.ItemContainerStyleSelector>
                    <uihelpers:HeaderedListStyleSelector>
                        <uihelpers:HeaderedListStyleSelector.HeaderStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="0,16,0,8" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </uihelpers:HeaderedListStyleSelector.HeaderStyle>
                        <uihelpers:HeaderedListStyleSelector.SongStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource SongListViewPageListViewItemStyle}" />
                        </uihelpers:HeaderedListStyleSelector.SongStyle>
                    </uihelpers:HeaderedListStyleSelector>
                </ListView.ItemContainerStyleSelector>
                <ListView.ItemTemplateSelector>
                    <uihelpers:HeaderedListTemplateSelector>
                        <uihelpers:HeaderedListTemplateSelector.HeaderTemplate>
                            <DataTemplate x:DataType="viewmodels:DiscHeader">
                                <TextBlock
                                    Text="{x:Bind Title}"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondary}"
                                    FontSize="13"
                                    Margin="0,0,0,0" />
                            </DataTemplate>
                        </uihelpers:HeaderedListTemplateSelector.HeaderTemplate>
                        <uihelpers:HeaderedListTemplateSelector.SongTemplate>
                            <DataTemplate x:DataType="models:Song">
                                <uicontrols:SongRow Song="{x:Bind}" ViewModel="{Binding DataContext, ElementName=pageRoot}" Columns="{Binding DataContext.VisibleColumns, ElementName=pageRoot}" ShowDiscNumber="False" ShowGoToAlbum="False" />
                            </DataTemplate>
                        </uihelpers:HeaderedListTemplateSelector.SongTemplate>
                    </uihelpers:HeaderedListTemplateSelector>
                </ListView.ItemTemplateSelector>
            </ListView>

            <!-- Regular ListView for other sort modes -->
            <ListView uihelpers:ScrollEdgeFade.IsEnabled="True"
                Grid.Row="1"
                x:Name="SongsListView"
                Padding="{StaticResource PageContentPadding}"
                IsItemClickEnabled="True"
                ItemContainerStyle="{StaticResource SongListViewPageListViewItemStyle}"
                ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}"
                SelectionChanged="SongsListView_SelectionChanged"
                SelectionMode="Extended"
                DoubleTapped="SongsListView_DoubleTapped"
                Visibility="{x:Bind ViewModel.IsGroupedByDisc, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Song">
                        <uicontrols:SongRow Song="{x:Bind}" ViewModel="{Binding DataContext, ElementName=pageRoot}" Columns="{Binding DataContext.VisibleColumns, ElementName=pageRoot}" ShowGoToAlbum="False" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <uicontrols:PaginationControl
            Grid.Row="2"
            ViewModel="{x:Bind ViewModel}"
            HorizontalAlignment="Right"
            Margin="0,16,24,16" />
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.Songs.Count, Mode=OneWay, Converter={StaticResource InverseCollectionCountToVisibilityConverter}}">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="20" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <FontIcon
                Glyph="&#xE93C;"
                FontSize="48"
                Margin="0,0,0,12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="{x:Bind resources:Strings.AlbumViewPage_Empty_Title, Mode=OneTime}"
                Style="{StaticResource TitleTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="{x:Bind resources:Strings.AlbumViewPage_Empty_Subtitle, Mode=OneTime}"
                Style="{StaticResource SubtitleTextBlockStyle}"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>

    </Grid>
</pages:SongListPage>
