<pages:SongListPage
    xmlns:pages="using:Nagi.WinUI.Pages"
    x:Class="Nagi.WinUI.Pages.AlbumViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ImageEx"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:library="using:Nagi.Core.Library"
    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
    xmlns:lists="using:Nagi.Presentation.Lists"
    xmlns:uicontrols="using:Nagi.WinUI.Controls"
    xmlns:resources="using:Nagi.Presentation.Resources"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid
          Padding="{StaticResource DetailPageContainerPadding}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="{StaticResource ViewPageHeaderPadding}">
            <Grid Margin="{StaticResource SectionHeaderMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="{StaticResource HeaderImageSize}" Height="{StaticResource HeaderImageSize}">
                    <Border CornerRadius="{StaticResource ArtworkCornerRadius}"
                            Visibility="{x:Bind ViewModel.IsArtworkAvailable, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                        <controls:ImageEx Width="{StaticResource HeaderImageSize}" Height="{StaticResource HeaderImageSize}"
                            IsCacheEnabled="True"
                            Source="{x:Bind ViewModel.CoverArtUri, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}, FallbackValue=null}"
                            DecodePixelWidth="{StaticResource HeaderImageSize}"
                            DecodePixelType="Logical"
                            Stretch="UniformToFill" />
                    </Border>
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          CornerRadius="{StaticResource ArtworkCornerRadius}"
                          Visibility="{x:Bind ViewModel.IsArtworkAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="64"
                            Glyph="&#xE93C;" />
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Bottom" Spacing="8">
                    <TextBlock Text="{x:Bind resources:Strings.AlbumViewPage_Header_Label, Mode=OneTime}" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock Style="{ThemeResource HeaderTextBlockStyle}"
                               Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <uicontrols:ArtistLinks Style="{StaticResource SongListArtistLinksStyle}"
                                                ArtistName="{x:Bind ViewModel.ArtistName, Mode=OneWay}"
                                                AlbumArtists="{x:Bind ViewModel.AlbumArtists, Mode=OneWay}"
                                                Command="{x:Bind ViewModel.GoToArtistCommand}" />
                        <TextBlock Opacity="0.8" Text="•"
                                   Visibility="{x:Bind ViewModel.AlbumDetailsText, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}" />
                        <TextBlock Opacity="0.8" Text="{x:Bind ViewModel.AlbumDetailsText, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <uicontrols:SongListToolbar Margin="{StaticResource SectionHeaderMargin}" ViewModel="{x:Bind ViewModel}"
                                        SearchPlaceholder="{x:Bind resources:Strings.AlbumViewPage_SearchBox_Placeholder}"
                                        SearchToolTip="{x:Bind resources:Strings.AlbumViewPage_SearchButton_Search_ToolTip}" />
        </StackPanel>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Border x:Name="ColumnHeaderHost" Padding="{StaticResource PageContentPadding}" />
            <ListView Style="{StaticResource SongListViewStyle}"
                Grid.Row="1"
                x:Name="GroupedSongsListView"
                ItemContainerStyle="{x:Null}"
                ItemsSource="{x:Bind ViewModel.GroupedSongsFlat, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsGroupedByDisc, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListView.ItemContainerStyleSelector>
                    <uihelpers:HeaderedListStyleSelector>
                        <uihelpers:HeaderedListStyleSelector.HeaderStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="0,16,0,8" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </uihelpers:HeaderedListStyleSelector.HeaderStyle>
                        <uihelpers:HeaderedListStyleSelector.SongStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource SongListViewPageListViewItemStyle}" />
                        </uihelpers:HeaderedListStyleSelector.SongStyle>
                    </uihelpers:HeaderedListStyleSelector>
                </ListView.ItemContainerStyleSelector>
                <ListView.ItemTemplateSelector>
                    <uihelpers:HeaderedListTemplateSelector>
                        <uihelpers:HeaderedListTemplateSelector.HeaderTemplate>
                            <DataTemplate x:DataType="lists:DiscHeader">
                                <TextBlock
                                    Text="{x:Bind Title}"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    FontSize="13" />
                            </DataTemplate>
                        </uihelpers:HeaderedListTemplateSelector.HeaderTemplate>
                        <uihelpers:HeaderedListTemplateSelector.SongTemplate>
                            <DataTemplate x:DataType="library:Song">
                                <uicontrols:SongRow Song="{x:Bind}" ShowDiscNumber="False" />
                            </DataTemplate>
                        </uihelpers:HeaderedListTemplateSelector.SongTemplate>
                    </uihelpers:HeaderedListTemplateSelector>
                </ListView.ItemTemplateSelector>
            </ListView>

            <ListView Style="{StaticResource SongListViewStyle}"
                Grid.Row="1"
                x:Name="SongsListView"
                ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsGroupedByDisc, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="library:Song">
                        <uicontrols:SongRow Song="{x:Bind}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <uicontrols:PaginationControl
            Grid.Row="2"
            ViewModel="{x:Bind ViewModel}"
            HorizontalAlignment="Right"
            Margin="0,16,24,16" />
        <uicontrols:EmptyState Grid.Row="1"
                               Glyph="&#xE93C;"
                               Title="{x:Bind resources:Strings.AlbumViewPage_Empty_Title, Mode=OneTime}"
                               Subtitle="{x:Bind resources:Strings.Generic_TrySearchingElse, Mode=OneTime}"
                               IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                               HasLoadError="{x:Bind ViewModel.HasLoadError, Mode=OneWay}" />

    </Grid>
</pages:SongListPage>
