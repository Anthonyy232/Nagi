<Page
    x:Class="Nagi.WinUI.Pages.SmartPlaylistSongViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Nagi.WinUI.Converters"
    xmlns:controls="using:ImageEx"
    xmlns:resources="using:Nagi.WinUI.Resources"
    xmlns:models="using:Nagi.Core.Models"
    xmlns:helpers="using:Nagi.Core.Helpers"
    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
    xmlns:uicontrols="using:Nagi.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent"
    x:Name="pageRoot">

    <Grid KeyboardAcceleratorPlacementMode="Hidden"
          Padding="{StaticResource DetailPageContainerPadding}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="OnSelectAllAcceleratorInvoked" />
        </Grid.KeyboardAccelerators>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SearchStates">
                <VisualState x:Name="SearchCollapsed">
                    <VisualState.Setters>
                        <Setter Target="SearchTextBox.Width" Value="0" />
                        <Setter Target="SearchTextBox.Opacity" Value="0" />
                        <Setter Target="SearchTextBox.IsHitTestVisible" Value="False" />
                        <Setter Target="SearchTextBox.IsTabStop" Value="False" />
                        <Setter Target="SearchIcon.Glyph" Value="&#xE721;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SearchExpanded">
                    <VisualState.Setters>
                        <Setter Target="SearchTextBox.Width" Value="{StaticResource SearchBoxExpandedWidth}" />
                        <Setter Target="SearchTextBox.Opacity" Value="1" />
                        <Setter Target="SearchTextBox.IsHitTestVisible" Value="True" />
                        <Setter Target="SearchTextBox.IsTabStop" Value="True" />
                        <Setter Target="SearchIcon.Glyph" Value="&#xE711;" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Content -->
        <StackPanel Grid.Row="0" Padding="{StaticResource ViewPageHeaderPadding}">
            <Grid Margin="{StaticResource SectionHeaderMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Smart Playlist Cover Art -->
                <Grid Grid.Column="0" Width="{StaticResource HeaderImageSize}" Height="{StaticResource HeaderImageSize}">
                    <Border CornerRadius="{StaticResource ArtworkCornerRadius}"
                            Visibility="{x:Bind ViewModel.IsArtworkAvailable, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                        <controls:ImageEx Width="{StaticResource HeaderImageSize}" Height="{StaticResource HeaderImageSize}"
                            IsCacheEnabled="True"
                            Source="{x:Bind ViewModel.CoverImageUri, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}, FallbackValue=null}"
                            DecodePixelWidth="160"
                            DecodePixelType="Logical"
                            Stretch="UniformToFill" />
                    </Border>
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          CornerRadius="{StaticResource ArtworkCornerRadius}"
                          Visibility="{x:Bind ViewModel.IsArtworkAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="48"
                            Glyph="&#xE71C;" />
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Bottom" Spacing="8">
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind resources:Strings.SmartPlaylistSongViewPage_Header_Caption, Mode=OneTime}" />
                    <TextBlock Style="{ThemeResource HeaderTextBlockStyle}"
                               Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <!-- Rule Summary Bar -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="16,8" CornerRadius="{ThemeResource OverlayCornerRadius}" Margin="{StaticResource SectionHeaderMargin}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.RuleSummary, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="13" />
                </StackPanel>
            </Border>

            <!-- Action Bar -->
            <Grid Margin="{StaticResource SectionHeaderMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SectionHeaderTextBlockStyle}" Text="{x:Bind resources:Strings.SmartPlaylistSongViewPage_Section_Songs, Mode=OneTime}" Foreground="{StaticResource AppPrimaryColorBrush}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.SelectedItemsCountText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasSelectedSongs, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{x:Bind ViewModel.TotalItemsText, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                               FontSize="13"
                               Visibility="{x:Bind ViewModel.HasSelectedSongs, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Search functionality -->
                    <Grid>
                        <TextBox x:Name="SearchTextBox"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 PlaceholderText="{x:Bind resources:Strings.SmartPlaylistSongViewPage_SearchBox_Placeholder, Mode=OneTime}"
                                 Width="0"
                                 Opacity="0"
                                 IsHitTestVisible="False"
                             IsTabStop="False"
                                 HorizontalAlignment="Right"
                                 KeyDown="OnSearchTextBoxKeyDown"
                                 Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Canvas.ZIndex="0">
                            <TextBox.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.15" />
                            </TextBox.OpacityTransition>
                        </TextBox>

                        <Button x:Name="SearchToggleButton"
                                Click="OnSearchToggleButtonClick"
                                Style="{StaticResource SongListViewPageIconButton}"
                                ToolTipService.ToolTip="{x:Bind resources:Strings.SmartPlaylistSongViewPage_SearchButton_ToolTip, Mode=OneTime}"
                                HorizontalAlignment="Right"
                                Margin="0,0,1,0"
                                IsHitTestVisible="True"
                                Canvas.ZIndex="1">
                            <FontIcon x:Name="SearchIcon" FontSize="16" Glyph="&#xE721;" />
                        </Button>
                    </Grid>

                    <Button Style="{StaticResource SongListViewPageIconButton}"
                            ToolTipService.ToolTip="{x:Bind resources:Strings.SmartPlaylistSongViewPage_EditRulesButton_ToolTip, Mode=OneTime}"
                            Click="EditRulesButton_Click">
                        <FontIcon Glyph="&#xE70F;" FontSize="16" />
                    </Button>

                    <Button Style="{StaticResource SongListViewPageIconButton}"
                            ToolTipService.ToolTip="{x:Bind resources:Strings.SmartPlaylistSongViewPage_PlayAllButton_ToolTip, Mode=OneTime}"
                            Command="{x:Bind ViewModel.PlayAllSongsCommand}">
                        <FontIcon Glyph="" FontSize="16" />
                    </Button>

                    <SplitButton
                            ToolTipService.ToolTip="{x:Bind resources:Strings.SmartPlaylistSongViewPage_ShufflePlayAllButton_ToolTip, Mode=OneTime}"
                            Command="{x:Bind ViewModel.ShuffleAndPlayAllSongsCommand}">
                        <SplitButton.Flyout><MenuFlyout Opening="ListeningOptions_Opening" /></SplitButton.Flyout>
                    <FontIcon Glyph="&#xE8B1;" FontSize="16" />
                    </SplitButton>

                    <Button Style="{StaticResource SongListViewPageIconButton}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.CurrentSortOrderText, Mode=OneWay}">
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <RadioMenuFlyoutItem GroupName="SmartPlaylistSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="TitleAsc" Text="{x:Bind helpers:SortOrderHelper.TitleAscLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=TitleAsc}" />
                                <RadioMenuFlyoutItem GroupName="SmartPlaylistSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="TitleDesc" Text="{x:Bind helpers:SortOrderHelper.TitleDescLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=TitleDesc}" />
                                <RadioMenuFlyoutItem GroupName="SmartPlaylistSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="YearAsc" Text="{x:Bind helpers:SortOrderHelper.YearOldestLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=YearAsc}" />
                                <RadioMenuFlyoutItem GroupName="SmartPlaylistSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="YearDesc" Text="{x:Bind helpers:SortOrderHelper.YearNewestLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=YearDesc}" />
                                <RadioMenuFlyoutItem GroupName="SmartPlaylistSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="ArtistAsc" Text="{x:Bind helpers:SortOrderHelper.ArtistAscLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=ArtistAsc}" />
                                <RadioMenuFlyoutItem GroupName="SmartPlaylistSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="ArtistDesc" Text="{x:Bind helpers:SortOrderHelper.ArtistDescLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=ArtistDesc}" />
                                <RadioMenuFlyoutItem GroupName="SmartPlaylistSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="AlbumAsc" Text="{x:Bind helpers:SortOrderHelper.AlbumAscLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=AlbumAsc}" />
                                <RadioMenuFlyoutItem GroupName="SmartPlaylistSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="AlbumDesc" Text="{x:Bind helpers:SortOrderHelper.AlbumDescLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=AlbumDesc}" />
                                <RadioMenuFlyoutItem GroupName="SmartPlaylistSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="TrackNumberAsc" Text="{x:Bind helpers:SortOrderHelper.TrackNumberAscLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=TrackNumberAsc}" />
                                <RadioMenuFlyoutItem GroupName="SmartPlaylistSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="TrackNumberDesc" Text="{x:Bind helpers:SortOrderHelper.TrackNumberDescLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=TrackNumberDesc}" />
                                <RadioMenuFlyoutItem GroupName="SmartPlaylistSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="PlayCountAsc" Text="{x:Bind helpers:SortOrderHelper.PlayCountAscLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=PlayCountAsc}" />
                                <RadioMenuFlyoutItem GroupName="SmartPlaylistSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="PlayCountDesc" Text="{x:Bind helpers:SortOrderHelper.PlayCountDescLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=PlayCountDesc}" />
                                <RadioMenuFlyoutItem GroupName="SmartPlaylistSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="LastPlayedAsc" Text="{x:Bind helpers:SortOrderHelper.LastPlayedAscLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=LastPlayedAsc}" />
                                <RadioMenuFlyoutItem GroupName="SmartPlaylistSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="LastPlayedDesc" Text="{x:Bind helpers:SortOrderHelper.LastPlayedDescLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=LastPlayedDesc}" />
                                <RadioMenuFlyoutItem GroupName="SmartPlaylistSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="DateAddedAsc" Text="{x:Bind helpers:SortOrderHelper.DateAddedAscLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=DateAddedAsc}" />
                                <RadioMenuFlyoutItem GroupName="SmartPlaylistSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="DateAddedDesc" Text="{x:Bind helpers:SortOrderHelper.DateAddedDescLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=DateAddedDesc}" />
                                <RadioMenuFlyoutItem GroupName="SmartPlaylistSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="DurationAsc" Text="{x:Bind helpers:SortOrderHelper.DurationAscLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=DurationAsc}" />
                                <RadioMenuFlyoutItem GroupName="SmartPlaylistSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="DurationDesc" Text="{x:Bind helpers:SortOrderHelper.DurationDescLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=DurationDesc}" />
                                <RadioMenuFlyoutItem GroupName="SmartPlaylistSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="BpmAsc" Text="{x:Bind helpers:SortOrderHelper.BpmAscLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=BpmAsc}" />
                                <RadioMenuFlyoutItem GroupName="SmartPlaylistSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="BpmDesc" Text="{x:Bind helpers:SortOrderHelper.BpmDescLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=BpmDesc}" />
                                <RadioMenuFlyoutItem GroupName="SmartPlaylistSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="FileCreatedDateAsc" Text="{x:Bind helpers:SortOrderHelper.DateCreatedOldestLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=FileCreatedDateAsc}" />
                                <RadioMenuFlyoutItem GroupName="SmartPlaylistSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="FileCreatedDateDesc" Text="{x:Bind helpers:SortOrderHelper.DateCreatedNewestLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=FileCreatedDateDesc}" />
                                <RadioMenuFlyoutItem GroupName="SmartPlaylistSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="Random" Text="{x:Bind helpers:SortOrderHelper.RandomLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=Random}" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <FontIcon FontSize="16" Glyph="&#xE8CB;" />
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Song List -->
        <ListView uihelpers:ScrollEdgeFade.IsEnabled="True" Grid.Row="1"
                  x:Name="SongsListView"
                  SelectionMode="Extended"
                  IsItemClickEnabled="True"
                  Padding="{StaticResource PageContentPadding}"
                  ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}"
                  ItemContainerStyle="{StaticResource SongListViewPageListViewItemStyle}"
                  SelectionChanged="SongsListView_SelectionChanged"
                  ContainerContentChanging="OnSongsListViewContainerContentChanging"
                  CanDragItems="False"
                  CanReorderItems="False"
                  AllowDrop="False"
                  DoubleTapped="SongsListView_DoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Song">
                    <Grid Height="54" ColumnSpacing="12" Background="Transparent">
                        <Grid.ContextFlyout>
                            <MenuFlyout Opening="SongItemMenuFlyout_Opening">
                                <MenuFlyoutItem Text="{x:Bind resources:Strings.SmartPlaylistSongViewPage_Context_Play, Mode=OneTime}"
                                                Command="{Binding DataContext.PlaySelectedSongsCommand, ElementName=pageRoot}" />
                                <MenuFlyoutItem Text="{x:Bind resources:Strings.SmartPlaylistSongViewPage_Context_PlayNext, Mode=OneTime}"
                                                Command="{Binding DataContext.PlaySelectedSongsNextCommand, ElementName=pageRoot}" />
                                <MenuFlyoutItem Text="{x:Bind resources:Strings.SmartPlaylistSongViewPage_Context_AddToQueue, Mode=OneTime}"
                                                Command="{Binding DataContext.AddSelectedSongsToQueueCommand, ElementName=pageRoot}" />
                                <MenuFlyoutSeparator
                                    Visibility="{Binding DataContext.IsSingleSongSelected, ElementName=pageRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <MenuFlyoutItem Text="{x:Bind resources:Strings.SmartPlaylistSongViewPage_Context_GoToAlbum, Mode=OneTime}"
                                                Command="{Binding DataContext.GoToAlbumCommand, ElementName=pageRoot}"
                                                CommandParameter="{x:Bind}"
                                                Visibility="{Binding DataContext.IsSingleSongSelected, ElementName=pageRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <MenuFlyoutSubItem x:Name="GoToArtistSubMenu"
                                                   Text="{x:Bind resources:Strings.SmartPlaylistSongViewPage_Context_GoToArtist, Mode=OneTime}"
                                                   Visibility="{Binding DataContext.IsSingleSongSelected, ElementName=pageRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <MenuFlyoutItem Text="{x:Bind resources:Strings.SmartPlaylistSongViewPage_Context_ShowInExplorer, Mode=OneTime}"
                                                Command="{Binding DataContext.ShowInFileExplorerCommand, ElementName=pageRoot}"
                                                CommandParameter="{x:Bind}"
                                                Visibility="{Binding DataContext.IsSingleSongSelected, ElementName=pageRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" MinWidth="100" />
                            <ColumnDefinition Width="1*" MinWidth="100" />
                            <ColumnDefinition Width="*" MinWidth="40" />
                            <ColumnDefinition Width="Auto" MinWidth="50" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource SongListViewPageSongPlayButtonStyle}"
                                Command="{Binding DataContext.PlaySongCommand, ElementName=pageRoot}"
                                CommandParameter="{x:Bind}"
                                ToolTipService.ToolTip="{x:Bind resources:Strings.SmartPlaylistSongViewPage_SongElement_PlayButton_ToolTip, Mode=OneTime}">
                            <Border Width="42" Height="42" CornerRadius="{StaticResource ArtworkCornerRadius}"
                                    Visibility="{x:Bind IsArtworkAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <controls:ImageEx Width="42" Height="42"
                                    Source="{x:Bind uihelpers:ImageUriHelper.GetUriWithCacheBuster(AlbumArtUriFromTrack, FileModifiedDate), Mode=OneTime}"
                                    Stretch="UniformToFill"
                                    DecodePixelWidth="48"
                                    DecodePixelType="Logical"
                                    IsCacheEnabled="True" />
                            </Border>
                        </Button>
                        <uicontrols:NowPlayingIndicator
                            x:Name="NowPlayingIndicator"
                            Grid.Column="0"
                            Width="42"
                            Height="42"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                        <Grid Grid.Column="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SongTitle" Text="{x:Bind Title}" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <FontIcon Grid.Column="1" Glyph="&#xEB51;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" ToolTipService.ToolTip="{x:Bind resources:Strings.Listening_Favorites}" Visibility="{x:Bind IsLoved, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>

                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Style="{StaticResource SongListViewPageSecondaryTextBlockStyle}"
                                   uihelpers:MultiArtistHyperlinkHelper.ArtistName="{x:Bind ArtistName}"
                                   uihelpers:MultiArtistHyperlinkHelper.Song="{x:Bind}"
                                   uihelpers:MultiArtistHyperlinkHelper.Command="{Binding DataContext.GoToArtistCommand, ElementName=pageRoot}" />

                        <HyperlinkButton Grid.Column="3"
                                         Content="{x:Bind Album.Title}"
                                         Command="{Binding DataContext.GoToAlbumCommand, ElementName=pageRoot}"
                                         CommandParameter="{x:Bind}"
                                         Style="{StaticResource SongListHyperlinkButtonStyle}" />

                        <TextBlock Grid.Column="4" Text="{x:Bind Album.Year}"
                                   Style="{StaticResource SongListViewPageSecondaryTextBlockStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="5"
                                   Text="{x:Bind Duration, Converter={StaticResource TimeSpanToTimeStringConverter}}"
                                   Style="{StaticResource SongListViewPageSecondaryTextBlockStyle}"
                                   HorizontalAlignment="Right" Margin="0,0,12,0" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <uicontrols:PaginationControl
            Grid.Row="2"
            ViewModel="{x:Bind ViewModel}"
            HorizontalAlignment="Right"
            Margin="0,16,24,16" />

        <!-- Empty State -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="20" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <FontIcon
                Glyph="&#xE71C;"
                FontSize="48"
                Margin="0,0,0,12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind resources:Strings.SmartPlaylistSongViewPage_EmptyState_Title, Mode=OneTime}"
                HorizontalAlignment="Center" />
            <TextBlock
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind resources:Strings.SmartPlaylistSongViewPage_EmptyState_Subtitle, Mode=OneTime}"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <Button
                Style="{StaticResource AnimatedAccentButtonStyle}"
                Content="{x:Bind resources:Strings.SmartPlaylistSongViewPage_EmptyState_Button_Content, Mode=OneTime}"
                Click="EditRulesButton_Click"
                HorizontalAlignment="Center" />
        </StackPanel>

    </Grid>
</Page>
