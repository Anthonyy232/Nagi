<pages:SongListPage x:Class="Nagi.WinUI.Pages.SmartPlaylistSongViewPage"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:library="using:Nagi.Core.Library"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:pages="using:Nagi.WinUI.Pages"
                    xmlns:resources="using:Nagi.Presentation.Resources"
                    xmlns:uicontrols="using:Nagi.WinUI.Controls"
                    Background="Transparent"
                    mc:Ignorable="d">

    <Grid Padding="{StaticResource DetailPageContainerPadding}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="{StaticResource ViewPageHeaderPadding}">
            <uicontrols:DetailPageHeader Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                                         Margin="{StaticResource SectionHeaderMargin}"
                                         Caption="{x:Bind resources:Strings.SmartPlaylistSongViewPage_Header_Caption, Mode=OneTime}">
                <uicontrols:DetailPageHeader.Artwork>
                    <uicontrols:ArtworkImage PlaceholderGlyph="&#xE71C;"
                                             PlaceholderGlyphSize="64"
                                             Size="{StaticResource HeaderImageSize}"
                                             Source="{x:Bind ViewModel.CoverImageUri, Mode=OneWay}" />
                </uicontrols:DetailPageHeader.Artwork>
            </uicontrols:DetailPageHeader>

            <Border Style="{StaticResource InfoStripBorderStyle}">
                <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                    <FontIcon FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Glyph="&#xE946;" />
                    <TextBlock FontSize="{StaticResource CompactTextFontSize}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ViewModel.RuleSummary, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <uicontrols:SongListToolbar Margin="{StaticResource SectionHeaderMargin}"
                                        SearchPlaceholder="{x:Bind resources:Strings.SmartPlaylistSongViewPage_SearchBox_Placeholder}"
                                        SearchToolTip="{x:Bind resources:Strings.SmartPlaylistSongViewPage_SearchButton_Search_ToolTip}"
                                        ViewModel="{x:Bind ViewModel}">
                <uicontrols:SongListToolbar.ExtraContent>
                    <Button AutomationProperties.Name="{x:Bind resources:Strings.SmartPlaylistSongViewPage_EditRulesButton_ToolTip}"
                            Command="{x:Bind ViewModel.EditRulesCommand}"
                            Style="{StaticResource SongListViewPageIconButton}"
                            ToolTipService.ToolTip="{x:Bind resources:Strings.SmartPlaylistSongViewPage_EditRulesButton_ToolTip}">
                        <FontIcon FontSize="16" Glyph="&#xE70F;" />
                    </Button>
                </uicontrols:SongListToolbar.ExtraContent>
            </uicontrols:SongListToolbar>
        </StackPanel>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Border x:Name="ColumnHeaderHost" Padding="{StaticResource PageContentPadding}" />
            <ListView x:Name="SongsListView"
                      Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}"
                      Style="{StaticResource SongListViewStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="library:Song">
                        <uicontrols:SongRow Song="{x:Bind}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <uicontrols:PaginationControl Grid.Row="2" ViewModel="{x:Bind ViewModel}" />

        <uicontrols:EmptyState Title="{x:Bind resources:Strings.SmartPlaylistSongViewPage_EmptyState_Title, Mode=OneTime}"
                               Grid.Row="1"
                               Glyph="&#xE71C;"
                               HasLoadError="{x:Bind ViewModel.HasLoadError, Mode=OneWay}"
                               IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                               Subtitle="{x:Bind resources:Strings.SmartPlaylistSongViewPage_EmptyState_Subtitle, Mode=OneTime}">
            <uicontrols:EmptyState.Action>
                <Button HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.EditRulesCommand}"
                        Content="{x:Bind resources:Strings.SmartPlaylistSongViewPage_EmptyState_Button_Content, Mode=OneTime}"
                        Style="{StaticResource AccentButtonStyle}" />
            </uicontrols:EmptyState.Action>
        </uicontrols:EmptyState>

    </Grid>
</pages:SongListPage>
