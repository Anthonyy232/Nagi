<pages:SongListPage
    xmlns:pages="using:Nagi.WinUI.Pages"
    x:Class="Nagi.WinUI.Pages.SmartPlaylistSongViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="using:Nagi.Presentation.Resources"
    xmlns:library="using:Nagi.Core.Library"
    xmlns:uicontrols="using:Nagi.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid
          Padding="{StaticResource DetailPageContainerPadding}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="{StaticResource ViewPageHeaderPadding}">
            <uicontrols:DetailPageHeader Margin="{StaticResource SectionHeaderMargin}"
                                         Caption="{x:Bind resources:Strings.SmartPlaylistSongViewPage_Header_Caption, Mode=OneTime}"
                                         Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}">
                <uicontrols:DetailPageHeader.Artwork>
                    <uicontrols:ArtworkImage Size="{StaticResource HeaderImageSize}"
                                                 Source="{x:Bind ViewModel.CoverImageUri, Mode=OneWay}"
                                                 PlaceholderGlyph="&#xE71C;" PlaceholderGlyphSize="64" />
                </uicontrols:DetailPageHeader.Artwork>
            </uicontrols:DetailPageHeader>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="16,8" CornerRadius="{ThemeResource OverlayCornerRadius}" Margin="{StaticResource SectionHeaderMargin}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.RuleSummary, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="13" />
                </StackPanel>
            </Border>

            <uicontrols:SongListToolbar Margin="{StaticResource SectionHeaderMargin}" ViewModel="{x:Bind ViewModel}"
                                        SearchPlaceholder="{x:Bind resources:Strings.SmartPlaylistSongViewPage_SearchBox_Placeholder}"
                                        SearchToolTip="{x:Bind resources:Strings.SmartPlaylistSongViewPage_SearchButton_Search_ToolTip}">
                <uicontrols:SongListToolbar.ExtraContent>
                    <Button Style="{StaticResource SongListViewPageIconButton}"
                            ToolTipService.ToolTip="{x:Bind resources:Strings.SmartPlaylistSongViewPage_EditRulesButton_ToolTip}"
                            AutomationProperties.Name="{x:Bind resources:Strings.SmartPlaylistSongViewPage_EditRulesButton_ToolTip}"
                            Command="{x:Bind ViewModel.EditRulesCommand}">
                        <FontIcon Glyph="&#xE70F;" FontSize="16" />
                    </Button>
                </uicontrols:SongListToolbar.ExtraContent>
            </uicontrols:SongListToolbar>
        </StackPanel>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Border x:Name="ColumnHeaderHost" Padding="{StaticResource PageContentPadding}" />
            <ListView Style="{StaticResource SongListViewStyle}" Grid.Row="1"
                      x:Name="SongsListView"
                      ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="library:Song">
                        <uicontrols:SongRow Song="{x:Bind}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <uicontrols:PaginationControl
            Grid.Row="2"
            ViewModel="{x:Bind ViewModel}"
            HorizontalAlignment="Right"
            Margin="0,16,24,16" />

        <uicontrols:EmptyState Grid.Row="1"
                               Glyph="&#xE71C;"
                               Title="{x:Bind resources:Strings.SmartPlaylistSongViewPage_EmptyState_Title, Mode=OneTime}"
                               Subtitle="{x:Bind resources:Strings.SmartPlaylistSongViewPage_EmptyState_Subtitle, Mode=OneTime}"
                               IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                               HasLoadError="{x:Bind ViewModel.HasLoadError, Mode=OneWay}">
            <uicontrols:EmptyState.Action>
                <Button
                    Style="{StaticResource AnimatedAccentButtonStyle}"
                    Content="{x:Bind resources:Strings.SmartPlaylistSongViewPage_EmptyState_Button_Content, Mode=OneTime}"
                    Command="{x:Bind ViewModel.EditRulesCommand}"
                    HorizontalAlignment="Center" />
            </uicontrols:EmptyState.Action>
        </uicontrols:EmptyState>

    </Grid>
</pages:SongListPage>
