<pages:SongListPage
    xmlns:pages="using:Nagi.WinUI.Pages"
    x:Class="Nagi.WinUI.Pages.SmartPlaylistSongViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ImageEx"
    xmlns:resources="using:Nagi.Presentation.Resources"
    xmlns:library="using:Nagi.Core.Library"
    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
    xmlns:uicontrols="using:Nagi.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent"
    x:Name="pageRoot">

    <Grid
          Padding="{StaticResource DetailPageContainerPadding}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="{StaticResource ViewPageHeaderPadding}">
            <Grid Margin="{StaticResource SectionHeaderMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="{StaticResource HeaderImageSize}" Height="{StaticResource HeaderImageSize}">
                    <Border CornerRadius="{StaticResource ArtworkCornerRadius}"
                            Visibility="{x:Bind ViewModel.IsArtworkAvailable, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                        <controls:ImageEx Width="{StaticResource HeaderImageSize}" Height="{StaticResource HeaderImageSize}"
                            IsCacheEnabled="True"
                            Source="{x:Bind ViewModel.CoverImageUri, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}, FallbackValue=null}"
                            DecodePixelWidth="{StaticResource HeaderImageSize}"
                            DecodePixelType="Logical"
                            Stretch="UniformToFill" />
                    </Border>
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          CornerRadius="{StaticResource ArtworkCornerRadius}"
                          Visibility="{x:Bind ViewModel.IsArtworkAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="64"
                            Glyph="&#xE71C;" />
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Bottom" Spacing="8">
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind resources:Strings.SmartPlaylistSongViewPage_Header_Caption, Mode=OneTime}" />
                    <TextBlock Style="{ThemeResource HeaderTextBlockStyle}"
                               Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="16,8" CornerRadius="{ThemeResource OverlayCornerRadius}" Margin="{StaticResource SectionHeaderMargin}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.RuleSummary, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="13" />
                </StackPanel>
            </Border>

            <uicontrols:SongListToolbar Margin="{StaticResource SectionHeaderMargin}" ViewModel="{x:Bind ViewModel}"
                                        SearchPlaceholder="{x:Bind resources:Strings.SmartPlaylistSongViewPage_SearchBox_Placeholder}"
                                        SearchToolTip="{x:Bind resources:Strings.SmartPlaylistSongViewPage_SearchButton_Search_ToolTip}">
                <uicontrols:SongListToolbar.ExtraContent>
                    <Button Style="{StaticResource SongListViewPageIconButton}"
                            ToolTipService.ToolTip="{x:Bind resources:Strings.SmartPlaylistSongViewPage_EditRulesButton_ToolTip}"
                            AutomationProperties.Name="{x:Bind resources:Strings.SmartPlaylistSongViewPage_EditRulesButton_ToolTip}"
                            Command="{x:Bind ViewModel.EditRulesCommand}">
                        <FontIcon Glyph="&#xE70F;" FontSize="16" />
                    </Button>
                </uicontrols:SongListToolbar.ExtraContent>
            </uicontrols:SongListToolbar>
        </StackPanel>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Border x:Name="ColumnHeaderHost" Padding="{StaticResource PageContentPadding}" />
            <ListView uihelpers:ScrollEdgeFade.IsEnabled="True" Grid.Row="1"
                      x:Name="SongsListView"
                      SelectionMode="Extended"
                      IsItemClickEnabled="True"
                      Padding="{StaticResource PageContentPadding}"
                      ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}"
                      ItemContainerStyle="{StaticResource SongListViewPageListViewItemStyle}"
                      SelectionChanged="SongsListView_SelectionChanged"
                      DoubleTapped="SongsListView_DoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="library:Song">
                        <uicontrols:SongRow Song="{x:Bind}" ViewModel="{Binding DataContext, ElementName=pageRoot}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <uicontrols:PaginationControl
            Grid.Row="2"
            ViewModel="{x:Bind ViewModel}"
            HorizontalAlignment="Right"
            Margin="0,16,24,16" />

        <uicontrols:EmptyState Grid.Row="1"
                               Glyph="&#xE71C;"
                               Title="{x:Bind resources:Strings.SmartPlaylistSongViewPage_EmptyState_Title, Mode=OneTime}"
                               Subtitle="{x:Bind resources:Strings.SmartPlaylistSongViewPage_EmptyState_Subtitle, Mode=OneTime}"
                               IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                               HasLoadError="{x:Bind ViewModel.HasLoadError, Mode=OneWay}">
            <uicontrols:EmptyState.Action>
                <Button
                    Style="{StaticResource AnimatedAccentButtonStyle}"
                    Content="{x:Bind resources:Strings.SmartPlaylistSongViewPage_EmptyState_Button_Content, Mode=OneTime}"
                    Command="{x:Bind ViewModel.EditRulesCommand}"
                    HorizontalAlignment="Center" />
            </uicontrols:EmptyState.Action>
        </uicontrols:EmptyState>

    </Grid>
</pages:SongListPage>
