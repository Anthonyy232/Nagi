<pages:SongListPage
    xmlns:pages="using:Nagi.WinUI.Pages"
    x:Class="Nagi.WinUI.Pages.LibraryPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Nagi.Core.Models"
    xmlns:resources="using:Nagi.Presentation.Resources"
    xmlns:helpers="using:Nagi.Core.Helpers"
    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
    xmlns:uicontrols="using:Nagi.WinUI.Controls"
    x:Name="pageRoot"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid
          Padding="{StaticResource PageContainerPaddingVertical}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SearchStates">
                <VisualState x:Name="SearchCollapsed">
                    <VisualState.Setters>
                        <Setter Target="SearchTextBox.Width" Value="0" />
                        <Setter Target="SearchTextBox.Opacity" Value="0" />
                        <Setter Target="SearchTextBox.IsHitTestVisible" Value="False" />
                        <Setter Target="SearchTextBox.IsTabStop" Value="False" />
                        <Setter Target="SearchIcon.Glyph" Value="&#xE721;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SearchExpanded">
                    <VisualState.Setters>
                        <Setter Target="SearchTextBox.Width" Value="{StaticResource SearchBoxExpandedWidth}" />
                        <Setter Target="SearchTextBox.Opacity" Value="1" />
                        <Setter Target="SearchTextBox.IsHitTestVisible" Value="True" />
                        <Setter Target="SearchTextBox.IsTabStop" Value="True" />
                        <Setter Target="SearchIcon.Glyph" Value="&#xE711;" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="{StaticResource PageHeaderMarginIndented}"
              VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock
                    Margin="0,0,0,5"
                    VerticalAlignment="Bottom"
                    FontSize="13"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Text="{x:Bind ViewModel.SelectedItemsCountText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasSelectedSongs, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock
                    Margin="0,0,0,5"
                    VerticalAlignment="Bottom"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondary}"
                    Text="{x:Bind ViewModel.TotalItemsText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasSelectedSongs, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Grid>
                    <TextBox x:Name="SearchTextBox"
                             PlaceholderText="{x:Bind resources:Strings.LibraryPage_SearchBox_Placeholder, Mode=OneTime}"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Width="0"
                             Opacity="0"
                             IsHitTestVisible="False"
                             IsTabStop="False"
                             HorizontalAlignment="Right"
                             KeyDown="OnSearchTextBoxKeyDown"
                             Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Canvas.ZIndex="0">
                        <TextBox.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.15" />
                        </TextBox.OpacityTransition>
                    </TextBox>

                    <Button x:Name="SearchToggleButton"
                            ToolTipService.ToolTip="{x:Bind resources:Strings.LibraryPage_SearchButton_ToolTip, Mode=OneTime}"
                            AutomationProperties.Name="{x:Bind resources:Strings.LibraryPage_SearchButton_ToolTip, Mode=OneTime}"
                            Click="OnSearchToggleButtonClick"
                            Style="{StaticResource SongListViewPageIconButton}"
                            HorizontalAlignment="Right"
                            Margin="0,0,1,0"
                            IsHitTestVisible="True"
                            Canvas.ZIndex="1">
                        <FontIcon x:Name="SearchIcon" FontSize="16" Glyph="&#xE721;" />
                    </Button>
                </Grid>

                <Button Style="{StaticResource SongListViewPageIconButton}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.CurrentSortOrderText, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.CurrentSortOrderText, Mode=OneWay}">
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <RadioMenuFlyoutItem GroupName="LibrarySort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                            CommandParameter="TitleAsc" Text="{x:Bind helpers:SortOrderHelper.TitleAscLabel}"
                                            IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=TitleAsc}" />
                            <RadioMenuFlyoutItem GroupName="LibrarySort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                            CommandParameter="TitleDesc" Text="{x:Bind helpers:SortOrderHelper.TitleDescLabel}"
                                            IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=TitleDesc}" />
                            <RadioMenuFlyoutItem GroupName="LibrarySort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                            CommandParameter="YearAsc" Text="{x:Bind helpers:SortOrderHelper.YearOldestLabel}"
                                            IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=YearAsc}" />
                            <RadioMenuFlyoutItem GroupName="LibrarySort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                            CommandParameter="YearDesc" Text="{x:Bind helpers:SortOrderHelper.YearNewestLabel}"
                                            IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=YearDesc}" />
                            <RadioMenuFlyoutItem GroupName="LibrarySort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                            CommandParameter="ArtistAsc" Text="{x:Bind helpers:SortOrderHelper.ArtistAscLabel}"
                                            IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=ArtistAsc}" />
                            <RadioMenuFlyoutItem GroupName="LibrarySort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                            CommandParameter="ArtistDesc" Text="{x:Bind helpers:SortOrderHelper.ArtistDescLabel}"
                                            IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=ArtistDesc}" />
                            <RadioMenuFlyoutItem GroupName="LibrarySort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                            CommandParameter="AlbumAsc" Text="{x:Bind helpers:SortOrderHelper.AlbumAscLabel}"
                                            IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=AlbumAsc}" />
                            <RadioMenuFlyoutItem GroupName="LibrarySort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                            CommandParameter="AlbumDesc" Text="{x:Bind helpers:SortOrderHelper.AlbumDescLabel}"
                                            IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=AlbumDesc}" />
                            <RadioMenuFlyoutItem GroupName="LibrarySort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                            CommandParameter="FileCreatedDateAsc" Text="{x:Bind helpers:SortOrderHelper.DateCreatedOldestLabel}"
                                            IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=FileCreatedDateAsc}" />
                            <RadioMenuFlyoutItem GroupName="LibrarySort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                            CommandParameter="FileCreatedDateDesc" Text="{x:Bind helpers:SortOrderHelper.DateCreatedNewestLabel}"
                                            IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=FileCreatedDateDesc}" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <FontIcon FontSize="16" Glyph="&#xE8CB;" />
                </Button>

                <Button Command="{x:Bind ViewModel.PlayAllSongsCommand}"
                        ToolTipService.ToolTip="{x:Bind resources:Strings.LibraryPage_PlayAllButton_ToolTip, Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind resources:Strings.LibraryPage_PlayAllButton_ToolTip, Mode=OneTime}"
                        Style="{StaticResource SongListViewPageIconButton}">
                    <FontIcon FontSize="16" Glyph="" />
                </Button>

                <SplitButton Style="{StaticResource SongListViewPageShuffleButton}" Command="{x:Bind ViewModel.ShuffleAndPlayAllSongsCommand}"
                        ToolTipService.ToolTip="{x:Bind resources:Strings.LibraryPage_ShufflePlayAllButton_ToolTip, Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind resources:Strings.LibraryPage_ShufflePlayAllButton_ToolTip, Mode=OneTime}">
                    <SplitButton.Flyout><MenuFlyout Opening="ListeningOptions_Opening" /></SplitButton.Flyout>
                    <FontIcon FontSize="16" Glyph="" />
                </SplitButton>

            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="24,0,24,16" Padding="12" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.ShowSuggestion, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4"><TextBlock Text="{x:Bind resources:Strings.Listening_RediscoveryTitle}" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Suggestion.Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.Suggestion.ArtistName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.SuggestionReason, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" Content="{x:Bind resources:Strings.QueuePanel_Play}" Command="{x:Bind ViewModel.PlaySuggestionCommand}" />
                <Button Grid.Column="2" VerticalAlignment="Top" Command="{x:Bind ViewModel.DismissSuggestionCommand}" ToolTipService.ToolTip="{x:Bind resources:Strings.Listening_Dismiss}" AutomationProperties.Name="{x:Bind resources:Strings.Listening_Dismiss}"><FontIcon FontSize="12" Glyph="&#xE711;" /></Button>
            </Grid>
        </Border>
        <ListView uihelpers:ScrollEdgeFade.IsEnabled="True"
            x:Name="SongsListView"
            Grid.Row="2"
            Padding="{StaticResource PageContentPadding}"
            IsItemClickEnabled="True"
            ItemContainerStyle="{StaticResource SongListViewPageListViewItemStyle}"
            ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}"
            SelectionChanged="SongsListView_SelectionChanged"
            SelectionMode="Extended"
            DoubleTapped="SongsListView_DoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Song">
                    <uicontrols:SongRow Song="{x:Bind}" ViewModel="{Binding DataContext, ElementName=pageRoot}" Columns="{Binding DataContext.VisibleColumns, ElementName=pageRoot}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <uicontrols:PaginationControl
            Grid.Row="3"
            ViewModel="{x:Bind ViewModel}"
            HorizontalAlignment="Right"
            Margin="0,16,24,16" />

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="20" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <FontIcon
                Glyph="&#xE8D6;"
                FontSize="48"
                Margin="0,0,0,12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind GetEmptyStateTitle(ViewModel.IsSearchActive, ViewModel.ShowFavoritesOnly), Mode=OneWay}"
                HorizontalAlignment="Center" />
            <TextBlock
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind GetEmptyStateSubtitle(ViewModel.IsSearchActive, ViewModel.ShowFavoritesOnly), Mode=OneWay}"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>

    </Grid>
</pages:SongListPage>
