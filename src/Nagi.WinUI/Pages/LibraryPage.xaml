<pages:SongListPage x:Class="Nagi.WinUI.Pages.LibraryPage"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:library="using:Nagi.Core.Library"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:pages="using:Nagi.WinUI.Pages"
                    xmlns:resources="using:Nagi.Presentation.Resources"
                    xmlns:uicontrols="using:Nagi.WinUI.Controls"
                    Background="Transparent"
                    NavigationCacheMode="Enabled"
                    mc:Ignorable="d">

    <Grid Padding="{StaticResource PageContainerPaddingVertical}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <uicontrols:SongListToolbar Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                                    Grid.Row="0"
                                    Margin="{StaticResource PageHeaderMarginIndented}"
                                    VerticalAlignment="Center"
                                    IsPageTitle="True"
                                    SearchPlaceholder="{x:Bind resources:Strings.LibraryPage_SearchBox_Placeholder}"
                                    SearchToolTip="{x:Bind resources:Strings.LibraryPage_SearchButton_Search_ToolTip}"
                                    ViewModel="{x:Bind ViewModel}" />

        <Border Grid.Row="1"
                Margin="{StaticResource PageHeaderMarginIndented}"
                Style="{StaticResource InfoStripBorderStyle}"
                Visibility="{x:Bind ViewModel.ShowSuggestion, Mode=OneWay}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind resources:Strings.Listening_RediscoveryTitle}" />
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                               Text="{x:Bind ViewModel.Suggestion.Title, Mode=OneWay}"
                               TextWrapping="NoWrap" />
                    <TextBlock Text="{x:Bind ViewModel.Suggestion.ArtistName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Text="{x:Bind ViewModel.SuggestionReason, Mode=OneWay}" />
                </StackPanel>
                <Button Grid.Column="1"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.PlaySuggestionCommand}"
                        Content="{x:Bind resources:Strings.Generic_Play}" />
                <Button Grid.Column="2"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{x:Bind resources:Strings.Listening_Dismiss}"
                        Command="{x:Bind ViewModel.DismissSuggestionCommand}"
                        ToolTipService.ToolTip="{x:Bind resources:Strings.Listening_Dismiss}">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>
        </Border>
        <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <Border x:Name="ColumnHeaderHost" Padding="{StaticResource PageContentPadding}" />
            <ListView x:Name="SongsListView"
                      Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}"
                      Style="{StaticResource SongListViewStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="library:Song">
                        <uicontrols:SongRow Song="{x:Bind}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <uicontrols:PaginationControl Grid.Row="3" ViewModel="{x:Bind ViewModel}" />

        <uicontrols:EmptyState Title="{x:Bind ViewModel.EmptyStateTitle, Mode=OneWay}"
                               Grid.Row="2"
                               Glyph="&#xE8D6;"
                               HasLoadError="{x:Bind ViewModel.HasLoadError, Mode=OneWay}"
                               IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                               Subtitle="{x:Bind ViewModel.EmptyStateSubtitle, Mode=OneWay}" />

    </Grid>
</pages:SongListPage>
