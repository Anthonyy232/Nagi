<pages:SongListPage
    xmlns:pages="using:Nagi.WinUI.Pages"
    x:Class="Nagi.WinUI.Pages.LibraryPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:library="using:Nagi.Core.Library"
    xmlns:resources="using:Nagi.Presentation.Resources"
    xmlns:uicontrols="using:Nagi.WinUI.Controls"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid
          Padding="{StaticResource PageContainerPaddingVertical}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <uicontrols:SongListToolbar Grid.Row="0"
                                    Margin="{StaticResource PageHeaderMarginIndented}"
                                    VerticalAlignment="Center"
                                    IsPageTitle="True"
                                    Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                                    ViewModel="{x:Bind ViewModel}"
                                    SearchPlaceholder="{x:Bind resources:Strings.LibraryPage_SearchBox_Placeholder}"
                                    SearchToolTip="{x:Bind resources:Strings.LibraryPage_SearchButton_Search_ToolTip}" />

        <Border Grid.Row="1"
                Margin="{StaticResource PageHeaderMarginIndented}"
                Style="{StaticResource InfoStripBorderStyle}"
                Visibility="{x:Bind ViewModel.ShowSuggestion, Mode=OneWay}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind resources:Strings.Listening_RediscoveryTitle}" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Suggestion.Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" />
                    <TextBlock Text="{x:Bind ViewModel.Suggestion.ArtistName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.SuggestionReason, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        VerticalAlignment="Center"
                        Content="{x:Bind resources:Strings.Generic_Play}"
                        Command="{x:Bind ViewModel.PlaySuggestionCommand}" />
                <Button Grid.Column="2"
                        VerticalAlignment="Top"
                        Command="{x:Bind ViewModel.DismissSuggestionCommand}"
                        ToolTipService.ToolTip="{x:Bind resources:Strings.Listening_Dismiss}"
                        AutomationProperties.Name="{x:Bind resources:Strings.Listening_Dismiss}">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>
        </Border>
        <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <Border x:Name="ColumnHeaderHost" Padding="{StaticResource PageContentPadding}" />
            <ListView Style="{StaticResource SongListViewStyle}"
                x:Name="SongsListView"
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="library:Song">
                        <uicontrols:SongRow Song="{x:Bind}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <uicontrols:PaginationControl
            Grid.Row="3"
            ViewModel="{x:Bind ViewModel}" />

        <uicontrols:EmptyState Grid.Row="2"
                               Glyph="&#xE8D6;"
                               Title="{x:Bind ViewModel.EmptyStateTitle, Mode=OneWay}"
                               Subtitle="{x:Bind ViewModel.EmptyStateSubtitle, Mode=OneWay}"
                               IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                               HasLoadError="{x:Bind ViewModel.HasLoadError, Mode=OneWay}" />

    </Grid>
</pages:SongListPage>
