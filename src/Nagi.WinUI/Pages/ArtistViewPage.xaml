<pages:SongListPage x:Class="Nagi.WinUI.Pages.ArtistViewPage"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:library="using:Nagi.Core.Library"
                    xmlns:lists="using:Nagi.Presentation.Lists"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:pages="using:Nagi.WinUI.Pages"
                    xmlns:resources="using:Nagi.Presentation.Resources"
                    xmlns:uicontrols="using:Nagi.WinUI.Controls"
                    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
                    x:Name="Root"
                    Background="Transparent"
                    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="AlbumCardTemplate" x:DataType="lists:ArtistAlbumViewModelItem">
            <Grid x:Name="AlbumCard"
                  Width="{StaticResource AlbumCardWidth}"
                  MinHeight="{StaticResource AlbumCardMinHeight}"
                  Margin="{StaticResource CollectionCardMargin}"
                  Background="Transparent">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Command="{Binding ViewModel.PlayAlbumCommand, ElementName=Root}"
                                        CommandParameter="{x:Bind Id}"
                                        Text="{x:Bind resources:Strings.Generic_Play, Mode=OneTime}" />
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <uicontrols:ArtworkImage x:Name="AlbumArtwork"
                                         Grid.Row="0"
                                         HorizontalAlignment="Center"
                                         PlaceholderGlyph="&#xE93C;"
                                         Size="{StaticResource AlbumCardImageSize}"
                                         Source="{x:Bind CoverArtUri}" />
                <TextBlock x:Name="AlbumName"
                           Grid.Row="1"
                           MaxWidth="{StaticResource AlbumCardImageSize}"
                           Style="{StaticResource CollectionCardTitleTextBlockStyle}"
                           Text="{x:Bind Name}" />
                <TextBlock x:Name="AlbumYear"
                           Grid.Row="2"
                           MaxWidth="{StaticResource AlbumCardImageSize}"
                           Style="{StaticResource CollectionCardSubtitleTextBlockStyle}"
                           Text="{x:Bind YearText}" />
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="LargeCard">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1600" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="AlbumCard.Width" Value="{StaticResource AlbumCardWidthLarge}" />
                                <Setter Target="AlbumCard.MinHeight" Value="{StaticResource AlbumCardMinHeightLarge}" />
                                <Setter Target="AlbumArtwork.Size" Value="{StaticResource AlbumCardImageSizeLarge}" />
                                <Setter Target="AlbumName.MaxWidth" Value="{StaticResource AlbumCardImageSizeLarge}" />
                                <Setter Target="AlbumYear.MaxWidth" Value="{StaticResource AlbumCardImageSizeLarge}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="NormalCard">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Grid>
        </DataTemplate>

    </Page.Resources>

    <Grid Padding="{StaticResource DetailPageContainerPadding}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      uihelpers:ScrollEdgeFade.IsEnabled="True"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="{StaticResource ViewPageHeaderPadding}">
                <uicontrols:DetailPageHeader Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                                             Margin="{StaticResource SectionHeaderMargin}"
                                             Caption="{x:Bind resources:Strings.ArtistViewPage_Header_Label, Mode=OneTime}">
                    <uicontrols:DetailPageHeader.Artwork>
                        <Grid Width="{StaticResource HeaderImageSize}"
                              Height="{StaticResource HeaderImageSize}"
                              Background="Transparent"
                              CornerRadius="{StaticResource HeaderImageCircleRadius}"
                              PointerEntered="ArtistImage_PointerEntered"
                              PointerExited="ArtistImage_PointerExited">
                            <uicontrols:ArtworkImage IsCircular="True"
                                                     PlaceholderGlyph="&#xE77B;"
                                                     PlaceholderGlyphSize="64"
                                                     Size="{StaticResource HeaderImageSize}"
                                                     Source="{x:Bind ViewModel.ArtistImageUri, Mode=OneWay}" />
                            <!--  A button, so the image menu is reachable by keyboard and screen readers, not only by pointer.  -->
                            <Button x:Name="EditOverlay"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    AutomationProperties.Name="{x:Bind resources:Strings.ArtistViewPage_EditOverlay_Content, Mode=OneTime}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="{StaticResource HeaderImageCircleRadius}"
                                    GotFocus="EditOverlay_GotFocus"
                                    LostFocus="EditOverlay_LostFocus"
                                    Opacity="0"
                                    ToolTipService.ToolTip="{x:Bind resources:Strings.ArtistViewPage_EditOverlay_Content, Mode=OneTime}">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.ChangeArtistImageCommand}" Text="{x:Bind resources:Strings.Generic_ChangeImage, Mode=OneTime}" />
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.RemoveArtistImageCommand}"
                                                        Text="{x:Bind resources:Strings.Generic_RemoveImage, Mode=OneTime}"
                                                        Visibility="{x:Bind ViewModel.IsCustomImage, Mode=OneWay}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                                <Grid Background="{StaticResource MediaOnImageHoverScrimBrush}" CornerRadius="{StaticResource HeaderImageCircleRadius}">
                                    <FontIcon FontSize="32"
                                              Foreground="{StaticResource MediaOnImageTextPrimaryBrush}"
                                              Glyph="&#xE70F;" />
                                </Grid>
                            </Button>
                        </Grid>
                    </uicontrols:DetailPageHeader.Artwork>
                    <uicontrols:DetailPageHeader.Details>
                        <StackPanel Spacing="8">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       MaxLines="3"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Text="{x:Bind ViewModel.ArtistBio, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="Wrap" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Bind ViewModel.BiographyCredit, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.BiographyCredit, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                    </uicontrols:DetailPageHeader.Details>
                </uicontrols:DetailPageHeader>

                <Grid x:Name="AlbumsViewport"
                      VerticalAlignment="Top"
                      Visibility="{x:Bind ViewModel.HasAlbums, Mode=OneWay}">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
                        <StackPanel x:Name="AlbumsContent"
                                    VerticalAlignment="Top"
                                    SizeChanged="OnAlbumsContentSizeChanged">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind resources:Strings.ArtistViewPage_Albums_Title, Mode=OneTime}" />
                            <GridView Padding="0"
                                      IsItemClickEnabled="True"
                                      ItemClick="AlbumGridView_ItemClick"
                                      ItemTemplate="{StaticResource AlbumCardTemplate}"
                                      ItemsSource="{x:Bind ViewModel.Albums, Mode=OneWay}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                      ScrollViewer.HorizontalScrollMode="Auto"
                                      ScrollViewer.IsHorizontalRailEnabled="True"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      SelectionMode="None">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                            </GridView>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <uicontrols:SongListToolbar Margin="{StaticResource SectionHeaderMargin}"
                                            SearchPlaceholder="{x:Bind resources:Strings.ArtistViewPage_SearchBox_Placeholder}"
                                            SearchToolTip="{x:Bind resources:Strings.ArtistViewPage_SearchButton_Search_ToolTip}"
                                            ViewModel="{x:Bind ViewModel}" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Border x:Name="ColumnHeaderHost" Padding="{StaticResource PageContentPadding}" />
            <ListView x:Name="SongsListView"
                      Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}"
                      Style="{StaticResource SongListViewStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="library:Song">
                        <uicontrols:SongRow Song="{x:Bind}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <uicontrols:PaginationControl Grid.Row="2" ViewModel="{x:Bind ViewModel}" />
        <uicontrols:EmptyState Title="{x:Bind resources:Strings.ArtistViewPage_Empty_Title, Mode=OneTime}"
                               Grid.Row="1"
                               Glyph="&#xE8D6;"
                               HasLoadError="{x:Bind ViewModel.HasLoadError, Mode=OneWay}"
                               IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                               Subtitle="{x:Bind resources:Strings.Generic_TrySearchingElse, Mode=OneTime}" />

    </Grid>
</pages:SongListPage>
