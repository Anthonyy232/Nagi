<pages:SongListPage
    xmlns:pages="using:Nagi.WinUI.Pages"
    x:Class="Nagi.WinUI.Pages.ArtistViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ImageEx"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Nagi.Presentation.ViewModels"
    xmlns:models="using:Nagi.Core.Models"
    xmlns:resources="using:Nagi.Presentation.Resources"
    xmlns:helpers="using:Nagi.Core.Helpers"
    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
    xmlns:uicontrols="using:Nagi.WinUI.Controls"
    x:Name="pageRoot"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="AlbumCardTemplate" x:DataType="viewmodels:ArtistAlbumViewModelItem">
            <Grid x:Name="AlbumCard"
                Width="{StaticResource AlbumCardWidth}"
                MinHeight="{StaticResource AlbumCardMinHeight}"
                Margin="{StaticResource CollectionCardMargin}"
                Background="Transparent">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="LargeCard">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1600" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="AlbumCard.Width" Value="{StaticResource AlbumCardWidthLarge}" />
                                <Setter Target="AlbumCard.MinHeight" Value="{StaticResource AlbumCardMinHeightLarge}" />
                                <Setter Target="AlbumArtwork.Width" Value="{StaticResource AlbumCardImageSizeLarge}" />
                                <Setter Target="AlbumArtwork.Height" Value="{StaticResource AlbumCardImageSizeLarge}" />
                                <Setter Target="AlbumName.MaxWidth" Value="{StaticResource AlbumCardImageSizeLarge}" />
                                <Setter Target="AlbumYear.MaxWidth" Value="{StaticResource AlbumCardImageSizeLarge}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="NormalCard">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Text="{x:Bind resources:Strings.AlbumPage_Menu_Play, Mode=OneTime}"
                            Command="{Binding ViewModel.PlayAlbumCommand, ElementName=pageRoot}"
                            CommandParameter="{x:Bind Id}"
                            IsEnabled="{Binding ViewModel.IsLoading, ElementName=pageRoot, Converter={StaticResource BooleanToInverseBooleanConverter}}" />
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:ImageEx x:Name="AlbumArtwork" Grid.Row="0"
                    Width="{StaticResource AlbumCardImageSize}"
                    Height="{StaticResource AlbumCardImageSize}"
                    HorizontalAlignment="Center"
                    CornerRadius="{StaticResource ArtworkCornerRadius}"
                    Visibility="{x:Bind IsArtworkAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                    IsCacheEnabled="True"
                    Source="{x:Bind CoverArtUri}"
                    DecodePixelWidth="{StaticResource AlbumCardImageSizeLarge}"
                    DecodePixelType="Logical"
                    Stretch="UniformToFill" />
                <TextBlock x:Name="AlbumName"
                    Grid.Row="1"
                    Margin="4,8,4,0"
                    MaxWidth="{StaticResource AlbumCardImageSize}"
                    HorizontalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Bind Name}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock x:Name="AlbumYear"
                    Grid.Row="2"
                    Margin="4,2,4,0"
                    MaxWidth="{StaticResource AlbumCardImageSize}"
                    HorizontalAlignment="Center"
                    Opacity="0.7"
                    Text="{x:Bind YearText}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </Grid>
        </DataTemplate>

    </Page.Resources>

    <Grid
          Padding="{StaticResource DetailPageContainerPadding}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SearchStates">
                <VisualState x:Name="SearchCollapsed">
                    <VisualState.Setters>
                        <Setter Target="SearchTextBox.Width" Value="0" />
                        <Setter Target="SearchTextBox.Opacity" Value="0" />
                        <Setter Target="SearchTextBox.IsHitTestVisible" Value="False" />
                        <Setter Target="SearchTextBox.IsTabStop" Value="False" />
                        <Setter Target="SearchIcon.Glyph" Value="&#xE721;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SearchExpanded">
                    <VisualState.Setters>
                        <Setter Target="SearchTextBox.Width" Value="{StaticResource SearchBoxExpandedWidth}" />
                        <Setter Target="SearchTextBox.Opacity" Value="1" />
                        <Setter Target="SearchTextBox.IsHitTestVisible" Value="True" />
                        <Setter Target="SearchTextBox.IsTabStop" Value="True" />
                        <Setter Target="SearchIcon.Glyph" Value="&#xE711;" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer uihelpers:ScrollEdgeFade.IsEnabled="True" Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="{StaticResource ViewPageHeaderPadding}">
                <Grid Margin="{StaticResource SectionHeaderMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="{StaticResource HeaderImageSize}" Height="{StaticResource HeaderImageSize}" CornerRadius="75"
                          PointerEntered="ArtistImage_PointerEntered" PointerExited="ArtistImage_PointerExited"
                          Background="Transparent">
                        <controls:ImageEx Width="{StaticResource HeaderImageSize}" Height="{StaticResource HeaderImageSize}" x:Name="AlbumImage"
                            CornerRadius="75"
                            IsCacheEnabled="True"
                            Source="{x:Bind ViewModel.ArtistImageUri, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}, FallbackValue=null}"
                            Stretch="UniformToFill"
                            DecodePixelWidth="{StaticResource HeaderImageSize}"
                            DecodePixelType="Logical"
                            Visibility="{x:Bind ViewModel.ArtistImageUri, Mode=OneWay, Converter={StaticResource NullOrEmptyStringToVisibilityConverter}}" />

                        <Grid
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="75"
                            Visibility="{x:Bind ViewModel.ArtistImageUri, Mode=OneWay, Converter={StaticResource InverseNullOrEmptyStringToVisibilityConverter}}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="64"
                                Glyph="" />
                        </Grid>
                        <Grid x:Name="EditOverlay"
                              Background="#66000000"
                              CornerRadius="75"
                              Opacity="0"
                              PointerPressed="EditOverlay_PointerPressed">
                            <FontIcon Glyph="&#xE70F;" Foreground="White" FontSize="32" />
                            <ToolTipService.ToolTip>
                                <ToolTip Content="{x:Bind resources:Strings.ArtistViewPage_EditOverlay_Content, Mode=OneTime}" />
                            </ToolTipService.ToolTip>
                            <Grid.ContextFlyout>
                                <MenuFlyout x:Name="ImageEditFlyout">
                                    <MenuFlyoutItem Text="{x:Bind resources:Strings.ArtistViewPage_ImageMenu_ChangeImage, Mode=OneTime}" Command="{x:Bind ViewModel.ChangeArtistImageCommand}" />
                                    <MenuFlyoutItem Text="{x:Bind resources:Strings.ArtistViewPage_ImageMenu_RemoveImage, Mode=OneTime}" Command="{x:Bind ViewModel.RemoveArtistImageCommand}"
                                                    Visibility="{x:Bind ViewModel.IsCustomImage, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="{x:Bind resources:Strings.ArtistViewPage_Header_Label, Mode=OneTime}" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock Style="{ThemeResource HeaderTextBlockStyle}"
                                   Text="{x:Bind ViewModel.ArtistName, Mode=OneWay}" />
                        <TextBlock
                            MaxLines="3"
                            Opacity="0.8"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.ArtistBio, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="AlbumsViewport" VerticalAlignment="Top"
                      Visibility="{x:Bind ViewModel.HasAlbums, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                    <ScrollViewer VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="AlbumsContent" VerticalAlignment="Top" SizeChanged="OnAlbumsContentSizeChanged">
                        <TextBlock Text="{x:Bind resources:Strings.ArtistViewPage_Albums_Title, Mode=OneTime}" Style="{StaticResource SectionHeaderTextBlockStyle}" Foreground="{StaticResource AppPrimaryColorBrush}" />
                        <GridView
                            x:Name="AlbumGridView"
                            Padding="0"
                            IsItemClickEnabled="True"
                            ItemClick="AlbumGridView_ItemClick"
                            ItemsSource="{x:Bind ViewModel.Albums, Mode=OneWay}"
                            SelectionMode="None"
                            ItemTemplate="{StaticResource AlbumCardTemplate}"
                            ScrollViewer.HorizontalScrollMode="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                            ScrollViewer.IsHorizontalRailEnabled="True"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Margin="{StaticResource SectionHeaderMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind resources:Strings.ArtistViewPage_Songs_Title, Mode=OneTime}" Style="{StaticResource SectionHeaderTextBlockStyle}" Foreground="{StaticResource AppPrimaryColorBrush}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Text="{x:Bind ViewModel.SelectedItemsCountText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasSelectedSongs, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                       <TextBlock VerticalAlignment="Center" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondary}"
                                   Text="{x:Bind ViewModel.TotalItemsText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasSelectedSongs, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Grid>
                            <TextBox x:Name="SearchTextBox"
                                     PlaceholderText="{x:Bind resources:Strings.ArtistViewPage_SearchBox_Placeholder, Mode=OneTime}"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Width="0"
                                     Opacity="0"
                                     IsHitTestVisible="False"
                             IsTabStop="False"
                                     HorizontalAlignment="Right"
                                     KeyDown="OnSearchTextBoxKeyDown"
                                     Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Canvas.ZIndex="0">
                                <TextBox.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.15" />
                                </TextBox.OpacityTransition>
                            </TextBox>

                            <Button x:Name="SearchToggleButton"
                                    ToolTipService.ToolTip="{x:Bind resources:Strings.ArtistViewPage_SearchButton_Search_ToolTip, Mode=OneTime}"
                                    AutomationProperties.Name="{x:Bind resources:Strings.ArtistViewPage_SearchButton_Search_ToolTip, Mode=OneTime}"
                                    Click="OnSearchToggleButtonClick"
                                    Style="{StaticResource SongListViewPageIconButton}"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,1,0"
                                    IsHitTestVisible="True"
                                    Canvas.ZIndex="1">
                                <FontIcon x:Name="SearchIcon" FontSize="16" Glyph="&#xE721;" />
                            </Button>
                        </Grid>

                        <Button Style="{StaticResource SongListViewPageIconButton}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.CurrentSortOrderText, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.CurrentSortOrderText, Mode=OneWay}">
                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <RadioMenuFlyoutItem GroupName="ArtistViewSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                    CommandParameter="TitleAsc" Text="{x:Bind helpers:SortOrderHelper.TitleAscLabel}"
                                                    IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=TitleAsc}" />
                                    <RadioMenuFlyoutItem GroupName="ArtistViewSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                    CommandParameter="TitleDesc" Text="{x:Bind helpers:SortOrderHelper.TitleDescLabel}"
                                                    IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=TitleDesc}" />
                                    <RadioMenuFlyoutItem GroupName="ArtistViewSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                    CommandParameter="YearAsc" Text="{x:Bind helpers:SortOrderHelper.YearOldestLabel}"
                                                    IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=YearAsc}" />
                                    <RadioMenuFlyoutItem GroupName="ArtistViewSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                    CommandParameter="YearDesc" Text="{x:Bind helpers:SortOrderHelper.YearNewestLabel}"
                                                    IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=YearDesc}" />
                                    <RadioMenuFlyoutItem GroupName="ArtistViewSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                    CommandParameter="AlbumAsc" Text="{x:Bind helpers:SortOrderHelper.AlbumAscLabel}"
                                                    IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=AlbumAsc}" />
                                    <RadioMenuFlyoutItem GroupName="ArtistViewSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                    CommandParameter="AlbumDesc" Text="{x:Bind helpers:SortOrderHelper.AlbumDescLabel}"
                                                    IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=AlbumDesc}" />
                                    <RadioMenuFlyoutItem GroupName="ArtistViewSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                    CommandParameter="FileCreatedDateAsc" Text="{x:Bind helpers:SortOrderHelper.DateCreatedOldestLabel}"
                                                    IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=FileCreatedDateAsc}" />
                                    <RadioMenuFlyoutItem GroupName="ArtistViewSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                    CommandParameter="FileCreatedDateDesc" Text="{x:Bind helpers:SortOrderHelper.DateCreatedNewestLabel}"
                                                    IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=FileCreatedDateDesc}" />
                                </MenuFlyout>
                            </Button.Flyout>
                            <FontIcon FontSize="16" Glyph="&#xE8CB;" />
                        </Button>

                        <Button ToolTipService.ToolTip="{x:Bind resources:Strings.ArtistViewPage_PlayAllButton_ToolTip, Mode=OneTime}" AutomationProperties.Name="{x:Bind resources:Strings.ArtistViewPage_PlayAllButton_ToolTip, Mode=OneTime}" Style="{StaticResource SongListViewPageIconButton}"
                                Command="{x:Bind ViewModel.PlayAllSongsCommand}">
                            <FontIcon Glyph="" FontSize="16" />
                        </Button>

                        <SplitButton Style="{StaticResource SongListViewPageShuffleButton}" ToolTipService.ToolTip="{x:Bind resources:Strings.ArtistViewPage_ShufflePlayButton_ToolTip, Mode=OneTime}" AutomationProperties.Name="{x:Bind resources:Strings.ArtistViewPage_ShufflePlayButton_ToolTip, Mode=OneTime}"
                                Command="{x:Bind ViewModel.ShuffleAndPlayAllSongsCommand}">
                            <SplitButton.Flyout><MenuFlyout Opening="ListeningOptions_Opening" /></SplitButton.Flyout>
                            <FontIcon Glyph="" FontSize="16" />
                        </SplitButton>

                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Border x:Name="ColumnHeaderHost" Padding="{StaticResource PageContentPadding}" />
            <ListView uihelpers:ScrollEdgeFade.IsEnabled="True"
                Grid.Row="1"
                x:Name="SongsListView"
                Padding="{StaticResource PageContentPadding}"
                IsItemClickEnabled="True"
                ItemContainerStyle="{StaticResource SongListViewPageListViewItemStyle}"
                ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}"
                SelectionChanged="SongsListView_SelectionChanged"
                SelectionMode="Extended"
                DoubleTapped="SongsListView_DoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Song">
                        <uicontrols:SongRow Song="{x:Bind}" ViewModel="{Binding DataContext, ElementName=pageRoot}" Columns="{Binding DataContext.VisibleColumns, ElementName=pageRoot}" ShowGoToArtist="False" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <uicontrols:PaginationControl
            Grid.Row="2"
            ViewModel="{x:Bind ViewModel}"
            HorizontalAlignment="Right"
            Margin="0,16,24,16" />
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.Songs.Count, Mode=OneWay, Converter={StaticResource InverseCollectionCountToVisibilityConverter}}">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="20" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <FontIcon
                Glyph="&#xE8D6;"
                FontSize="48"
                Margin="0,0,0,12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="{x:Bind resources:Strings.ArtistViewPage_Empty_Title, Mode=OneTime}"
                Style="{StaticResource TitleTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="{x:Bind resources:Strings.ArtistViewPage_Empty_Subtitle, Mode=OneTime}"
                Style="{StaticResource SubtitleTextBlockStyle}"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>

    </Grid>
</pages:SongListPage>
