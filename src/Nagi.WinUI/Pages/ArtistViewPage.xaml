<pages:SongListPage
    xmlns:pages="using:Nagi.WinUI.Pages"
    x:Class="Nagi.WinUI.Pages.ArtistViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lists="using:Nagi.Presentation.Lists"
    xmlns:library="using:Nagi.Core.Library"
    xmlns:resources="using:Nagi.Presentation.Resources"
    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
    xmlns:uicontrols="using:Nagi.WinUI.Controls"
    x:Name="pageRoot"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="AlbumCardTemplate" x:DataType="lists:ArtistAlbumViewModelItem">
            <Grid x:Name="AlbumCard"
                Width="{StaticResource AlbumCardWidth}"
                MinHeight="{StaticResource AlbumCardMinHeight}"
                Margin="{StaticResource CollectionCardMargin}"
                Background="Transparent">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="LargeCard">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1600" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="AlbumCard.Width" Value="{StaticResource AlbumCardWidthLarge}" />
                                <Setter Target="AlbumCard.MinHeight" Value="{StaticResource AlbumCardMinHeightLarge}" />
                                <Setter Target="AlbumArtwork.Size" Value="{StaticResource AlbumCardImageSizeLarge}" />
                                <Setter Target="AlbumName.MaxWidth" Value="{StaticResource AlbumCardImageSizeLarge}" />
                                <Setter Target="AlbumYear.MaxWidth" Value="{StaticResource AlbumCardImageSizeLarge}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="NormalCard">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Text="{x:Bind resources:Strings.Generic_Play, Mode=OneTime}"
                            Command="{Binding ViewModel.PlayAlbumCommand, ElementName=pageRoot}"
                            CommandParameter="{x:Bind Id}"
                            IsEnabled="{Binding ViewModel.IsLoading, ElementName=pageRoot, Converter={StaticResource BooleanToInverseBooleanConverter}}" />
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <uicontrols:ArtworkImage x:Name="AlbumArtwork" Grid.Row="0"
                                         HorizontalAlignment="Center"
                                         Size="{StaticResource AlbumCardImageSize}"
                                         Source="{x:Bind CoverArtUri}"
                                         PlaceholderGlyph="&#xE93C;" />
                <TextBlock x:Name="AlbumName"
                    Grid.Row="1"
                    Margin="4,8,4,0"
                    MaxWidth="{StaticResource AlbumCardImageSize}"
                    HorizontalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Bind Name}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock x:Name="AlbumYear"
                    Grid.Row="2"
                    Margin="4,2,4,0"
                    MaxWidth="{StaticResource AlbumCardImageSize}"
                    HorizontalAlignment="Center"
                    Opacity="0.7"
                    Text="{x:Bind YearText}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </Grid>
        </DataTemplate>

    </Page.Resources>

    <Grid
          Padding="{StaticResource DetailPageContainerPadding}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer uihelpers:ScrollEdgeFade.IsEnabled="True" Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="{StaticResource ViewPageHeaderPadding}">
                <Grid Margin="{StaticResource SectionHeaderMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="{StaticResource HeaderImageSize}" Height="{StaticResource HeaderImageSize}" CornerRadius="{StaticResource HeaderImageCircleRadius}"
                          PointerEntered="ArtistImage_PointerEntered" PointerExited="ArtistImage_PointerExited"
                          Background="Transparent">
                        <uicontrols:ArtworkImage Size="{StaticResource HeaderImageSize}" IsCircular="True"
                                                 Source="{x:Bind ViewModel.ArtistImageUri, Mode=OneWay}"
                                                 PlaceholderGlyph="&#xE77B;" PlaceholderGlyphSize="64" />
                        <!-- A button, so the image menu is reachable by keyboard and screen readers, not only by pointer. -->
                        <Button x:Name="EditOverlay"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                CornerRadius="{StaticResource HeaderImageCircleRadius}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Opacity="0"
                                GotFocus="EditOverlay_GotFocus"
                                LostFocus="EditOverlay_LostFocus"
                                ToolTipService.ToolTip="{x:Bind resources:Strings.ArtistViewPage_EditOverlay_Content, Mode=OneTime}"
                                AutomationProperties.Name="{x:Bind resources:Strings.ArtistViewPage_EditOverlay_Content, Mode=OneTime}">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="{x:Bind resources:Strings.Generic_ChangeImage, Mode=OneTime}" Command="{x:Bind ViewModel.ChangeArtistImageCommand}" />
                                    <MenuFlyoutItem Text="{x:Bind resources:Strings.Generic_RemoveImage, Mode=OneTime}" Command="{x:Bind ViewModel.RemoveArtistImageCommand}"
                                                    Visibility="{x:Bind ViewModel.IsCustomImage, Mode=OneWay}" />
                                </MenuFlyout>
                            </Button.Flyout>
                            <Grid Background="{StaticResource MediaOnImageHoverScrimBrush}" CornerRadius="{StaticResource HeaderImageCircleRadius}">
                                <FontIcon Glyph="&#xE70F;" Foreground="{StaticResource MediaOnImageTextPrimaryBrush}" FontSize="32" />
                            </Grid>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="{x:Bind resources:Strings.ArtistViewPage_Header_Label, Mode=OneTime}" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock Style="{ThemeResource HeaderTextBlockStyle}"
                                   Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />
                        <TextBlock
                            MaxLines="3"
                            Opacity="0.8"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.ArtistBio, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.BiographyCredit, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.BiographyCredit, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="AlbumsViewport" VerticalAlignment="Top"
                      Visibility="{x:Bind ViewModel.HasAlbums, Mode=OneWay}">
                    <ScrollViewer VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="AlbumsContent" VerticalAlignment="Top" SizeChanged="OnAlbumsContentSizeChanged">
                        <TextBlock Text="{x:Bind resources:Strings.ArtistViewPage_Albums_Title, Mode=OneTime}" Style="{StaticResource SectionHeaderTextBlockStyle}" Foreground="{StaticResource AppPrimaryColorBrush}" />
                        <GridView
                            Padding="0"
                            IsItemClickEnabled="True"
                            ItemClick="AlbumGridView_ItemClick"
                            ItemsSource="{x:Bind ViewModel.Albums, Mode=OneWay}"
                            SelectionMode="None"
                            ItemTemplate="{StaticResource AlbumCardTemplate}"
                            ScrollViewer.HorizontalScrollMode="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                            ScrollViewer.IsHorizontalRailEnabled="True"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <uicontrols:SongListToolbar Margin="{StaticResource SectionHeaderMargin}" ViewModel="{x:Bind ViewModel}"
                                            SearchPlaceholder="{x:Bind resources:Strings.ArtistViewPage_SearchBox_Placeholder}"
                                            SearchToolTip="{x:Bind resources:Strings.ArtistViewPage_SearchButton_Search_ToolTip}" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Border x:Name="ColumnHeaderHost" Padding="{StaticResource PageContentPadding}" />
            <ListView Style="{StaticResource SongListViewStyle}"
                Grid.Row="1"
                x:Name="SongsListView"
                ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="library:Song">
                        <uicontrols:SongRow Song="{x:Bind}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <uicontrols:PaginationControl
            Grid.Row="2"
            ViewModel="{x:Bind ViewModel}"
            HorizontalAlignment="Right"
            Margin="0,16,24,16" />
        <uicontrols:EmptyState Grid.Row="1"
                               Glyph="&#xE8D6;"
                               Title="{x:Bind resources:Strings.ArtistViewPage_Empty_Title, Mode=OneTime}"
                               Subtitle="{x:Bind resources:Strings.Generic_TrySearchingElse, Mode=OneTime}"
                               IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                               HasLoadError="{x:Bind ViewModel.HasLoadError, Mode=OneWay}" />

    </Grid>
</pages:SongListPage>
