<pages:SearchablePage
    xmlns:pages="using:Nagi.WinUI.Pages"
    x:Class="Nagi.WinUI.Pages.ArtistPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ImageEx"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Nagi.Presentation.ViewModels"
    xmlns:resources="using:Nagi.Presentation.Resources"
    xmlns:uicontrols="using:Nagi.WinUI.Controls"
    x:Name="ArtistPageRoot"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PageContainerPaddingVertical}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SearchStates">
                <VisualState x:Name="SearchCollapsed">
                    <VisualState.Setters>
                        <Setter Target="SearchTextBox.Width" Value="0" />
                        <Setter Target="SearchTextBox.Opacity" Value="0" />
                        <Setter Target="SearchTextBox.IsHitTestVisible" Value="False" />
                        <Setter Target="SearchTextBox.IsTabStop" Value="False" />
                        <Setter Target="SearchIcon.Glyph" Value="&#xE721;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SearchExpanded">
                    <VisualState.Setters>
                        <Setter Target="SearchTextBox.Width" Value="{StaticResource SearchBoxExpandedWidth}" />
                        <Setter Target="SearchTextBox.Opacity" Value="1" />
                        <Setter Target="SearchTextBox.IsHitTestVisible" Value="True" />
                        <Setter Target="SearchTextBox.IsTabStop" Value="True" />
                        <Setter Target="SearchIcon.Glyph" Value="&#xE711;" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="{StaticResource CollectionPageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind resources:Strings.ArtistPage_Title, Mode=OneTime}" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock
                    Margin="0,0,0,5"
                    VerticalAlignment="Bottom"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.TotalItemsText, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Grid>
                    <TextBox x:Name="SearchTextBox"
                             PlaceholderText="{x:Bind resources:Strings.ArtistPage_SearchBox_Placeholder, Mode=OneTime}"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Width="0"
                             Opacity="0"
                             IsHitTestVisible="False"
                             IsTabStop="False"
                             HorizontalAlignment="Right"
                             KeyDown="OnSearchTextBoxKeyDown"
                             Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Canvas.ZIndex="0">
                        <TextBox.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.15" />
                        </TextBox.OpacityTransition>
                    </TextBox>
                    <Button x:Name="SearchToggleButton"
                            ToolTipService.ToolTip="{x:Bind resources:Strings.ArtistPage_SearchButton_Search_ToolTip, Mode=OneTime}"
                            AutomationProperties.Name="{x:Bind resources:Strings.ArtistPage_SearchButton_Search_ToolTip, Mode=OneTime}"
                            Click="OnSearchToggleButtonClick"
                            Style="{StaticResource SongListViewPageIconButton}"
                            HorizontalAlignment="Right"
                            Margin="0,0,1,0"
                            Canvas.ZIndex="1">
                        <FontIcon x:Name="SearchIcon" FontSize="16" Glyph="&#xE721;" />
                    </Button>
                </Grid>

                <uicontrols:SortButton Selection="{x:Bind ViewModel.Sort}" />

                <Button
                        ToolTipService.ToolTip="{x:Bind resources:Strings.ArtistPage_RandomButton_ToolTip, Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind resources:Strings.ArtistPage_RandomButton_ToolTip, Mode=OneTime}"
                        Style="{StaticResource SongListViewPageIconButton}"
                        Command="{x:Bind ViewModel.PlayRandomArtistCommand}"
                        Margin="0,0,1,0"
                        ContentTemplate="{StaticResource RandomPlayIconTemplate}" />

            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <GridView uihelpers:ScrollEdgeFade.IsEnabled="True"
                IsItemClickEnabled="True"
                ItemClick="ArtistsGridView_ItemClick"
                Padding="{StaticResource PageContentPadding}"
                ItemContainerStyle="{StaticResource AnimatedGridViewItemStyle}"
                ItemsSource="{x:Bind ViewModel.Artists, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.HasArtists, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid ItemWidth="{StaticResource CollectionGridItemWidth}" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ArtistViewModelItem">
                        <Grid
                            Width="{StaticResource CollectionCardWidth}"
                            Height="{StaticResource CollectionCardHeight}"
                            Margin="{StaticResource CollectionCardMargin}"
                            Background="Transparent">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Text="{x:Bind resources:Strings.ArtistPage_Menu_Play, Mode=OneTime}"
                                        Command="{Binding ViewModel.PlayArtistCommand, ElementName=ArtistPageRoot}"
                                        CommandParameter="{x:Bind Id}"
                                        IsEnabled="{Binding ViewModel.IsLoading, ElementName=ArtistPageRoot, Converter={StaticResource BooleanToInverseBooleanConverter}}" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        Text="{x:Bind resources:Strings.ArtistPage_Menu_ChangeImage, Mode=OneTime}"
                                        Command="{Binding DataContext.ChangeArtistImageCommand, ElementName=ArtistPageRoot}"
                                        CommandParameter="{x:Bind Id}" />
                                    <MenuFlyoutItem
                                        Text="{x:Bind resources:Strings.ArtistPage_Menu_RemoveImage, Mode=OneTime}"
                                        Command="{Binding DataContext.RemoveArtistImageCommand, ElementName=ArtistPageRoot}"
                                        CommandParameter="{x:Bind Id}"
                                        Visibility="{x:Bind IsCustomImage, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Width="{StaticResource CollectionCardImageSize}" Height="{StaticResource CollectionCardImageSize}" HorizontalAlignment="Center">
                                <Border
                                    CornerRadius="80"
                                    Visibility="{x:Bind IsArtworkAvailable, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                    <controls:ImageEx Width="{StaticResource CollectionCardImageSize}" Height="{StaticResource CollectionCardImageSize}"
                                        IsCacheEnabled="True"
                                        Source="{x:Bind LocalImageCachePath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}, FallbackValue=null}"
                                        DecodePixelWidth="{StaticResource CollectionCardImageSize}"
                                        DecodePixelType="Logical"
                                        Stretch="UniformToFill" />
                                </Border>
                                <Grid
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="80"
                                    Visibility="{x:Bind IsArtworkAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="48"
                                        Glyph="" />
                                </Grid>
                            </Grid>

                            <TextBlock
                                Grid.Row="1"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{x:Bind Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <uicontrols:EmptyState Glyph="&#xE77B;"
                                   Title="{x:Bind resources:Strings.ArtistPage_Empty_Title, Mode=OneTime}"
                                   Subtitle="{x:Bind resources:Strings.ArtistPage_Empty_Subtitle, Mode=OneTime}"
                                   IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                                   HasLoadError="{x:Bind ViewModel.HasLoadError, Mode=OneWay}" />
        </Grid>

        <uicontrols:PaginationControl
            Grid.Row="2"
            ViewModel="{x:Bind ViewModel}"
            HorizontalAlignment="Right"
            Margin="0,16,24,16" />
    </Grid>
</pages:SearchablePage>
