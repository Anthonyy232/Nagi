<pages:CollectionPage
    xmlns:pages="using:Nagi.WinUI.Pages"
    x:Class="Nagi.WinUI.Pages.ArtistPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lists="using:Nagi.Presentation.Lists"
    xmlns:resources="using:Nagi.Presentation.Resources"
    xmlns:uicontrols="using:Nagi.WinUI.Controls"
    x:Name="Root"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PageContainerPaddingVertical}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <uicontrols:CollectionPageHeader Grid.Row="0" Margin="{StaticResource CollectionPageHeaderMargin}"
                                         ViewModel="{x:Bind ViewModel}"
                                         Title="{x:Bind resources:Strings.ArtistPage_Title}"
                                         CountText="{x:Bind ViewModel.TotalItemsText, Mode=OneWay}"
                                         SearchPlaceholder="{x:Bind resources:Strings.ArtistPage_SearchBox_Placeholder}"
                                         SearchToolTip="{x:Bind resources:Strings.ArtistPage_SearchButton_Search_ToolTip}" />

        <Grid Grid.Row="1">
            <GridView x:Name="CollectionGrid" Style="{StaticResource CollectionGridViewStyle}"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid ItemWidth="{StaticResource CollectionGridItemWidth}" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="lists:ArtistViewModelItem">
                        <Grid
                            Width="{StaticResource CollectionCardWidth}"
                            Height="{StaticResource CollectionCardHeight}"
                            Margin="{StaticResource CollectionCardMargin}"
                            Background="Transparent">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Text="{x:Bind resources:Strings.Generic_Play, Mode=OneTime}"
                                        Command="{Binding ViewModel.PlayArtistCommand, ElementName=Root}"
                                        CommandParameter="{x:Bind Id}"
                                        IsEnabled="{Binding ViewModel.IsLoading, ElementName=Root, Converter={StaticResource BooleanToInverseBooleanConverter}}" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        Text="{x:Bind resources:Strings.Generic_ChangeImage, Mode=OneTime}"
                                        Command="{Binding ViewModel.ChangeArtistImageCommand, ElementName=Root}"
                                        CommandParameter="{x:Bind Id}" />
                                    <MenuFlyoutItem
                                        Text="{x:Bind resources:Strings.Generic_RemoveImage, Mode=OneTime}"
                                        Command="{Binding ViewModel.RemoveArtistImageCommand, ElementName=Root}"
                                        CommandParameter="{x:Bind Id}"
                                        Visibility="{x:Bind IsCustomImage, Mode=OneWay}" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <uicontrols:ArtworkImage Grid.Row="0" HorizontalAlignment="Center" Size="{StaticResource CollectionCardImageSize}" IsCircular="True"
                                                         Source="{x:Bind ImageUri, Mode=OneWay}"
                                                         PlaceholderGlyph="" />

                            <TextBlock
                                Grid.Row="1"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{x:Bind Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <uicontrols:EmptyState Glyph="&#xE77B;"
                                   Title="{x:Bind resources:Strings.ArtistPage_Empty_Title, Mode=OneTime}"
                                   Subtitle="{x:Bind resources:Strings.ArtistPage_Empty_Subtitle, Mode=OneTime}"
                                   IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                                   HasLoadError="{x:Bind ViewModel.HasLoadError, Mode=OneWay}" />
        </Grid>

        <uicontrols:PaginationControl
            Grid.Row="2"
            ViewModel="{x:Bind ViewModel}"
            HorizontalAlignment="Right"
            Margin="0,16,24,16" />
    </Grid>
</pages:CollectionPage>
