<pages:CollectionPage
    xmlns:pages="using:Nagi.WinUI.Pages"
    x:Class="Nagi.WinUI.Pages.AlbumPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lists="using:Nagi.Presentation.Lists"
    xmlns:uicontrols="using:Nagi.WinUI.Controls"
    xmlns:resources="using:Nagi.Presentation.Resources"
    x:Name="Root"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PageContainerPaddingVertical}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <uicontrols:CollectionPageHeader Grid.Row="0" Margin="{StaticResource CollectionPageHeaderMargin}"
                                         ViewModel="{x:Bind ViewModel}"
                                         Title="{x:Bind resources:Strings.AlbumPage_Title}"
                                         CountText="{x:Bind ViewModel.TotalItemsText, Mode=OneWay}"
                                         SearchPlaceholder="{x:Bind resources:Strings.AlbumPage_SearchBox_Placeholder}"
                                         SearchToolTip="{x:Bind resources:Strings.AlbumPage_SearchButton_Search_ToolTip}" />

        <Grid Grid.Row="1">
            <GridView x:Name="CollectionGrid" Style="{StaticResource CollectionGridViewStyle}"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid ItemWidth="{StaticResource CollectionGridItemWidth}" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="lists:AlbumViewModelItem">
                        <Grid
                            Width="{StaticResource CollectionCardWidth}"
                            Height="{StaticResource CollectionCardHeight}"
                            Margin="{StaticResource CollectionCardMargin}"
                            Background="Transparent">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Text="{x:Bind resources:Strings.Generic_Play, Mode=OneTime}"
                                        Command="{Binding ViewModel.PlayAlbumCommand, ElementName=Root}"
                                        CommandParameter="{x:Bind Id}" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <uicontrols:ArtworkImage Grid.Row="0" HorizontalAlignment="Center" Size="{StaticResource CollectionCardImageSize}"
                                                         Source="{x:Bind CoverArtUri, Mode=OneTime}"
                                                         PlaceholderGlyph="&#xE93C;" />

                            <TextBlock
                                Grid.Row="1"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{x:Bind Title, Mode=OneTime}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />

                            <uicontrols:ArtistLinks
                                Grid.Row="2"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="{StaticResource CaptionTextBlockFontSize}"
                                ArtistName="{x:Bind ArtistName, Mode=OneTime}"
                                AlbumArtists="{x:Bind AlbumArtists, Mode=OneTime}"
                                Command="{Binding ViewModel.GoToArtistCommand, ElementName=Root}" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <uicontrols:EmptyState Glyph="&#xE93C;"
                                   Title="{x:Bind resources:Strings.AlbumPage_Empty_Title, Mode=OneTime}"
                                   Subtitle="{x:Bind resources:Strings.AlbumPage_Empty_Subtitle, Mode=OneTime}"
                                   IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                                   HasLoadError="{x:Bind ViewModel.HasLoadError, Mode=OneWay}" />
        </Grid>

        <uicontrols:PaginationControl
            Grid.Row="2"
            ViewModel="{x:Bind ViewModel}"
            HorizontalAlignment="Right"
            Margin="0,16,24,16" />
    </Grid>
</pages:CollectionPage>
