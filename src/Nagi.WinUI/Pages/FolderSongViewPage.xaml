<pages:SongListPage x:Class="Nagi.WinUI.Pages.FolderSongViewPage"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:lists="using:Nagi.Presentation.Lists"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:pages="using:Nagi.WinUI.Pages"
                    xmlns:resources="using:Nagi.Presentation.Resources"
                    xmlns:uicontrols="using:Nagi.WinUI.Controls"
                    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
                    x:Name="Root"
                    Background="Transparent"
                    mc:Ignorable="d">

    <Page.Resources>
        <uihelpers:FolderContentItemTemplateSelector x:Key="FolderContentItemTemplateSelector">
            <uihelpers:FolderContentItemTemplateSelector.FolderTemplate>
                <DataTemplate x:DataType="lists:FolderContentItem">
                    <Grid Height="54"
                          Background="Transparent"
                          ColumnSpacing="12">
                        <Grid.ContextFlyout>
                            <MenuFlyout Opening="FolderItemMenuFlyout_Opening">
                                <MenuFlyoutItem Command="{Binding ViewModel.PlaySubfolderCommand, ElementName=Root}"
                                                CommandParameter="{x:Bind Folder}"
                                                Text="{x:Bind resources:Strings.Generic_Play, Mode=OneTime}" />
                                <MenuFlyoutSubItem Text="{x:Bind resources:Strings.SongList_Context_AddToPlaylist, Mode=OneTime}" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="42"
                                Height="42"
                                Margin="12,0,0,0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="{StaticResource ArtworkCornerRadius}">
                            <FontIcon HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      FontSize="20"
                                      Glyph="&#xE8B7;" />
                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Text="{x:Bind Folder.Name}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                    </Grid>
                </DataTemplate>
            </uihelpers:FolderContentItemTemplateSelector.FolderTemplate>

            <uihelpers:FolderContentItemTemplateSelector.SongTemplate>
                <DataTemplate x:DataType="lists:FolderContentItem">
                    <uicontrols:SongRow Song="{x:Bind Song}" />
                </DataTemplate>
            </uihelpers:FolderContentItemTemplateSelector.SongTemplate>
        </uihelpers:FolderContentItemTemplateSelector>
    </Page.Resources>

    <Grid Padding="{StaticResource DetailPageContainerPadding}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Padding="{StaticResource ViewPageHeaderPadding}">
            <uicontrols:DetailPageHeader Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                                         Margin="{StaticResource SectionHeaderMargin}"
                                         Caption="{x:Bind ViewModel.HeaderLabel, Mode=OneWay}">
                <uicontrols:DetailPageHeader.Artwork>
                    <Grid Width="{StaticResource HeaderImageSize}" Height="{StaticResource HeaderImageSize}">
                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{StaticResource ArtworkCornerRadius}">
                            <FontIcon HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      FontSize="64"
                                      Glyph="&#xE8B7;"
                                      Visibility="{x:Bind ViewModel.IsServer, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            <FontIcon HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      FontSize="64"
                                      Glyph="&#xE8CE;"
                                      Visibility="{x:Bind ViewModel.IsServer, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </uicontrols:DetailPageHeader.Artwork>
            </uicontrols:DetailPageHeader>
            <Border Style="{StaticResource InfoStripBorderStyle}" Visibility="{x:Bind ViewModel.IsAtRootLevel, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}">
                <BreadcrumbBar ItemClicked="OnBreadcrumbItemClicked" ItemsSource="{x:Bind ViewModel.Breadcrumbs, Mode=OneWay}">
                    <BreadcrumbBar.ItemTemplate>
                        <DataTemplate x:DataType="lists:BreadcrumbItem">
                            <TextBlock Text="{x:Bind Name}" />
                        </DataTemplate>
                    </BreadcrumbBar.ItemTemplate>
                </BreadcrumbBar>
            </Border>
            <uicontrols:SongListToolbar Margin="{StaticResource SectionHeaderMargin}"
                                        SearchPlaceholder="{x:Bind resources:Strings.FolderSongViewPage_SearchBox_Placeholder}"
                                        SearchToolTip="{x:Bind resources:Strings.FolderSongViewPage_SearchButton_Search_ToolTip}"
                                        ViewModel="{x:Bind ViewModel}" />
        </StackPanel>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Border x:Name="ColumnHeaderHost" Padding="{StaticResource PageContentPadding}" />
            <ListView x:Name="FolderContentsListView"
                      Grid.Row="1"
                      ItemClick="FolderContentsListView_ItemClick"
                      ItemTemplateSelector="{StaticResource FolderContentItemTemplateSelector}"
                      ItemsSource="{x:Bind ViewModel.FolderContents, Mode=OneWay}"
                      Style="{StaticResource SongListViewStyle}" />
        </Grid>

        <uicontrols:PaginationControl Grid.Row="2" ViewModel="{x:Bind ViewModel}" />
        <uicontrols:EmptyState Title="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
                               Grid.Row="1"
                               Glyph="{x:Bind EmptyGlyph(ViewModel.IsServer), Mode=OneWay}"
                               HasLoadError="{x:Bind ViewModel.HasLoadError, Mode=OneWay}"
                               IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                               Subtitle="{x:Bind ViewModel.EmptySubtitle, Mode=OneWay}" />

    </Grid>
</pages:SongListPage>
