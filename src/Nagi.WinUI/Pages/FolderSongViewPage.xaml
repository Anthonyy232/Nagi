<pages:SongListPage
    xmlns:pages="using:Nagi.WinUI.Pages"
    x:Class="Nagi.WinUI.Pages.FolderSongViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Nagi.Presentation.Models"
    xmlns:resources="using:Nagi.Presentation.Resources"
    xmlns:vm="using:Nagi.Presentation.ViewModels"
    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
    xmlns:uicontrols="using:Nagi.WinUI.Controls"
    x:Name="pageRoot"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <uihelpers:FolderContentItemTemplateSelector x:Key="FolderContentItemTemplateSelector">
            <uihelpers:FolderContentItemTemplateSelector.FolderTemplate>
                <DataTemplate x:DataType="local:FolderContentItem">
                    <Grid Height="54" ColumnSpacing="12" Background="Transparent">
                        <Grid.ContextFlyout>
                            <MenuFlyout Opening="FolderItemMenuFlyout_Opening">
                                <MenuFlyoutItem
                                    Text="{x:Bind resources:Strings.Generic_Play, Mode=OneTime}"
                                    Command="{Binding DataContext.PlaySubfolderCommand, ElementName=pageRoot}"
                                    CommandParameter="{x:Bind Folder}" />
                                <MenuFlyoutSubItem Text="{x:Bind resources:Strings.SongList_Context_AddToPlaylist, Mode=OneTime}" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="42" Height="42" Margin="12,0,0,0" CornerRadius="{StaticResource ArtworkCornerRadius}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <FontIcon FontSize="20" Glyph="&#xE8B7;" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Text="{x:Bind Folder.Name}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </uihelpers:FolderContentItemTemplateSelector.FolderTemplate>

            <uihelpers:FolderContentItemTemplateSelector.SongTemplate>
                <DataTemplate x:DataType="local:FolderContentItem">
                    <uicontrols:SongRow Song="{x:Bind Song}" ViewModel="{Binding DataContext, ElementName=pageRoot}" />
                </DataTemplate>
            </uihelpers:FolderContentItemTemplateSelector.SongTemplate>
        </uihelpers:FolderContentItemTemplateSelector>
    </Page.Resources>

    <Grid
          Padding="{StaticResource DetailPageContainerPadding}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Padding="{StaticResource ViewPageHeaderPadding}">
            <Grid Margin="{StaticResource SectionHeaderMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="{StaticResource HeaderImageSize}" Height="{StaticResource HeaderImageSize}">
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          CornerRadius="{StaticResource ArtworkCornerRadius}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="64"
                            Glyph="&#xE8B7;"
                            Visibility="{x:Bind ViewModel.IsServer, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="64"
                            Glyph="&#xE8CE;"
                            Visibility="{x:Bind ViewModel.IsServer, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Bottom" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.HeaderLabel, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock Style="{ThemeResource HeaderTextBlockStyle}"
                               Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />
                </StackPanel>
            </Grid>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="16,8" CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Visibility="{x:Bind ViewModel.IsAtRootLevel, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}"
                    Margin="{StaticResource SectionHeaderMargin}">
                <BreadcrumbBar ItemsSource="{x:Bind ViewModel.Breadcrumbs, Mode=OneWay}"
                               ItemClicked="OnBreadcrumbItemClicked">
                    <BreadcrumbBar.ItemTemplate>
                        <DataTemplate x:DataType="vm:BreadcrumbItem">
                            <TextBlock Text="{x:Bind Name}" />
                        </DataTemplate>
                    </BreadcrumbBar.ItemTemplate>
                </BreadcrumbBar>
            </Border>
            <Grid Margin="{StaticResource SectionHeaderMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind resources:Strings.SongList_Songs, Mode=OneTime}" Style="{StaticResource SectionHeaderTextBlockStyle}" Foreground="{StaticResource AppPrimaryColorBrush}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.SelectedItemsCountText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasSelectedSongs, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{x:Bind ViewModel.TotalItemsText, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                               FontSize="13"
                               Visibility="{x:Bind ViewModel.HasSelectedSongs, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <uicontrols:SearchToggle SearchTerm="{x:Bind ViewModel.SearchTerm, Mode=TwoWay}" PlaceholderText="{x:Bind resources:Strings.FolderSongViewPage_SearchBox_Placeholder, Mode=OneTime}" SearchToolTip="{x:Bind resources:Strings.FolderSongViewPage_SearchButton_Search_ToolTip, Mode=OneTime}" />

                    <uicontrols:SortButton Selection="{x:Bind ViewModel.Sort}" />

                    <uicontrols:SongListPlayButtons ViewModel="{x:Bind ViewModel}" />

                </StackPanel>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Border x:Name="ColumnHeaderHost" Padding="{StaticResource PageContentPadding}" />
            <ListView uihelpers:ScrollEdgeFade.IsEnabled="True"
                x:Name="FolderContentsListView"
                Grid.Row="1"
                Padding="{StaticResource PageContentPadding}"
                IsItemClickEnabled="True"
                ItemClick="FolderContentsListView_ItemClick"
                ItemContainerStyle="{StaticResource SongListViewPageListViewItemStyle}"
                ItemsSource="{x:Bind ViewModel.FolderContents, Mode=OneWay}"
                ItemTemplateSelector="{StaticResource FolderContentItemTemplateSelector}"
                SelectionChanged="SongsListView_SelectionChanged"
                SelectionMode="Extended"
                DoubleTapped="FolderContentsListView_DoubleTapped">
            </ListView>
        </Grid>

        <uicontrols:PaginationControl
            Grid.Row="2"
            ViewModel="{x:Bind ViewModel}"
            HorizontalAlignment="Right"
            Margin="0,16,24,16" />
        <uicontrols:EmptyState Grid.Row="1"
                               Glyph="{x:Bind EmptyGlyph(ViewModel.IsServer), Mode=OneWay}"
                               Title="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
                               Subtitle="{x:Bind ViewModel.EmptySubtitle, Mode=OneWay}"
                               IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                               HasLoadError="{x:Bind ViewModel.HasLoadError, Mode=OneWay}" />

    </Grid>
</pages:SongListPage>
