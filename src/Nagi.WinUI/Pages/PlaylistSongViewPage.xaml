<pages:SongListPage x:Class="Nagi.WinUI.Pages.PlaylistSongViewPage"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:library="using:Nagi.Core.Library"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:pages="using:Nagi.WinUI.Pages"
                    xmlns:resources="using:Nagi.Presentation.Resources"
                    xmlns:uicontrols="using:Nagi.WinUI.Controls"
                    Background="Transparent"
                    mc:Ignorable="d">

    <Grid Padding="{StaticResource DetailPageContainerPadding}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="{StaticResource ViewPageHeaderPadding}">
            <uicontrols:DetailPageHeader Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                                         Margin="{StaticResource SectionHeaderMargin}"
                                         Caption="{x:Bind resources:Strings.PlaylistSongViewPage_Header_Caption, Mode=OneTime}">
                <uicontrols:DetailPageHeader.Artwork>
                    <uicontrols:ArtworkImage PlaceholderGlyph="&#xE90B;"
                                             PlaceholderGlyphSize="64"
                                             Size="{StaticResource HeaderImageSize}"
                                             Source="{x:Bind ViewModel.CoverImageUri, Mode=OneWay}" />
                </uicontrols:DetailPageHeader.Artwork>
            </uicontrols:DetailPageHeader>

            <uicontrols:SongListToolbar Margin="{StaticResource SectionHeaderMargin}"
                                        SearchPlaceholder="{x:Bind resources:Strings.PlaylistSongViewPage_SearchBox_Placeholder}"
                                        SearchToolTip="{x:Bind resources:Strings.PlaylistSongViewPage_SearchButton_Search_ToolTip}"
                                        ViewModel="{x:Bind ViewModel}" />
        </StackPanel>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Border x:Name="ColumnHeaderHost" Padding="{StaticResource PageContentPadding}" />
            <ListView x:Name="SongsListView"
                      Grid.Row="1"
                      AllowDrop="{x:Bind ViewModel.IsReorderingEnabled, Mode=OneWay}"
                      CanDragItems="{x:Bind ViewModel.IsReorderingEnabled, Mode=OneWay}"
                      CanReorderItems="{x:Bind ViewModel.IsReorderingEnabled, Mode=OneWay}"
                      DragItemsCompleted="SongsListView_DragItemsCompleted"
                      ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}"
                      Style="{StaticResource SongListViewStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="library:Song">
                        <uicontrols:SongRow Song="{x:Bind}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <uicontrols:EmptyState Title="{x:Bind resources:Strings.PlaylistSongViewPage_EmptyState_Title, Mode=OneTime}"
                               Grid.Row="1"
                               Glyph="&#xE90B;"
                               HasLoadError="{x:Bind ViewModel.HasLoadError, Mode=OneWay}"
                               IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                               Subtitle="{x:Bind resources:Strings.PlaylistSongViewPage_EmptyState_Subtitle, Mode=OneTime}" />

    </Grid>
</pages:SongListPage>
