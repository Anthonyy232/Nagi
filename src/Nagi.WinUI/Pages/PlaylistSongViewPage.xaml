<pages:SongListPage
    xmlns:pages="using:Nagi.WinUI.Pages"
    x:Class="Nagi.WinUI.Pages.PlaylistSongViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ImageEx"
    xmlns:resources="using:Nagi.Presentation.Resources"
    xmlns:models="using:Nagi.Core.Models"
    xmlns:helpers="using:Nagi.Core.Helpers"
    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
    xmlns:uicontrols="using:Nagi.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent"
    x:Name="pageRoot">

    <Grid Padding="{StaticResource DetailPageContainerPadding}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SearchStates">
                <VisualState x:Name="SearchCollapsed">
                    <VisualState.Setters>
                        <Setter Target="SearchTextBox.Width" Value="0" />
                        <Setter Target="SearchTextBox.Opacity" Value="0" />
                        <Setter Target="SearchTextBox.IsHitTestVisible" Value="False" />
                        <Setter Target="SearchTextBox.IsTabStop" Value="False" />
                        <Setter Target="SearchIcon.Glyph" Value="&#xE721;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SearchExpanded">
                    <VisualState.Setters>
                        <Setter Target="SearchTextBox.Width" Value="{StaticResource SearchBoxExpandedWidth}" />
                        <Setter Target="SearchTextBox.Opacity" Value="1" />
                        <Setter Target="SearchTextBox.IsHitTestVisible" Value="True" />
                        <Setter Target="SearchTextBox.IsTabStop" Value="True" />
                        <Setter Target="SearchIcon.Glyph" Value="&#xE711;" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="{StaticResource ViewPageHeaderPadding}">
            <Grid Margin="{StaticResource SectionHeaderMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="{StaticResource HeaderImageSize}" Height="{StaticResource HeaderImageSize}">
                    <Border CornerRadius="{StaticResource ArtworkCornerRadius}"
                            Visibility="{x:Bind ViewModel.IsArtworkAvailable, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                        <controls:ImageEx Width="{StaticResource HeaderImageSize}" Height="{StaticResource HeaderImageSize}"
                            IsCacheEnabled="True"
                            Source="{x:Bind ViewModel.CoverImageUri, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}, FallbackValue=null}"
                            DecodePixelWidth="{StaticResource HeaderImageSize}"
                            DecodePixelType="Logical"
                            Stretch="UniformToFill" />
                    </Border>
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          CornerRadius="{StaticResource ArtworkCornerRadius}"
                          Visibility="{x:Bind ViewModel.IsArtworkAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="64"
                            Glyph="&#xE90B;" />
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Bottom" Spacing="8">
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind resources:Strings.PlaylistSongViewPage_Header_Caption, Mode=OneTime}" />
                    <TextBlock Style="{ThemeResource HeaderTextBlockStyle}"
                               Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <Grid Margin="{StaticResource SectionHeaderMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SectionHeaderTextBlockStyle}" Text="{x:Bind resources:Strings.PlaylistSongViewPage_Section_Songs, Mode=OneTime}" Foreground="{StaticResource AppPrimaryColorBrush}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.SelectedItemsCountText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasSelectedSongs, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{x:Bind ViewModel.TotalItemsText, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                               FontSize="13"
                               Visibility="{x:Bind ViewModel.HasSelectedSongs, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Grid>
                        <TextBox x:Name="SearchTextBox"
                                 PlaceholderText="{x:Bind resources:Strings.PlaylistSongViewPage_SearchBox_Placeholder, Mode=OneTime}"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Width="0"
                                 Opacity="0"
                                 IsHitTestVisible="False"
                             IsTabStop="False"
                                 HorizontalAlignment="Right"
                                 KeyDown="OnSearchTextBoxKeyDown"
                                 Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Canvas.ZIndex="0">
                            <TextBox.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.15" />
                            </TextBox.OpacityTransition>
                        </TextBox>

                        <Button x:Name="SearchToggleButton"
                                ToolTipService.ToolTip="{x:Bind resources:Strings.PlaylistSongViewPage_SearchButton_Search_ToolTip, Mode=OneTime}"
                                AutomationProperties.Name="{x:Bind resources:Strings.PlaylistSongViewPage_SearchButton_Search_ToolTip, Mode=OneTime}"
                                Click="OnSearchToggleButtonClick"
                                Style="{StaticResource SongListViewPageIconButton}"
                                HorizontalAlignment="Right"
                                Margin="0,0,1,0"
                                IsHitTestVisible="True"
                                Canvas.ZIndex="1">
                            <FontIcon x:Name="SearchIcon" FontSize="16" Glyph="&#xE721;" />
                        </Button>
                    </Grid>

                    <Button Style="{StaticResource SongListViewPageIconButton}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.CurrentSortOrderText, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.CurrentSortOrderText, Mode=OneWay}">
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <RadioMenuFlyoutItem GroupName="PlaylistSongSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="PlaylistOrder" Text="{x:Bind helpers:SortOrderHelper.PlaylistOrderLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=PlaylistOrder}" />
                                <RadioMenuFlyoutItem GroupName="PlaylistSongSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="TitleAsc" Text="{x:Bind helpers:SortOrderHelper.TitleAscLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=TitleAsc}" />
                                <RadioMenuFlyoutItem GroupName="PlaylistSongSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="TitleDesc" Text="{x:Bind helpers:SortOrderHelper.TitleDescLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=TitleDesc}" />
                                <RadioMenuFlyoutItem GroupName="PlaylistSongSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="YearAsc" Text="{x:Bind helpers:SortOrderHelper.YearOldestLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=YearAsc}" />
                                <RadioMenuFlyoutItem GroupName="PlaylistSongSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="YearDesc" Text="{x:Bind helpers:SortOrderHelper.YearNewestLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=YearDesc}" />
                                <RadioMenuFlyoutItem GroupName="PlaylistSongSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="ArtistAsc" Text="{x:Bind helpers:SortOrderHelper.ArtistAscLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=ArtistAsc}" />
                                <RadioMenuFlyoutItem GroupName="PlaylistSongSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="ArtistDesc" Text="{x:Bind helpers:SortOrderHelper.ArtistDescLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=ArtistDesc}" />
                                <RadioMenuFlyoutItem GroupName="PlaylistSongSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="AlbumAsc" Text="{x:Bind helpers:SortOrderHelper.AlbumAscLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=AlbumAsc}" />
                                <RadioMenuFlyoutItem GroupName="PlaylistSongSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="AlbumDesc" Text="{x:Bind helpers:SortOrderHelper.AlbumDescLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=AlbumDesc}" />
                                <RadioMenuFlyoutItem GroupName="PlaylistSongSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="FileCreatedDateAsc" Text="{x:Bind helpers:SortOrderHelper.DateCreatedOldestLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=FileCreatedDateAsc}" />
                                <RadioMenuFlyoutItem GroupName="PlaylistSongSort" Command="{x:Bind ViewModel.RefreshOrSortSongsCommand}"
                                                CommandParameter="FileCreatedDateDesc" Text="{x:Bind helpers:SortOrderHelper.DateCreatedNewestLabel}"
                                                IsChecked="{x:Bind ViewModel.CurrentSortOrder, Mode=OneWay, Converter={StaticResource SortOrderEqualsConverter}, ConverterParameter=FileCreatedDateDesc}" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <FontIcon FontSize="16" Glyph="&#xE8CB;" />
                    </Button>

                    <Button Style="{StaticResource SongListViewPageIconButton}"
                            ToolTipService.ToolTip="{x:Bind resources:Strings.PlaylistSongViewPage_PlayAllButton_ToolTip, Mode=OneTime}"
                            AutomationProperties.Name="{x:Bind resources:Strings.PlaylistSongViewPage_PlayAllButton_ToolTip, Mode=OneTime}"
                            Command="{x:Bind ViewModel.PlayAllSongsCommand}">
                        <FontIcon Glyph="" FontSize="16" />
                    </Button>

                    <SplitButton Style="{StaticResource SongListViewPageShuffleButton}"
                            ToolTipService.ToolTip="{x:Bind resources:Strings.PlaylistSongViewPage_ShufflePlayAllButton_ToolTip, Mode=OneTime}"
                            AutomationProperties.Name="{x:Bind resources:Strings.PlaylistSongViewPage_ShufflePlayAllButton_ToolTip, Mode=OneTime}"
                            Command="{x:Bind ViewModel.ShuffleAndPlayAllSongsCommand}">
                        <SplitButton.Flyout><MenuFlyout Opening="ListeningOptions_Opening" /></SplitButton.Flyout>
                        <FontIcon Glyph="" FontSize="16" />
                    </SplitButton>

                </StackPanel>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Border x:Name="ColumnHeaderHost" Padding="{StaticResource PageContentPadding}" />
            <ListView uihelpers:ScrollEdgeFade.IsEnabled="True" Grid.Row="1"
                      x:Name="SongsListView"
                      SelectionMode="Extended"
                      IsItemClickEnabled="True"
                      Padding="{StaticResource PageContentPadding}"
                      ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}"
                      ItemContainerStyle="{StaticResource SongListViewPageListViewItemStyle}"
                      CanDragItems="{x:Bind ViewModel.IsReorderingEnabled, Mode=OneWay}"
                      CanReorderItems="{x:Bind ViewModel.IsReorderingEnabled, Mode=OneWay}"
                      AllowDrop="{x:Bind ViewModel.IsReorderingEnabled, Mode=OneWay}"
                      SelectionChanged="SongsListView_SelectionChanged"
                      DoubleTapped="SongsListView_DoubleTapped"
                      DragItemsCompleted="SongsListView_DragItemsCompleted">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Song">
                        <uicontrols:SongRow Song="{x:Bind}" ViewModel="{Binding DataContext, ElementName=pageRoot}" Columns="{Binding DataContext.VisibleColumns, ElementName=pageRoot}" RemoveFromPlaylistCommand="{Binding DataContext.RemoveSelectedSongsFromPlaylistCommand, ElementName=pageRoot}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.Songs.Count, Mode=OneWay, Converter={StaticResource InverseCollectionCountToVisibilityConverter}}">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="20" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <FontIcon
                Glyph="&#xE90B;"
                FontSize="48"
                Margin="0,0,0,12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind resources:Strings.PlaylistSongViewPage_EmptyState_Title, Mode=OneTime}"
                HorizontalAlignment="Center" />
            <TextBlock
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind resources:Strings.PlaylistSongViewPage_EmptyState_Subtitle, Mode=OneTime}"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>

    </Grid>
</pages:SongListPage>
