<pages:CollectionPage x:Class="Nagi.WinUI.Pages.GenrePage"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:library="using:Nagi.Core.Library"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:pages="using:Nagi.WinUI.Pages"
                      xmlns:resources="using:Nagi.Presentation.Resources"
                      xmlns:uicontrols="using:Nagi.WinUI.Controls"
                      x:Name="Root"
                      Background="Transparent"
                      NavigationCacheMode="Enabled"
                      mc:Ignorable="d">

    <Grid Padding="{StaticResource PageContainerPaddingVertical}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <uicontrols:CollectionPageHeader Title="{x:Bind resources:Strings.GenrePage_Title}"
                                         Grid.Row="0"
                                         Margin="{StaticResource CollectionPageHeaderMargin}"
                                         SearchPlaceholder="{x:Bind resources:Strings.GenrePage_SearchBox_Placeholder}"
                                         SearchToolTip="{x:Bind resources:Strings.GenrePage_SearchButton_Search_ToolTip}"
                                         ViewModel="{x:Bind ViewModel}" />

        <Grid Grid.Row="1">
            <GridView x:Name="CollectionGrid"
                      ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                      Style="{StaticResource CollectionGridViewStyle}">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid ItemHeight="{StaticResource GenreGridItemHeight}"
                                       ItemWidth="{StaticResource GenreGridItemWidth}"
                                       Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="library:GenreSummary">
                        <!--  The background is bound to the genre name, producing a unique gradient for each.  -->
                        <Grid Margin="{StaticResource CollectionCardMargin}"
                              Padding="{StaticResource SurfaceContentPadding}"
                              Background="{x:Bind Name, Converter={StaticResource GenreToGradientConverter}, Mode=OneTime}"
                              CornerRadius="{StaticResource ArtworkCornerRadius}">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Command="{Binding ViewModel.PlayGenreCommand, ElementName=Root}"
                                                    CommandParameter="{x:Bind Id}"
                                                    Text="{x:Bind resources:Strings.Generic_Play, Mode=OneTime}" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Foreground="{StaticResource MediaOnImageTextPrimaryBrush}"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           Text="{x:Bind Name, Mode=OneTime}"
                                           TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <uicontrols:EmptyState Title="{x:Bind resources:Strings.GenrePage_Empty_Title, Mode=OneTime}"
                                   Glyph="&#xE8EC;"
                                   HasLoadError="{x:Bind ViewModel.HasLoadError, Mode=OneWay}"
                                   IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                                   Subtitle="{x:Bind resources:Strings.GenrePage_Empty_Subtitle, Mode=OneTime}" />
        </Grid>
    </Grid>
</pages:CollectionPage>
