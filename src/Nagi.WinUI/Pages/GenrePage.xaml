<pages:CollectionPage
    xmlns:pages="using:Nagi.WinUI.Pages"
    x:Class="Nagi.WinUI.Pages.GenrePage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:resources="using:Nagi.Presentation.Resources"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:library="using:Nagi.Core.Library"
    xmlns:uicontrols="using:Nagi.WinUI.Controls"
    x:Name="Root"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PageContainerPaddingVertical}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <uicontrols:CollectionPageHeader Grid.Row="0" Margin="{StaticResource CollectionPageHeaderMargin}"
                                         ViewModel="{x:Bind ViewModel}"
                                         Title="{x:Bind resources:Strings.GenrePage_Title}"
                                         SearchPlaceholder="{x:Bind resources:Strings.GenrePage_SearchBox_Placeholder}"
                                         SearchToolTip="{x:Bind resources:Strings.GenrePage_SearchButton_Search_ToolTip}" />

        <Grid Grid.Row="1">
            <GridView x:Name="CollectionGrid" Style="{StaticResource CollectionGridViewStyle}"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid ItemHeight="{StaticResource GenreGridItemHeight}" ItemWidth="{StaticResource GenreGridItemWidth}" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="library:GenreSummary">
                        <!-- The background is bound to the genre name, producing a unique gradient for each. -->
                        <Grid Margin="{StaticResource CollectionCardMargin}" Padding="{StaticResource SurfaceContentPadding}"
                              CornerRadius="{StaticResource ArtworkCornerRadius}"
                              Background="{x:Bind Name, Converter={StaticResource GenreToGradientConverter}, Mode=OneTime}">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Text="{x:Bind resources:Strings.Generic_Play, Mode=OneTime}"
                                        Command="{Binding ViewModel.PlayGenreCommand, ElementName=Root}"
                                        CommandParameter="{x:Bind Id}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource MediaOnImageTextPrimaryBrush}"
                                    Text="{x:Bind Name, Mode=OneTime}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <uicontrols:EmptyState Glyph="&#xE8EC;"
                                   Title="{x:Bind resources:Strings.GenrePage_Empty_Title, Mode=OneTime}"
                                   Subtitle="{x:Bind resources:Strings.GenrePage_Empty_Subtitle, Mode=OneTime}"
                                   IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                                   HasLoadError="{x:Bind ViewModel.HasLoadError, Mode=OneWay}" />
        </Grid>
    </Grid>
</pages:CollectionPage>
