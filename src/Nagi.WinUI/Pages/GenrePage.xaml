<Page
    x:Class="Nagi.WinUI.Pages.GenrePage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:resources="using:Nagi.Presentation.Resources"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:data="using:Nagi.Core.Services.Data"
    xmlns:uicontrols="using:Nagi.WinUI.Controls"
    x:Name="GenrePageRoot"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PageContainerPaddingVertical}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{StaticResource CollectionPageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{x:Bind resources:Strings.GenrePage_Title, Mode=OneTime}" Style="{StaticResource PageTitleTextStyle}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <uicontrols:SearchToggle SearchTerm="{x:Bind ViewModel.SearchTerm, Mode=TwoWay}" PlaceholderText="{x:Bind resources:Strings.GenrePage_SearchBox_Placeholder, Mode=OneTime}" SearchToolTip="{x:Bind resources:Strings.GenrePage_SearchButton_Search_ToolTip, Mode=OneTime}" />

                <uicontrols:SortButton Selection="{x:Bind ViewModel.Sort}" />

                <Button
                        ToolTipService.ToolTip="{x:Bind resources:Strings.Generic_PickRandom, Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind resources:Strings.Generic_PickRandom, Mode=OneTime}"
                        Style="{StaticResource SongListViewPageIconButton}"
                        Command="{x:Bind ViewModel.PlayRandomGenreCommand}"
                        Margin="0,0,1,0"
                        ContentTemplate="{StaticResource RandomPlayIconTemplate}" />

            </StackPanel>
        </Grid>

        <ProgressRing
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid Grid.Row="1"
              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <GridView uihelpers:ScrollEdgeFade.IsEnabled="True"
                IsItemClickEnabled="True"
                ItemClick="GenresGridView_ItemClick"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.HasItems, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"
                Padding="{StaticResource PageContentPadding}"
                ItemContainerStyle="{StaticResource AnimatedGridViewItemStyle}">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid ItemHeight="120" ItemWidth="240" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="data:GenreSummary">
                        <!-- The background is bound to the genre name, producing a unique gradient for each. -->
                        <Grid Margin="{StaticResource CollectionCardMargin}" Padding="{StaticResource SurfaceContentPadding}"
                              CornerRadius="{StaticResource ArtworkCornerRadius}"
                              Background="{x:Bind Name, Converter={StaticResource GenreToGradientConverter}, Mode=OneTime}">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Text="{x:Bind resources:Strings.Generic_Play, Mode=OneTime}"
                                        Command="{Binding ViewModel.PlayGenreCommand, ElementName=GenrePageRoot}"
                                        CommandParameter="{x:Bind Id}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource MediaOnImageTextPrimaryBrush}"
                                    Text="{x:Bind Name, Mode=OneTime}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <uicontrols:EmptyState Glyph="&#xE8EC;"
                                   Title="{x:Bind resources:Strings.GenrePage_Empty_Title, Mode=OneTime}"
                                   Subtitle="{x:Bind resources:Strings.GenrePage_Empty_Subtitle, Mode=OneTime}"
                                   IsShown="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                                   HasLoadError="{x:Bind ViewModel.HasLoadError, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
