<UserControl x:Class="Nagi.WinUI.Controls.CrashReportDialogContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:platform="using:Nagi.Core.Platform"
             xmlns:resources="using:Nagi.Presentation.Resources"
             mc:Ignorable="d">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   d:Text="An unexpected error occurred. We are sorry for the inconvenience."
                   Text="{x:Bind resources:Strings.CrashReport_Message, Mode=OneTime}"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="1" TextWrapping="Wrap">
            <Run Text="{x:Bind resources:Strings.CrashReport_ReportIssuePreLink, Mode=OneTime}" />
            <Hyperlink NavigateUri="{x:Bind platform:AppLinks.Issues}">
                <Run Text="{x:Bind resources:Strings.CrashReport_IssueLink, Mode=OneTime}" />
            </Hyperlink>
            <Run Text="{x:Bind resources:Strings.CrashReport_ReportIssuePostLink, Mode=OneTime}" />
        </TextBlock>

        <TextBlock Grid.Row="2"
                   FontSize="{StaticResource CaptionTextBlockFontSize}"
                   Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                   TextWrapping="Wrap">
            <Run Text="{x:Bind resources:Strings.CrashReport_ResetAppAdvice, Mode=OneTime}" />
        </TextBlock>

        <Border Grid.Row="3"
                MinHeight="200"
                MaxHeight="400"
                BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
            <TextBox d:Text="System.NullReferenceException: Object reference not set to an instance of an object..."
                     AcceptsReturn="True"
                     AutomationProperties.Name="{x:Bind resources:Strings.CrashReport_Log_Name, Mode=OneTime}"
                     Background="Transparent"
                     BorderThickness="0"
                     FontFamily="Consolas, Cascadia Mono, Courier New"
                     IsReadOnly="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Text="{x:Bind LogContent, Mode=OneTime}"
                     TextWrapping="NoWrap" />
        </Border>

        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button AutomationProperties.Name="{x:Bind resources:Strings.CrashReport_CopyLogButton_ToolTip, Mode=OneTime}"
                    Click="CopyButton_Click"
                    ToolTipService.ToolTip="{x:Bind resources:Strings.CrashReport_CopyLogButton_ToolTip, Mode=OneTime}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                    <TextBlock Text="{x:Bind resources:Strings.CrashReport_CopyLogLabel, Mode=OneTime}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
