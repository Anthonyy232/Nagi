<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Nagi.WinUI.Controls.SongListPlayButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:resources="using:Nagi.Presentation.Resources">

    <StackPanel Orientation="Horizontal" Spacing="8">
        <Button AutomationProperties.Name="{x:Bind resources:Strings.SongList_PlayAll, Mode=OneTime}"
                Command="{x:Bind ViewModel.PlayAllSongsCommand, Mode=OneWay}"
                Style="{StaticResource SongListViewPageIconButton}"
                ToolTipService.ToolTip="{x:Bind resources:Strings.SongList_PlayAll, Mode=OneTime}">
            <FontIcon FontSize="16" Glyph="&#xE768;" />
        </Button>

        <SplitButton AutomationProperties.Name="{x:Bind resources:Strings.SongList_ShuffleAll, Mode=OneTime}"
                     Command="{x:Bind ViewModel.ShuffleAndPlayAllSongsCommand, Mode=OneWay}"
                     Style="{StaticResource SongListViewPageShuffleButton}"
                     ToolTipService.ToolTip="{x:Bind resources:Strings.SongList_ShuffleAll, Mode=OneTime}">
            <SplitButton.Flyout>
                <MenuFlyout Opening="MixMenu_Opening" />
            </SplitButton.Flyout>
            <FontIcon FontSize="16" Glyph="&#xE8B1;" />
        </SplitButton>
    </StackPanel>
</UserControl>
