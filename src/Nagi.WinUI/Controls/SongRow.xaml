<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Nagi.WinUI.Controls.SongRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ImageEx"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Nagi.WinUI.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:resources="using:Nagi.Presentation.Resources"
             mc:Ignorable="d">

    <!--
        Margins instead of ColumnSpacing so hidden columns leave no gap. The plain text columns are
        added in code, so the list header can reuse this layout.
    -->
    <Grid x:Name="RowGrid"
          Height="54"
          Padding="0,0,12,0"
          Background="Transparent">
        <Grid.ContextFlyout>
            <MenuFlyout Opening="SongMenu_Opening">
                <MenuFlyoutItem Command="{x:Bind ViewModel.PlaySelectedSongsCommand, Mode=OneWay}" Text="{x:Bind resources:Strings.Generic_Play}" />
                <MenuFlyoutItem Command="{x:Bind ViewModel.PlaySelectedSongsNextCommand, Mode=OneWay}" Text="{x:Bind resources:Strings.SongList_Context_PlayNext}" />
                <MenuFlyoutItem Command="{x:Bind ViewModel.AddSelectedSongsToQueueCommand, Mode=OneWay}" Text="{x:Bind resources:Strings.SongList_Context_AddToQueue}" />
                <MenuFlyoutItem x:Name="FavoriteItem" Command="{x:Bind ViewModel.ToggleSelectedFavoriteCommand, Mode=OneWay}" />
                <MenuFlyoutSubItem x:Name="FavoritesSubMenu" Text="{x:Bind resources:Strings.Listening_Favorites}">
                    <MenuFlyoutItem Command="{x:Bind ViewModel.SetSelectedFavoritesCommand, Mode=OneWay}" Text="{x:Bind resources:Strings.Listening_AddFavorite}">
                        <MenuFlyoutItem.CommandParameter>
                            <x:Boolean>True</x:Boolean>
                        </MenuFlyoutItem.CommandParameter>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Command="{x:Bind ViewModel.SetSelectedFavoritesCommand, Mode=OneWay}" Text="{x:Bind resources:Strings.Listening_RemoveFavorite}">
                        <MenuFlyoutItem.CommandParameter>
                            <x:Boolean>False</x:Boolean>
                        </MenuFlyoutItem.CommandParameter>
                    </MenuFlyoutItem>
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem x:Name="AddToPlaylistSubMenu" Text="{x:Bind resources:Strings.SongList_Context_AddToPlaylist}" />
                <MenuFlyoutSeparator x:Name="SingleSongSeparator" />
                <MenuFlyoutItem x:Name="GoToAlbumItem"
                                Command="{x:Bind ViewModel.GoToAlbumCommand, Mode=OneWay}"
                                CommandParameter="{x:Bind Song, Mode=OneWay}"
                                Text="{x:Bind resources:Strings.SongList_Context_GoToAlbum}" />
                <MenuFlyoutSubItem x:Name="GoToArtistSubMenu" Text="{x:Bind resources:Strings.SongList_Context_GoToArtist}" />
                <MenuFlyoutItem x:Name="ShowInExplorerItem"
                                Command="{x:Bind ViewModel.ShowInFolderCommand, Mode=OneWay}"
                                CommandParameter="{x:Bind Song, Mode=OneWay}"
                                Text="{x:Bind resources:Strings.SongList_Context_ShowInExplorer}" />
                <MenuFlyoutItem x:Name="SongInfoItem"
                                Command="{x:Bind ViewModel.ShowSongInfoCommand, Mode=OneWay}"
                                CommandParameter="{x:Bind Song, Mode=OneWay}"
                                Text="{x:Bind resources:Strings.SongList_Context_SongInfo}" />
                <MenuFlyoutSeparator x:Name="RemoveFromPlaylistSeparator" />
                <MenuFlyoutItem x:Name="RemoveFromPlaylistItem"
                                Command="{x:Bind ViewModel.RemoveSelectionCommand, Mode=OneWay}"
                                Text="{x:Bind resources:Strings.SongList_Context_RemoveFromPlaylist}" />
            </MenuFlyout>
        </Grid.ContextFlyout>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="TitleColumn" Width="*" />
            <ColumnDefinition x:Name="ArtistColumn"
                              Width="*"
                              MinWidth="112" />
            <ColumnDefinition x:Name="AlbumColumn"
                              Width="*"
                              MinWidth="112" />
        </Grid.ColumnDefinitions>

        <Button x:Name="PlayButton"
                Grid.Column="0"
                AutomationProperties.Name="{x:Bind resources:Strings.Generic_Play}"
                Command="{x:Bind ViewModel.PlaySongCommand, Mode=OneWay}"
                CommandParameter="{x:Bind Song, Mode=OneWay}"
                Style="{StaticResource SongListViewPageSongPlayButtonStyle}"
                ToolTipService.ToolTip="{x:Bind resources:Strings.Generic_Play}">
            <Border Width="42"
                    Height="42"
                    CornerRadius="{StaticResource ArtworkCornerRadius}"
                    Visibility="{x:Bind Song.AlbumArtUriFromTrack, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                <controls:ImageEx Width="42"
                                  Height="42"
                                  DecodePixelType="Logical"
                                  DecodePixelWidth="48"
                                  Source="{x:Bind Song.AlbumArtUriFromTrack, Mode=OneWay}"
                                  Stretch="UniformToFill" />
            </Border>
        </Button>
        <local:NowPlayingIndicator x:Name="NowPlayingIndicator"
                                   Grid.Column="0"
                                   Width="42"
                                   Height="42"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

        <TextBlock x:Name="SongTitle"
                   Grid.Column="2"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center"
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   Text="{x:Bind Song.Title, Mode=OneWay}"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap" />

        <local:ArtistLinks x:Name="ArtistCell"
                           Grid.Column="3"
                           Margin="12,0,0,0"
                           ArtistName="{x:Bind Song.ArtistName, Mode=OneWay}"
                           Command="{x:Bind ViewModel.GoToArtistCommand, Mode=OneWay}"
                           Song="{x:Bind Song, Mode=OneWay}"
                           Style="{StaticResource SongListArtistLinksStyle}" />

        <HyperlinkButton x:Name="AlbumLink"
                         Grid.Column="4"
                         Margin="12,0,0,0"
                         Command="{x:Bind ViewModel.GoToAlbumCommand, Mode=OneWay}"
                         CommandParameter="{x:Bind Song, Mode=OneWay}"
                         Content="{x:Bind Song.Album.Title, Mode=OneWay}"
                         Style="{StaticResource SongListHyperlinkButtonStyle}" />
    </Grid>
</UserControl>
