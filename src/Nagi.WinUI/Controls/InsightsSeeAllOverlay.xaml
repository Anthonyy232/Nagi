<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Nagi.WinUI.Controls.InsightsSeeAllOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Nagi.WinUI.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:resources="using:Nagi.Presentation.Resources"
             xmlns:uihelpers="using:Nagi.WinUI.Helpers"
             Visibility="{x:Bind ViewModel.IsOpen, Mode=OneWay}"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="3"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Opacity="0.85"
              Tapped="OnBackdropTapped" />

        <Grid Grid.Column="1"
              Margin="0,156,0,156"
              VerticalAlignment="Stretch"
              Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="{ThemeResource OverlayCornerRadius}"
              Tapped="OnPanelTapped">

            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource OverlayCornerRadius}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="{StaticResource SurfaceContentPadding}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Margin="0"
                               VerticalAlignment="Center"
                               Style="{StaticResource InsightsCardHeaderStyle}"
                               Text="{x:Bind ViewModel.Category.Title, Mode=OneWay}" />

                    <local:SearchToggle Grid.Column="1"
                                        Margin="0,0,8,0"
                                        PlaceholderText="{x:Bind resources:Strings.InsightsPage_SeeAll_SearchBox_Placeholder, Mode=OneTime}"
                                        SearchTerm="{x:Bind ViewModel.SearchTerm, Mode=TwoWay}"
                                        SearchToolTip="{x:Bind resources:Strings.InsightsPage_SeeAll_SearchButton_ToolTip, Mode=OneTime}" />

                    <local:SortButton Grid.Column="2"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      Selection="{x:Bind ViewModel.Category.Sort, Mode=OneWay}" />

                    <Button Grid.Column="3"
                            Width="32"
                            Height="32"
                            Padding="0"
                            AutomationProperties.Name="{x:Bind resources:Strings.Generic_Close, Mode=OneTime}"
                            Command="{x:Bind ViewModel.CloseCommand}"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind resources:Strings.Generic_Close, Mode=OneTime}">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <ProgressRing Width="40"
                                  Height="40"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

                    <ListView Padding="16,0,16,8"
                              uihelpers:ScrollEdgeFade.IsEnabled="True"
                              ItemContainerStyle="{StaticResource SeeAllListItemStyle}"
                              ItemTemplateSelector="{StaticResource InsightsItemTemplateSelector}"
                              ItemsSource="{x:Bind ViewModel.Items}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectionMode="None"
                              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </Grid>

                <local:PaginationControl Grid.Row="2"
                                         Margin="16,8,16,16"
                                         HorizontalAlignment="Right"
                                         ViewModel="{x:Bind ViewModel}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
