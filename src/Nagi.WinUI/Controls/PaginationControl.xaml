<UserControl x:Class="Nagi.WinUI.Controls.PaginationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Nagi.WinUI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:resources="using:Nagi.Presentation.Resources"
             Margin="0,16,24,16"
             HorizontalAlignment="Right"
             mc:Ignorable="d">

    <StackPanel VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind ViewModel.CanPaginate, Mode=OneWay}">
        <TextBlock VerticalAlignment="Center"
                   FontSize="{StaticResource CaptionTextBlockFontSize}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind resources:Strings.PaginationControl_ItemsPerPage, Mode=OneTime}" />

        <controls:PageSizeComboBox MinWidth="80"
                                   Margin="0,0,16,0"
                                   DisplayMemberPath="DisplayName"
                                   FontSize="{StaticResource CaptionTextBlockFontSize}"
                                   ItemsSource="{x:Bind ViewModel.PageSize.Options, Mode=OneWay}"
                                   SelectedItem="{x:Bind ViewModel.PageSize.Selected, Mode=TwoWay}"
                                   Style="{StaticResource DefaultComboBoxStyle}" />

        <Button Width="32"
                Height="32"
                Padding="0"
                AutomationProperties.Name="{x:Bind resources:Strings.PaginationControl_PreviousPage_ToolTip, Mode=OneTime}"
                Command="{x:Bind ViewModel.PreviousPageCommand, Mode=OneWay}"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="{x:Bind resources:Strings.PaginationControl_PreviousPage_ToolTip, Mode=OneTime}">
            <FontIcon FontSize="12" Glyph="&#xE76B;" />
        </Button>

        <TextBlock Margin="4,0"
                   VerticalAlignment="Center"
                   FontSize="{StaticResource CaptionTextBlockFontSize}">
            <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.CurrentPage, Mode=OneWay}" />
            <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text=" / " />
            <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.TotalPages, Mode=OneWay}" />
        </TextBlock>

        <Button Width="32"
                Height="32"
                Padding="0"
                AutomationProperties.Name="{x:Bind resources:Strings.PaginationControl_NextPage_ToolTip, Mode=OneTime}"
                Command="{x:Bind ViewModel.NextPageCommand, Mode=OneWay}"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="{x:Bind resources:Strings.PaginationControl_NextPage_ToolTip, Mode=OneTime}">
            <FontIcon FontSize="12" Glyph="&#xE76C;" />
        </Button>
    </StackPanel>
</UserControl>
