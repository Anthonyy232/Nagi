<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Nagi.WinUI.Controls.SearchToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <TextBox x:Name="SearchTextBox"
                 Width="0"
                 HorizontalAlignment="Right"
                 Canvas.ZIndex="0"
                 IsHitTestVisible="False"
                 IsTabStop="False"
                 KeyDown="SearchTextBox_KeyDown"
                 Opacity="0"
                 PlaceholderText="{x:Bind PlaceholderText, Mode=OneWay}"
                 Style="{StaticResource SearchTextBoxStyle}"
                 TextChanged="SearchTextBox_TextChanged">
            <TextBox.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15" />
            </TextBox.OpacityTransition>
        </TextBox>
        <Button x:Name="SearchToggleButton"
                HorizontalAlignment="Right"
                Canvas.ZIndex="1"
                Click="SearchToggleButton_Click"
                Style="{StaticResource SongListViewPageIconButton}">
            <FontIcon x:Name="SearchIcon"
                      FontSize="16"
                      Glyph="&#xE721;" />
        </Button>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SearchStates">
                <VisualState x:Name="SearchCollapsed">
                    <VisualState.Setters>
                        <Setter Target="SearchTextBox.Width" Value="0" />
                        <Setter Target="SearchTextBox.Opacity" Value="0" />
                        <Setter Target="SearchTextBox.IsHitTestVisible" Value="False" />
                        <Setter Target="SearchTextBox.IsTabStop" Value="False" />
                        <Setter Target="SearchIcon.Glyph" Value="&#xE721;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SearchExpanded">
                    <VisualState.Setters>
                        <Setter Target="SearchTextBox.Width" Value="{StaticResource SearchBoxExpandedWidth}" />
                        <Setter Target="SearchTextBox.Opacity" Value="1" />
                        <Setter Target="SearchTextBox.IsHitTestVisible" Value="True" />
                        <Setter Target="SearchTextBox.IsTabStop" Value="True" />
                        <Setter Target="SearchIcon.Glyph" Value="&#xE711;" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
