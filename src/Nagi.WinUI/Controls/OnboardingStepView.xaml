<UserControl
    x:Class="Nagi.WinUI.Controls.OnboardingStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="LayoutRoot" MaxWidth="1120">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TextColumn" Width="*" />
            <ColumnDefinition x:Name="BodyColumn" Width="0" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Stacked" />
                <VisualState x:Name="SideBySide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.ColumnSpacing" Value="80" />
                        <Setter Target="TextColumn.Width" Value="5*" />
                        <Setter Target="BodyColumn.Width" Value="6*" />
                        <Setter Target="TextPanel.VerticalAlignment" Value="Center" />
                        <Setter Target="BodyPresenter.(Grid.Row)" Value="0" />
                        <Setter Target="BodyPresenter.(Grid.Column)" Value="1" />
                        <Setter Target="BodyPresenter.Margin" Value="0" />
                        <Setter Target="BodyPresenter.VerticalAlignment" Value="Center" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel x:Name="TextPanel" Spacing="12">
            <TextBlock
                x:Name="TitleText"
                AutomationProperties.HeadingLevel="Level1"
                FontSize="40"
                Foreground="{ThemeResource AppPrimaryColorBrush}"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind Title, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                x:Name="DescriptionText"
                MaxWidth="480"
                HorizontalAlignment="Left"
                FontSize="18"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                LineHeight="28"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind Description, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <ContentPresenter
            x:Name="BodyPresenter"
            Grid.Row="1"
            Margin="0,32,0,0"
            HorizontalContentAlignment="Stretch"
            Content="{x:Bind Body, Mode=OneWay}" />
    </Grid>
</UserControl>
