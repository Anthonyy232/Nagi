<UserControl x:Class="Nagi.WinUI.Controls.CollectionPageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Nagi.WinUI.Controls"
             xmlns:resources="using:Nagi.Presentation.Resources">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind Title, Mode=OneWay}" />
            <!--  Sits on the title's baseline rather than its middle.  -->
            <TextBlock Margin="0,0,0,5"
                       VerticalAlignment="Bottom"
                       FontSize="{StaticResource CompactTextFontSize}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind CountText, Mode=OneWay}" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
            <local:SearchToggle PlaceholderText="{x:Bind SearchPlaceholder, Mode=OneWay}"
                                SearchTerm="{x:Bind ViewModel.SearchTerm, Mode=TwoWay}"
                                SearchToolTip="{x:Bind SearchToolTip, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.Sort, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}" />

            <local:SortButton Selection="{x:Bind ViewModel.Sort, Mode=OneWay}" Visibility="{x:Bind ViewModel.Sort, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}" />

            <Button AutomationProperties.Name="{x:Bind resources:Strings.Generic_PickRandom}"
                    Command="{x:Bind ViewModel.PlayRandomCommand, Mode=OneWay}"
                    ContentTemplate="{StaticResource RandomPlayIconTemplate}"
                    Style="{StaticResource SongListViewPageIconButton}"
                    ToolTipService.ToolTip="{x:Bind resources:Strings.Generic_PickRandom}" />

            <ContentPresenter Content="{x:Bind ExtraContent, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
