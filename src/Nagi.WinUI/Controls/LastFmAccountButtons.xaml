<UserControl
    x:Class="Nagi.WinUI.Controls.LastFmAccountButtons"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="using:Nagi.Presentation.Resources">

    <StackPanel Orientation="Horizontal" Spacing="8">
        <Button
            Command="{x:Bind ViewModel.LastFmInitialAuthCommand, Mode=OneWay}"
            Content="{x:Bind resources:Strings.SettingsPage_LastFm_Connect_Content, Mode=OneTime}"
            Visibility="{x:Bind ViewModel.IsLastFmNotConnected, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.IsLastFmInitialAuthEnabled, Mode=OneWay}" />

        <!-- Last.fm authorizes in the browser, so the user confirms here once they have approved Nagi. -->
        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsConnectingToLastFm, Mode=OneWay}">
            <Button
                Command="{x:Bind ViewModel.LastFmFinalizeAuthCommand, Mode=OneWay}"
                Content="{x:Bind resources:Strings.SettingsPage_LastFm_Complete_Content, Mode=OneTime}"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                Command="{x:Bind ViewModel.CancelLastFmAuthCommand, Mode=OneWay}"
                Content="{x:Bind resources:Strings.SettingsPage_LastFm_Cancel_Content, Mode=OneTime}" />
        </StackPanel>

        <Button
            Command="{x:Bind ViewModel.LastFmDisconnectCommand, Mode=OneWay}"
            Content="{x:Bind resources:Strings.SettingsPage_LastFm_Disconnect_Content, Mode=OneTime}"
            Visibility="{x:Bind ViewModel.IsLastFmConnected, Mode=OneWay}" />
    </StackPanel>
</UserControl>
