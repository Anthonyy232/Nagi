<UserControl
    x:Class="Nagi.WinUI.Controls.MiniPlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:models="using:Nagi.Core.Models"
    xmlns:viewmodels="using:Nagi.Presentation.ViewModels"
    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
    xmlns:resources="using:Nagi.Presentation.Resources"
    d:DataContext="{d:DesignInstance Type=viewmodels:PlayerViewModel, IsDesignTimeCreatable=True}"
    mc:Ignorable="d">

    <!--  The root grid handles pointer enter/exit events to show or hide the controls.  -->
    <Grid x:Name="HoverDetector" Background="Transparent">

        <!--  Blends album art with the theme colors  -->
        <Border x:Name="AmbientBackground" Opacity="1.0">
            <Border.Background>
                <media:ImageBlendBrush
                    Mode="Multiply"
                    Source="{x:Bind ViewModel.AlbumArtUri, Mode=OneWay, Converter={StaticResource StringToDecodedImageSourceConverter}, ConverterParameter=400}"
                    Stretch="UniformToFill" />
            </Border.Background>
        </Border>

        <!--  A faint theme-colored overlay for readability that still lets the acrylic backdrop show through  -->
        <Border Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}" Opacity="0.15" />

        <Border x:Name="DragHandle" Background="Transparent" />

        <Grid x:Name="HoverControlsContainer" Opacity="0">
            <Grid.Resources>
                <StaticResource x:Key="SliderThumbBackground" ResourceKey="MediaOnImageAccentBrush" />
                <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="MediaOnImageAccentBrush" />
                <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="MediaOnImageAccentBrush" />
                <StaticResource x:Key="SliderTrackValueFill" ResourceKey="MediaOnImageAccentBrush" />
                <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="MediaOnImageAccentBrush" />
                <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="MediaOnImageAccentBrush" />
                <StaticResource x:Key="SliderTrackFill" ResourceKey="MediaOnImageControlTrackBrush" />
                <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="MediaOnImageControlTrackBrush" />
                <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="MediaOnImageControlTrackBrush" />
                <Style TargetType="Button" BasedOn="{StaticResource MediaOnImageControlButtonStyle}" />
                <Style TargetType="Slider" BasedOn="{StaticResource MediaOnImageSeekerSliderStyle}" />
            </Grid.Resources>

            <!--  Overlay for control readability  -->
            <Border Background="{StaticResource MediaOnImageControlsScrimBrush}" IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,16,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="BackButton"
                        Grid.Column="0"
                        ToolTipService.ToolTip="{x:Bind resources:Strings.MiniPlayer_BackButton_ToolTip, Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind resources:Strings.MiniPlayer_BackButton_ToolTip, Mode=OneTime}"
                        Command="{x:Bind ViewModel.ShowPlayerViewCommand}"
                        Visibility="{x:Bind ViewModel.IsQueueViewVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="" />
                    </Button>

                    <StackPanel
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="44,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="2"
                        Visibility="{x:Bind ViewModel.IsQueueViewVisible, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource MediaOnImageTextPrimaryBrush}"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.SongTitle, Mode=OneWay}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <Grid HorizontalAlignment="Center">
                            <TextBlock
                                x:Name="ArtistTextBlock"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource MediaOnImageTextSecondaryBrush}"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                uihelpers:MultiArtistHyperlinkHelper.ArtistName="{x:Bind ViewModel.ArtistName, Mode=OneWay}"
                                uihelpers:MultiArtistHyperlinkHelper.Song="{x:Bind ViewModel.CurrentPlayingTrack, Mode=OneWay}"
                                uihelpers:MultiArtistHyperlinkHelper.Command="{x:Bind ViewModel.GoToArtistCommand, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>

                    <TextBlock
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Text="{x:Bind resources:Strings.MiniPlayer_UpNextHeader, Mode=OneTime}"
                        Margin="44,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource MediaOnImageTextPrimaryBrush}"
                        Visibility="{x:Bind ViewModel.IsQueueViewVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Button
                        x:Name="RestoreButton"
                        Grid.Column="2"
                        ToolTipService.ToolTip="{x:Bind resources:Strings.MiniPlayer_RestoreButton_ToolTip, Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind resources:Strings.MiniPlayer_RestoreButton_ToolTip, Mode=OneTime}">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="20" Glyph="" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid Padding="16,0,16,16"
                          Visibility="{x:Bind ViewModel.IsQueueViewVisible, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <StackPanel VerticalAlignment="Bottom" Spacing="12">
                            <Slider
                                x:Name="MediaSeekerSlider"
                                AutomationProperties.Name="{x:Bind resources:Strings.Player_SeekSlider_Name, Mode=OneTime}"
                                Margin="4,0"
                                IsThumbToolTipEnabled="True"
                                Maximum="{x:Bind ViewModel.TotalDuration, Mode=OneWay, Converter={StaticResource SliderMaximumConverter}}"
                                ThumbToolTipValueConverter="{StaticResource TimeSpanToTimeStringConverter}"
                                Value="{x:Bind ViewModel.CurrentPosition, Mode=TwoWay}" />

                            <StackPanel x:Name="MediaControlsPanel" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="2">

                                <Button Command="{x:Bind ViewModel.ToggleShuffleCommand}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.ShuffleButtonToolTip, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind ViewModel.ShuffleButtonToolTip, Mode=OneWay}">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              Glyph="{x:Bind uihelpers:AppIconGlyphs.ToGlyph(ViewModel.ShuffleIcon)}"
                                              Opacity="{x:Bind ViewModel.IsShuffleEnabled, Mode=OneWay, Converter={StaticResource ToggleIconOpacityConverter}}" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.PreviousCommand}"
                                        ToolTipService.ToolTip="{x:Bind resources:Strings.MiniPlayer_PreviousButton_ToolTip, Mode=OneTime}"
                                        AutomationProperties.Name="{x:Bind resources:Strings.MiniPlayer_PreviousButton_ToolTip, Mode=OneTime}">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.PlayPauseCommand}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.PlayPauseButtonToolTip, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind ViewModel.PlayPauseButtonToolTip, Mode=OneWay}">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="24"
                                              Glyph="{x:Bind uihelpers:AppIconGlyphs.ToGlyph(ViewModel.PlayPauseIcon), Mode=OneWay}" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.NextCommand}"
                                        ToolTipService.ToolTip="{x:Bind resources:Strings.MiniPlayer_NextButton_ToolTip, Mode=OneTime}"
                                        AutomationProperties.Name="{x:Bind resources:Strings.MiniPlayer_NextButton_ToolTip, Mode=OneTime}">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.CycleRepeatCommand}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.RepeatButtonToolTip, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind ViewModel.RepeatButtonToolTip, Mode=OneWay}">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              Glyph="{x:Bind uihelpers:AppIconGlyphs.ToGlyph(ViewModel.RepeatIcon), Mode=OneWay}" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.ShowQueueViewCommand}"
                                        ToolTipService.ToolTip="{x:Bind resources:Strings.MiniPlayer_QueueButton_ToolTip, Mode=OneTime}"
                                        AutomationProperties.Name="{x:Bind resources:Strings.MiniPlayer_QueueButton_ToolTip, Mode=OneTime}">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.ToggleMuteCommand}"
                                        PointerWheelChanged="VolumeButton_PointerWheelChanged"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.VolumeButtonToolTip, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind ViewModel.VolumeButtonToolTip, Mode=OneWay}">
                                    <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  FontSize="20"
                                                  Foreground="{StaticResource MediaOnImageControlSecondaryBrush}"
                                                  Glyph="{x:Bind uihelpers:AppIconGlyphs.ToGlyph(ViewModel.VolumeIcon), Mode=OneWay}" />
                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  FontSize="20"
                                                  Foreground="{StaticResource MediaOnImageAccentBrush}"
                                                  Clip="{x:Bind ViewModel.CurrentVolume, Mode=OneWay, Converter={StaticResource VolumeToClipRectConverter}, ConverterParameter='20'}"
                                                  Glyph="{x:Bind uihelpers:AppIconGlyphs.ToGlyph(ViewModel.VolumeIcon), Mode=OneWay}" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <ListView
                        uihelpers:ScrollEdgeFade.IsEnabled="True"
                        x:Name="QueueListView"
                        Padding="16,12,16,16"
                        ItemContainerStyle="{StaticResource PaddedListViewItemStyle}"
                        ItemsSource="{x:Bind ViewModel.CurrentQueue}"
                        SelectionMode="None"
                        VirtualizingStackPanel.VirtualizationMode="Recycling"
                        Visibility="{x:Bind ViewModel.IsQueueViewVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Song">
                                <StackPanel>
                                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}"
                                               Foreground="{StaticResource MediaOnImageTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                    <TextBlock
                                        FontSize="11"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{StaticResource MediaOnImageControlSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        uihelpers:MultiArtistHyperlinkHelper.ArtistName="{x:Bind ArtistName}"
                                        uihelpers:MultiArtistHyperlinkHelper.Song="{x:Bind}"
                                        uihelpers:MultiArtistHyperlinkHelper.Command="{Binding DataContext.ViewModel.GoToArtistCommand, ElementName=HoverDetector}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
