<UserControl
    x:Class="Nagi.WinUI.Controls.OnboardingLibraryPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="using:Nagi.Presentation.Resources">

    <StackPanel Spacing="16">
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasLibraryFailed, Mode=OneWay}"
            Message="{x:Bind ViewModel.ScanStatus, Mode=OneWay}"
            Severity="Error" />

        <StackPanel
            Spacing="24"
            Visibility="{x:Bind ViewModel.HasLibraryFolder, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <FontIcon
                FontSize="96"
                Foreground="{ThemeResource AppPrimaryColorBrush}"
                Glyph="&#xE8B7;" />
            <Button
                Padding="24,12"
                HorizontalAlignment="Center"
                AutomationProperties.Name="{x:Bind resources:Strings.OnboardingPage_AddFolderButton_Content, Mode=OneTime}"
                Command="{x:Bind ViewModel.ChooseFolderCommand, Mode=OneWay}"
                Style="{StaticResource AnimatedAccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon FontSize="16" Glyph="&#xE8F4;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{x:Bind resources:Strings.OnboardingPage_AddFolderButton_Content, Mode=OneTime}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            ColumnSpacing="16"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            RowSpacing="4"
            Visibility="{x:Bind ViewModel.HasLibraryFolder, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <FontIcon
                Grid.RowSpan="3"
                VerticalAlignment="Center"
                FontSize="24"
                Foreground="{ThemeResource AppPrimaryColorBrush}"
                Glyph="&#xE8B7;"
                Visibility="{x:Bind ViewModel.IsLibraryReady, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
            <FontIcon
                Grid.RowSpan="3"
                VerticalAlignment="Center"
                FontSize="24"
                Foreground="{ThemeResource AppPrimaryColorBrush}"
                Glyph="&#xE930;"
                Visibility="{x:Bind ViewModel.IsLibraryReady, Mode=OneWay}" />

            <TextBlock
                Grid.Column="1"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.FolderPath, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind ViewModel.FolderPath, Mode=OneWay}" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.ScanStatus, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />
            <ProgressBar
                Grid.Row="2"
                Grid.Column="1"
                Margin="0,8,0,0"
                IsIndeterminate="{x:Bind ViewModel.IsScanProgressIndeterminate, Mode=OneWay}"
                Maximum="100"
                Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                Value="{x:Bind ViewModel.ScanPercentage, Mode=OneWay}" />
        </Grid>
    </StackPanel>
</UserControl>
