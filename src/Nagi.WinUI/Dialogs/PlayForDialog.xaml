<ContentDialog x:Class="Nagi.WinUI.Dialogs.PlayForDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:core="using:Nagi.Core.Playback"
               xmlns:resources="using:Nagi.Presentation.Resources"
               Title="{x:Bind resources:Strings.Listening_PlayFor}"
               CloseButtonText="{x:Bind resources:Strings.Generic_Cancel}"
               DefaultButton="Primary"
               IsPrimaryButtonEnabled="{x:Bind ViewModel.CanAccept, Mode=OneWay}"
               PrimaryButtonText="{x:Bind resources:Strings.Generic_Play}"
               Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Spacing="12">
        <TextBlock MaxWidth="360"
                   Text="{x:Bind resources:Strings.Listening_PlayForDescription}"
                   TextWrapping="Wrap" />
        <NumberBox Header="{x:Bind resources:Strings.Listening_Minutes}"
                   Maximum="{x:Bind core:PlaybackLimits.MaxScheduledMinutes}"
                   Minimum="1"
                   SpinButtonPlacementMode="Inline"
                   Value="{x:Bind ViewModel.Minutes, Mode=TwoWay}" />
        <ComboBox HorizontalAlignment="Stretch"
                  DisplayMemberPath="DisplayName"
                  Header="{x:Bind resources:Strings.Listening_ShuffleMode}"
                  ItemsSource="{x:Bind ViewModel.ModeOptions}"
                  SelectedItem="{x:Bind ViewModel.SelectedMode, Mode=TwoWay}" />
        <TextBlock MaxWidth="360"
                   Text="{x:Bind ViewModel.ModeDescription, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind ViewModel.ModeDescription, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
        <Expander HorizontalAlignment="Stretch"
                  Header="{x:Bind resources:Strings.Listening_MoreOptions}"
                  Visibility="{x:Bind ViewModel.ShowsAvoidRecentDays, Mode=OneWay}">
            <NumberBox Header="{x:Bind resources:Strings.Listening_AvoidRecentDays}"
                       Maximum="{x:Bind core:PlaybackLimits.MaxAvoidRecentDays}"
                       Minimum="0"
                       SpinButtonPlacementMode="Inline"
                       Value="{x:Bind ViewModel.AvoidRecentDays, Mode=TwoWay}" />
        </Expander>
    </StackPanel>
</ContentDialog>
