<ContentDialog x:Class="Nagi.WinUI.Dialogs.SmartPlaylistEditorDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:playlists="using:Nagi.Presentation.Playlists"
               xmlns:resources="using:Nagi.Presentation.Resources"
               xmlns:uicontrols="using:Nagi.WinUI.Controls"
               xmlns:uihelpers="using:Nagi.WinUI.Helpers"
               Title="{x:Bind ViewModel.Title, Mode=OneWay}"
               CloseButtonText="{x:Bind resources:Strings.Generic_Cancel, Mode=OneTime}"
               DefaultButton="Primary"
               FullSizeDesired="True"
               PrimaryButtonClick="OnPrimaryButtonClick"
               PrimaryButtonText="{x:Bind resources:Strings.SmartPlaylist_Dialog_PrimaryButton, Mode=OneTime}"
               Style="{StaticResource DefaultContentDialogStyle}"
               mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1400</x:Double>

        <Style x:Key="RuleRowStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="{StaticResource CompactSurfaceContentPadding}" />
        </Style>
    </ContentDialog.Resources>

    <Grid Margin="0,12,0,0"
          ColumnDefinitions="*"
          RowDefinitions="Auto,Auto,*,Auto">

        <Grid Grid.Row="0"
              Margin="0,0,0,24"
              ColumnDefinitions="Auto, 24, *, 24, Auto">
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Top"
                        Spacing="8">
                <uicontrols:ArtworkImage PlaceholderGlyph="&#xE91B;"
                                         PlaceholderGlyphSize="40"
                                         Size="100"
                                         Source="{x:Bind ViewModel.CoverPreviewUri, Mode=OneWay}" />
                <Button HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.PickCoverImageCommand}"
                        Content="{x:Bind resources:Strings.SmartPlaylist_PickCoverButton_Content, Mode=OneTime}"
                        ToolTipService.ToolTip="{x:Bind resources:Strings.SmartPlaylist_PickCoverButton_ToolTip, Mode=OneTime}" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        VerticalAlignment="Top"
                        Spacing="4">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind resources:Strings.SmartPlaylist_PlaylistNameLabel, Mode=OneTime}" />
                <TextBox x:Name="PlaylistNameTextBox"
                         MaxLength="200"
                         PlaceholderText="{x:Bind resources:Strings.SmartPlaylist_PlaylistNameTextBox_Placeholder, Mode=OneTime}"
                         Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Column="4"
                        MinWidth="200"
                        VerticalAlignment="Top"
                        Spacing="4">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind resources:Strings.SmartPlaylist_SortOrderLabel, Mode=OneTime}" />
                <ComboBox HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{x:Bind resources:Strings.SmartPlaylist_SortOrderLabel, Mode=OneTime}"
                          DisplayMemberPath="Label"
                          ItemsSource="{x:Bind playlists:SmartPlaylistEditorViewModel.SortOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,0,0,12"
              ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                <TextBlock VerticalAlignment="Center" Text="{x:Bind resources:Strings.SmartPlaylist_MatchLabel, Mode=OneTime}" />
                <ComboBox MinWidth="80"
                          AutomationProperties.Name="{x:Bind resources:Strings.SmartPlaylist_MatchLabel, Mode=OneTime}"
                          SelectedIndex="{x:Bind ViewModel.MatchLogicIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind resources:Strings.SmartPlaylist_MatchLogic_All_Content, Mode=OneTime}" />
                    <ComboBoxItem Content="{x:Bind resources:Strings.SmartPlaylist_MatchLogic_Any_Content, Mode=OneTime}" />
                </ComboBox>
                <TextBlock VerticalAlignment="Center" Text="{x:Bind resources:Strings.SmartPlaylist_MatchSuffixLabel, Mode=OneTime}" />
            </StackPanel>

            <Button Grid.Column="2"
                    AutomationProperties.Name="{x:Bind resources:Strings.SmartPlaylist_AddRuleButton_ToolTip, Mode=OneTime}"
                    Command="{x:Bind ViewModel.AddRuleCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind resources:Strings.SmartPlaylist_AddRuleButton_ToolTip, Mode=OneTime}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                    <TextBlock Text="{x:Bind resources:Strings.SmartPlaylist_AddRuleLabel, Mode=OneTime}" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="2"
                Padding="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
            <Grid>
                <ScrollViewer Padding="{StaticResource SurfaceContentPadding}"
                              uihelpers:ScrollEdgeFade.IsEnabled="True"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">
                        <ListView IsItemClickEnabled="False"
                                  ItemsSource="{x:Bind ViewModel.Rules}"
                                  SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="playlists:RuleViewModel">
                                    <Border Style="{StaticResource RuleRowStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ComboBox Grid.Column="0"
                                                      HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="{x:Bind resources:Strings.SmartPlaylist_RuleField_Name, Mode=OneTime}"
                                                      DisplayMemberPath="DisplayName"
                                                      ItemsSource="{x:Bind playlists:RuleViewModel.AvailableFields}"
                                                      SelectedItem="{x:Bind SelectedField, Mode=TwoWay}" />

                                            <ComboBox Grid.Column="1"
                                                      HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="{x:Bind resources:Strings.SmartPlaylist_RuleOperator_Name, Mode=OneTime}"
                                                      DisplayMemberPath="DisplayName"
                                                      ItemsSource="{x:Bind AvailableOperators, Mode=OneWay}"
                                                      SelectedItem="{x:Bind SelectedOperator, Mode=TwoWay}" />

                                            <StackPanel Grid.Column="2"
                                                        Spacing="8"
                                                        Visibility="{x:Bind RequiresValue, Mode=OneWay}">
                                                <TextBox HorizontalAlignment="Stretch"
                                                         PlaceholderText="{x:Bind resources:Strings.SmartPlaylist_RuleValueTextBox_Placeholder, Mode=OneTime}"
                                                         Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox HorizontalAlignment="Stretch"
                                                         PlaceholderText="{x:Bind resources:Strings.SmartPlaylist_UpperBound_Placeholder, Mode=OneTime}"
                                                         Text="{x:Bind SecondValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{x:Bind IsRange, Mode=OneWay}" />
                                            </StackPanel>

                                            <Button Grid.Column="3"
                                                    AutomationProperties.Name="{x:Bind resources:Strings.SmartPlaylist_RemoveRuleButton_ToolTip, Mode=OneTime}"
                                                    Click="RemoveRule_Click"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    ToolTipService.ToolTip="{x:Bind resources:Strings.SmartPlaylist_RemoveRuleButton_ToolTip, Mode=OneTime}">
                                                <FontIcon FontSize="14"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          Glyph="&#xE738;" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Margin="0,48,0,48"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="16"
                                    Visibility="{x:Bind ViewModel.HasNoRules, Mode=OneWay}">
                            <TextBlock HorizontalAlignment="Center"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       Text="{x:Bind resources:Strings.SmartPlaylist_NoRulesTitle, Mode=OneTime}" />
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind resources:Strings.SmartPlaylist_NoRulesMessage, Mode=OneTime}" />
                            <Button HorizontalAlignment="Center"
                                    Command="{x:Bind ViewModel.AddRuleCommand}"
                                    Content="{x:Bind resources:Strings.SmartPlaylist_AddFirstRuleButton_Content, Mode=OneTime}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind resources:Strings.SmartPlaylist_AddFirstRuleButton_ToolTip, Mode=OneTime}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,16,0,0"
                Padding="12,8"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="{ThemeResource ControlCornerRadius}">
            <StackPanel HorizontalAlignment="Left"
                        Orientation="Horizontal"
                        Spacing="8">
                <FontIcon VerticalAlignment="Center"
                          FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE946;" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="{x:Bind ViewModel.MatchCountText, Mode=OneWay}" />
            </StackPanel>
        </Border>
    </Grid>
</ContentDialog>
