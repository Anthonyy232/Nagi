<ContentDialog x:Class="Nagi.WinUI.Dialogs.FFmpegSetupDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:resources="using:Nagi.Presentation.Resources"
               Title="{x:Bind resources:Strings.Settings_Dialog_FFmpegNotFound_Title}"
               CloseButtonText="{x:Bind resources:Strings.Generic_Cancel}"
               DefaultButton="Primary"
               PrimaryButtonClick="OnRecheckClick"
               PrimaryButtonText="{x:Bind resources:Strings.Generic_Recheck}"
               Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Spacing="12">
        <TextBlock Text="{x:Bind resources:Strings.FFmpeg_SetupInstructions}" TextWrapping="Wrap" />
        <!--  One status line per color, so each follows the dialog's theme.  -->
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind ViewModel.IsChecking, Mode=OneWay}" />
        <TextBlock Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind ViewModel.IsDetected, Mode=OneWay}" />
        <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind ViewModel.IsMissing, Mode=OneWay}" />
    </StackPanel>
</ContentDialog>
