<ContentDialog x:Class="Nagi.WinUI.Dialogs.PlaylistNameDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:resources="using:Nagi.Presentation.Resources"
               xmlns:uicontrols="using:Nagi.WinUI.Controls"
               Title="{x:Bind ViewModel.Title}"
               CloseButtonText="{x:Bind resources:Strings.Generic_Cancel}"
               DefaultButton="Primary"
               IsPrimaryButtonEnabled="{x:Bind ViewModel.CanAccept, Mode=OneWay}"
               PrimaryButtonText="{x:Bind ViewModel.AcceptText}"
               Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">400</x:Double>
    </ContentDialog.Resources>

    <uicontrols:FillWidthGrid>
        <StackPanel>
            <!--  A new playlist can start with a cover image; a rename only changes the name.  -->
            <uicontrols:ArtworkImage Margin="0,0,0,12"
                                     HorizontalAlignment="Center"
                                     PlaceholderGlyph="&#xE91B;"
                                     Size="80"
                                     Source="{x:Bind ViewModel.CoverImagePath, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.IsNewPlaylist}" />
            <TextBox PlaceholderText="{x:Bind resources:Strings.PlaylistPage_CreateDialog_Placeholder}" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Margin="0,12,0,0"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.PickCoverImageCommand}"
                    Content="{x:Bind resources:Strings.PlaylistPage_CreateDialog_PickImage}"
                    Visibility="{x:Bind ViewModel.IsNewPlaylist}" />
        </StackPanel>
    </uicontrols:FillWidthGrid>
</ContentDialog>
