<UserControl
    x:Class="Nagi.WinUI.MainPage"
    x:Name="MainPageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:localControls="using:Nagi.WinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="using:Nagi.WinUI.Resources"
    xmlns:imageEx="using:ImageEx"
    xmlns:uiModels="using:Nagi.WinUI.Models"
    xmlns:uihelpers="using:Nagi.WinUI.Helpers"
    mc:Ignorable="d"
    KeyboardAcceleratorPlacementMode="Hidden">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="D" Modifiers="Control" Invoked="OnListeningShortcutInvoked" />
    </UserControl.KeyboardAccelerators>
    <UserControl.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="PlayerButtonTemplate" x:DataType="uiModels:PlayerButtonSetting">
                <Button
                    Command="{x:Bind Command}"
                    Style="{StaticResource MediaControlButtonStyle}"
                    Foreground="{StaticResource PlayerAccentBrush}"
                    ToolTipService.ToolTip="{x:Bind DynamicToolTip, Mode=OneWay}">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Glyph="{x:Bind DynamicIcon, Mode=OneWay}"
                              Opacity="{x:Bind IsIconActive, Mode=OneWay, Converter={StaticResource ToggleIconOpacityConverter}}" />
                </Button>
            </DataTemplate>

            <DataTemplate x:Key="PlayPauseButtonTemplate" x:DataType="uiModels:PlayerButtonSetting">
                <Button
                    x:Name="PlayPauseButton"
                    Command="{x:Bind Command}"
                    Style="{StaticResource MediaControlButtonStyle}"
                    Foreground="{StaticResource PlayerAccentBrush}"
                    ToolTipService.ToolTip="{x:Bind DynamicToolTip, Mode=OneWay}">
                    <FontIcon
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="24"
                        Glyph="{x:Bind DynamicIcon, Mode=OneWay}" />
                </Button>
            </DataTemplate>


            <DataTemplate x:Key="LyricsButtonTemplate" x:DataType="uiModels:PlayerButtonSetting">
                <Button
                    ToolTipService.ToolTip="{x:Bind DynamicToolTip, Mode=OneTime}"
                    Style="{StaticResource MediaControlButtonStyle}"
                    Foreground="{StaticResource PlayerAccentBrush}"
                    Click="LyricsButton_Click">
                    <Grid Width="40" Height="40" Margin="-8">
                        <Border
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Visibility="{Binding DataContext.IsLyricsPageActive, ElementName=MainPageRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Glyph="{x:Bind DynamicIcon, Mode=OneWay}" />
                    </Grid>
                </Button>
            </DataTemplate>

            <DataTemplate x:Key="QueueButtonTemplate" x:DataType="uiModels:PlayerButtonSetting">
                <Button AllowDrop="True"
                        DragEnter="QueueButton_DragEnter"
                        DragOver="Queue_DragOver"
                        Drop="Queue_Drop"
                        Command="{x:Bind Command}"
                        AutomationProperties.Name="{x:Bind DynamicToolTip, Mode=OneTime}"
                        ToolTipService.ToolTip="{x:Bind DynamicToolTip, Mode=OneTime}"
                        Style="{StaticResource MediaControlButtonStyle}"
                        Foreground="{StaticResource PlayerAccentBrush}">
                    <Grid Width="40" Height="40" Margin="-8">
                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Visibility="{Binding DataContext.IsQueuePanelOpen, ElementName=MainPageRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="{x:Bind DynamicIcon, Mode=OneWay}" />
                    </Grid>
                </Button>
            </DataTemplate>

            <localControls:PlayerButtonTemplateSelector x:Key="PlayerButtonSelector"
                                                        DefaultButtonTemplate="{StaticResource PlayerButtonTemplate}"
                                                        PlayPauseButtonTemplate="{StaticResource PlayPauseButtonTemplate}"
                                                        LyricsButtonTemplate="{StaticResource LyricsButtonTemplate}"
                                                        QueueButtonTemplate="{StaticResource QueueButtonTemplate}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="OverlayContainerGrid">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SeeAllSearchStates">
                <VisualState x:Name="SeeAllSearchCollapsed">
                    <VisualState.Setters>
                        <Setter Target="SeeAllSearchTextBox.Width" Value="0" />
                        <Setter Target="SeeAllSearchTextBox.Opacity" Value="0" />
                        <Setter Target="SeeAllSearchTextBox.IsHitTestVisible" Value="False" />
                        <Setter Target="SeeAllSearchTextBox.IsTabStop" Value="False" />
                        <Setter Target="SeeAllSearchIcon.Glyph" Value="&#xE721;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SeeAllSearchExpanded">
                    <VisualState.Setters>
                        <Setter Target="SeeAllSearchTextBox.Width" Value="{StaticResource SearchBoxExpandedWidth}" />
                        <Setter Target="SeeAllSearchTextBox.Opacity" Value="1" />
                        <Setter Target="SeeAllSearchTextBox.IsHitTestVisible" Value="True" />
                        <Setter Target="SeeAllSearchTextBox.IsTabStop" Value="True" />
                        <Setter Target="SeeAllSearchIcon.Glyph" Value="&#xE711;" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="PlayerVisibilityStates">
                <VisualState x:Name="PlayerVisible">
                    <Storyboard>
                        <DoubleAnimation x:Name="VisiblePageHeightAnimation"
                                         Storyboard.TargetName="ContentFrame" Storyboard.TargetProperty="Height"
                                         Duration="0:0:0.3" FillBehavior="Stop" EnableDependentAnimation="True" />
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentFrame"
                                                       Storyboard.TargetProperty="VerticalAlignment"
                                                       Duration="0:0:0.3" FillBehavior="Stop">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="Top" />
                        </ObjectAnimationUsingKeyFrames>
                        <DoubleAnimation Storyboard.TargetName="PlayerContentSpace" Storyboard.TargetProperty="MaxHeight"
                                         To="{Binding MinHeight, ElementName=FloatingPlayerContainer}"
                                         Duration="0:0:0.3" FillBehavior="Stop" EnableDependentAnimation="True">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation
                            Storyboard.TargetName="PlayerHitBox"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="0:0:0.3">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation
                            Storyboard.TargetName="PlayerHitBox"
                            Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                            To="0"
                            Duration="0:0:0.3">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="PlayerHidden">
                    <Storyboard>
                        <DoubleAnimation x:Name="HiddenPageHeightAnimation"
                                         Storyboard.TargetName="ContentFrame" Storyboard.TargetProperty="Height"
                                         Duration="0:0:0.3" FillBehavior="Stop" EnableDependentAnimation="True" />
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentFrame"
                                                       Storyboard.TargetProperty="VerticalAlignment"
                                                       Duration="0:0:0.3" FillBehavior="Stop">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="Top" />
                        </ObjectAnimationUsingKeyFrames>
                        <DoubleAnimation x:Name="PlayerSpaceHideAnimation"
                                         Storyboard.TargetName="PlayerContentSpace" Storyboard.TargetProperty="MaxHeight"
                                         To="0" Duration="0:0:0.3" EnableDependentAnimation="True">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseIn" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation
                            Storyboard.TargetName="PlayerHitBox"
                            Storyboard.TargetProperty="Opacity"
                            To="0"
                            Duration="0:0:0.3">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseIn" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation
                            Storyboard.TargetName="PlayerHitBox"
                            Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                            To="150"
                            Duration="0:0:0.3">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseIn" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="PlayerStateGroup">
                <VisualState x:Name="PlayerExpanded">
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="FloatingPlayerContainer"
                            Storyboard.TargetProperty="MinHeight"
                            To="132"
                            Duration="0:0:0.25"
                            EnableDependentAnimation="True">
                            <DoubleAnimation.EasingFunction>
                                <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation
                            BeginTime="0:0:0.1"
                            Storyboard.TargetName="ArtistNameHyperlink"
                            Storyboard.TargetProperty="MaxHeight"
                            To="20"
                            Duration="0:0:0.2"
                            EnableDependentAnimation="True">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="PlayerCollapsed">
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="FloatingPlayerContainer"
                            Storyboard.TargetProperty="MinHeight"
                            To="80"
                            Duration="0:0:0.3"
                            EnableDependentAnimation="True">
                            <DoubleAnimation.EasingFunction>
                                <ExponentialEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation
                            Storyboard.TargetName="ArtistNameHyperlink"
                            Storyboard.TargetProperty="MaxHeight"
                            To="0"
                            Duration="0:0:0.25"
                            EnableDependentAnimation="True">
                            <DoubleAnimation.EasingFunction>
                                <ExponentialEase EasingMode="EaseIn" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="MainContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:TitleBar
                x:Name="AppTitleBar"
                Grid.Row="0"
                Background="Transparent"
                AutoRefreshDragRegions="True"
                IsBackButtonVisible="False"
                IsPaneToggleButtonVisible="True"
                PaneToggleRequested="AppTitleBar_PaneToggleRequested"
                BackRequested="AppTitleBar_BackRequested" />

            <NavigationView
                x:Name="NavView"
                Grid.Row="1"
                AlwaysShowHeader="False"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="True"
                IsTitleBarAutoPaddingEnabled="True"
                IsPaneToggleButtonVisible="False"
                ItemInvoked="NavView_ItemInvoked"
                PaneDisplayMode="Auto"
                CompactModeThresholdWidth="720"
                ExpandedModeThresholdWidth="720"
                OpenPaneLength="256"
                BackRequested="NavView_BackRequested"
                SelectionChanged="NavView_SelectionChanged"
                Background="Transparent">

                <Grid x:Name="ContentRegion" SizeChanged="ContentRegion_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <SplitView x:Name="QueueSplitView" PanePlacement="Right" DisplayMode="Inline"
                               OpenPaneLength="332" CompactPaneLength="0" PaneBackground="Transparent"
                               IsPaneOpen="{x:Bind ViewModel.IsQueuePanelOpen, Mode=TwoWay}">
                        <SplitView.Pane>
                            <Grid x:Name="QueuePanel" Margin="0,12,12,24"
                                  AllowDrop="True" DragOver="QueuePanel_DragOver" DragLeave="QueuePanel_DragLeave" Drop="Queue_Drop">
                                <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}">
                                    <Grid Padding="{StaticResource SurfaceContentPadding}" RowSpacing="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource OverlayCornerRadius}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="{x:Bind GetListeningPaneTitle(ViewModel.IsHistoryVisible), Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}"
                                                           Foreground="{StaticResource PlayerAccentBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.SidebarQueue.TrackCountText, Mode=OneWay}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Visibility="{x:Bind GetQueueDetailVisibility(ViewModel.IsHistoryVisible, ViewModel.QueueDisplaySettings.ShowTrackCount), Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind ViewModel.SidebarQueue.TotalDurationText, Mode=OneWay}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           ToolTipService.ToolTip="{x:Bind resources:Strings.QueuePanel_ShowTotalDuration}"
                                                           Visibility="{x:Bind GetQueueDetailVisibility(ViewModel.IsHistoryVisible, ViewModel.QueueDisplaySettings.ShowTotalDuration), Mode=OneWay}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource CompactMediaControlButtonStyle}"
                                                    Foreground="{StaticResource PlayerAccentBrush}"
                                                    Command="{x:Bind ViewModel.ClearQueueCommand}"
                                                    Visibility="{x:Bind ViewModel.IsHistoryVisible, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                    ToolTipService.ToolTip="{x:Bind resources:Strings.QueueFlyout_ClearQueue}"
                                                    AutomationProperties.Name="{x:Bind resources:Strings.QueueFlyout_ClearQueue}"
                                                    ContentTemplate="{StaticResource ClearQueueIconTemplate}" />
                                            <Button Visibility="{x:Bind ViewModel.IsHistoryVisible, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" x:Name="QueueSettingsButton" Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource CompactMediaControlButtonStyle}"
                                                    Foreground="{StaticResource PlayerAccentBrush}"
                                                    ToolTipService.ToolTip="{x:Bind resources:Strings.QueuePanel_DisplayOptions}"
                                                    AutomationProperties.Name="{x:Bind resources:Strings.QueuePanel_DisplayOptions}">
                                                <FontIcon Glyph="&#xE713;" FontSize="16" />
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                        <ToggleMenuFlyoutItem Text="{x:Bind resources:Strings.QueuePanel_ShowPosition}"
                                                                              IsChecked="{x:Bind ViewModel.QueueDisplaySettings.ShowPosition, Mode=TwoWay}" />
                                                        <ToggleMenuFlyoutItem Text="{x:Bind resources:Strings.QueuePanel_ShowArtist}"
                                                                              IsChecked="{x:Bind ViewModel.QueueDisplaySettings.ShowArtist, Mode=TwoWay}" />
                                                        <ToggleMenuFlyoutItem Text="{x:Bind resources:Strings.QueuePanel_ShowDuration}"
                                                                              IsChecked="{x:Bind ViewModel.QueueDisplaySettings.ShowDuration, Mode=TwoWay}" />
                                                        <ToggleMenuFlyoutItem Text="{x:Bind resources:Strings.QueuePanel_ShowGenre}"
                                                                              IsChecked="{x:Bind ViewModel.QueueDisplaySettings.ShowGenre, Mode=TwoWay}" />
                                                        <ToggleMenuFlyoutItem Text="{x:Bind resources:Strings.QueuePanel_ShowTrackCount}"
                                                                              IsChecked="{x:Bind ViewModel.QueueDisplaySettings.ShowTrackCount, Mode=TwoWay}" />
                                                        <ToggleMenuFlyoutItem Text="{x:Bind resources:Strings.QueuePanel_ShowTotalDuration}"
                                                                              IsChecked="{x:Bind ViewModel.QueueDisplaySettings.ShowTotalDuration, Mode=TwoWay}" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                            <Button Grid.Column="3" VerticalAlignment="Top" Style="{StaticResource CompactMediaControlButtonStyle}"
                                                    Foreground="{StaticResource PlayerAccentBrush}" Click="ToggleListeningPane_Click"
                                                    ToolTipService.ToolTip="{x:Bind GetListeningPaneToggleLabel(ViewModel.IsHistoryVisible), Mode=OneWay}"
                                                    AutomationProperties.Name="{x:Bind GetListeningPaneToggleLabel(ViewModel.IsHistoryVisible), Mode=OneWay}">
                                                <FontIcon Glyph="{x:Bind GetListeningPaneToggleIcon(ViewModel.IsHistoryVisible), Mode=OneWay}" FontSize="16" />
                                            </Button>
                                            <Button Grid.Column="4" VerticalAlignment="Top" Style="{StaticResource CompactMediaControlButtonStyle}"
                                                    Foreground="{StaticResource PlayerAccentBrush}"
                                                    Command="{x:Bind ViewModel.ToggleQueuePanelCommand}"
                                                    ToolTipService.ToolTip="{x:Bind resources:Strings.QueuePanel_Close}"
                                                    AutomationProperties.Name="{x:Bind resources:Strings.QueuePanel_Close}">
                                                <FontIcon Glyph="&#xE711;" FontSize="16" />
                                            </Button>
                                        </Grid>
                                        <InfoBar Grid.Row="1" Visibility="{x:Bind ViewModel.IsHistoryVisible, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" IsOpen="{x:Bind ViewModel.SidebarQueue.HasLoadError, Mode=OneWay}"
                                                 Severity="Error" IsClosable="False"
                                                 Message="{x:Bind resources:Strings.QueuePanel_LoadError}">
                                            <InfoBar.ActionButton>
                                                <Button Content="{x:Bind resources:Strings.QueuePanel_Retry}" Click="Queue_Retry" />
                                            </InfoBar.ActionButton>
                                        </InfoBar>
                                        <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.IsHistoryVisible, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <ListView uihelpers:ScrollEdgeFade.IsEnabled="True" x:Name="QueueListView" ItemsSource="{x:Bind ViewModel.SidebarQueue, Converter={StaticResource IncrementalLoadingConverter}}"
                                                  ItemContainerStyle="{StaticResource PaddedListViewItemStyle}" SelectionMode="Single"
                                                  CanDragItems="True" CanReorderItems="True" AllowDrop="True"
                                                  DragItemsStarting="QueueListView_DragItemsStarting" DragItemsCompleted="QueueListView_DragItemsCompleted"
                                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                                            <ListView.Footer>
                                                <ProgressRing Width="16" Height="16" Margin="0,8"
                                                              IsHitTestVisible="False" HorizontalAlignment="Center"
                                                              IsActive="{x:Bind ViewModel.SidebarQueue.ShowMoreLoading, Mode=OneWay}"
                                                              Visibility="{x:Bind ViewModel.SidebarQueue.ShowMoreLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </ListView.Footer>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="uiModels:QueueEntry">
                                                    <Grid Background="Transparent" Tag="{x:Bind}" DoubleTapped="QueueEntry_DoubleTapped"
                                                          ToolTipService.ToolTip="{x:Bind Title}">
                                                        <Grid.ContextFlyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem Text="{x:Bind resources:Strings.QueuePanel_Play}" Tag="{x:Bind}" Click="QueueEntry_Play" />
                                                                <MenuFlyoutItem Text="{x:Bind resources:Strings.QueuePanel_MoveUp}" Tag="{x:Bind}" Click="QueueEntry_MoveUp" />
                                                                <MenuFlyoutItem Text="{x:Bind resources:Strings.QueuePanel_MoveDown}" Tag="{x:Bind}" Click="QueueEntry_MoveDown" />
                                                                <MenuFlyoutSeparator />
                                                                <MenuFlyoutItem Text="{x:Bind resources:Strings.QueuePanel_Remove}" Tag="{x:Bind}" Click="QueueEntry_Remove" />
                                                            </MenuFlyout>
                                                        </Grid.ContextFlyout>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind Position, Mode=OneWay}" Margin="0,0,12,0" Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   Visibility="{Binding DataContext.QueueDisplaySettings.ShowPosition, ElementName=MainPageRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <StackPanel Grid.Column="1" Margin="0,0,12,0" Spacing="4">
                                                            <TextBlock x:Name="SongTitle" Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Visibility="{Binding DataContext.QueueDisplaySettings.ShowArtist, ElementName=MainPageRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Style="{StaticResource SongListViewPageSecondaryTextBlockStyle}"
                                                                           uihelpers:MultiArtistHyperlinkHelper.ArtistName="{x:Bind ArtistName}"
                                                                           uihelpers:MultiArtistHyperlinkHelper.Song="{x:Bind Song}"
                                                                           uihelpers:MultiArtistHyperlinkHelper.Command="{Binding DataContext.GoToArtistCommand, ElementName=MainPageRoot}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{x:Bind GenreText}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                       Visibility="{Binding DataContext.QueueDisplaySettings.ShowGenre, ElementName=MainPageRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{x:Bind Duration, Converter={StaticResource TimeSpanToTimeStringConverter}}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   Visibility="{Binding DataContext.QueueDisplaySettings.ShowDuration, ElementName=MainPageRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <StackPanel Margin="20" Spacing="8" VerticalAlignment="Center" IsHitTestVisible="False"
                                                    Visibility="{x:Bind ViewModel.SidebarQueue.ShowEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <FontIcon Glyph="&#xE8D6;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind resources:Strings.QueuePanel_EmptyTitle}" FontWeight="SemiBold"
                                                       TextAlignment="Center" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind resources:Strings.QueuePanel_EmptyDescription}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ProgressRing Width="32" Height="32" IsHitTestVisible="False"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      IsActive="{x:Bind ViewModel.SidebarQueue.ShowInitialLoading, Mode=OneWay}"
                                                      Visibility="{x:Bind ViewModel.SidebarQueue.ShowInitialLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                        <Grid Grid.Row="2" RowSpacing="12" Visibility="{x:Bind ViewModel.IsHistoryVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <TextBox Style="{StaticResource SearchTextBoxStyle}" PlaceholderText="{x:Bind resources:Strings.Listening_HistorySearch}" Text="{x:Bind ViewModel.History.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.History.HasLoadError, Mode=OneWay}" Severity="Error" IsClosable="False" Message="{x:Bind resources:Strings.Listening_HistoryLoadError}">
                                                <InfoBar.ActionButton><Button Content="{x:Bind resources:Strings.QueuePanel_Retry}" Command="{x:Bind ViewModel.History.SearchCommand}" /></InfoBar.ActionButton>
                                            </InfoBar>
                                            <ListView Grid.Row="2" x:Name="HistoryListView" uihelpers:ScrollEdgeFade.IsEnabled="True" SelectionMode="Single" ItemsSource="{x:Bind ViewModel.History.Entries, Converter={StaticResource IncrementalLoadingConverter}}">
                                                <ListView.ItemContainerStyleSelector>
                                                    <uihelpers:RecentHistoryStyleSelector SongStyle="{StaticResource PaddedListViewItemStyle}">
                                                        <uihelpers:RecentHistoryStyleSelector.HeaderStyle>
                                                            <Style TargetType="ListViewItem">
                                                                <Setter Property="MinHeight" Value="0" />
                                                                <Setter Property="Padding" Value="12,16,12,8" />
                                                                <Setter Property="IsHitTestVisible" Value="False" />
                                                                <Setter Property="IsTabStop" Value="False" />
                                                            </Style>
                                                        </uihelpers:RecentHistoryStyleSelector.HeaderStyle>
                                                    </uihelpers:RecentHistoryStyleSelector>
                                                </ListView.ItemContainerStyleSelector>
                                                <ListView.Footer>
                                                    <ProgressRing Width="16" Height="16" Margin="0,8" IsHitTestVisible="False" HorizontalAlignment="Center"
                                                                  IsActive="{x:Bind ViewModel.History.ShowMoreLoading, Mode=OneWay}"
                                                                  Visibility="{x:Bind ViewModel.History.ShowMoreLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </ListView.Footer>
                                                <ListView.ItemTemplateSelector>
                                                    <uihelpers:RecentHistoryTemplateSelector>
                                                        <uihelpers:RecentHistoryTemplateSelector.HeaderTemplate>
                                                            <DataTemplate x:DataType="uiModels:RecentListenDateHeader">
                                                                <TextBlock Text="{x:Bind Title}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </DataTemplate>
                                                        </uihelpers:RecentHistoryTemplateSelector.HeaderTemplate>
                                                        <uihelpers:RecentHistoryTemplateSelector.SongTemplate>
                                                            <DataTemplate x:DataType="uiModels:RecentListenEntry">
                                                                <Grid Background="Transparent" Tag="{x:Bind}" DoubleTapped="HistoryEntry_DoubleTapped"
                                                                      ToolTipService.ToolTip="{x:Bind Title}">
                                                                    <Grid.ContextFlyout><MenuFlyout>
                                                                        <MenuFlyoutItem Text="{x:Bind resources:Strings.QueuePanel_Play}" Command="{Binding DataContext.PlayHistoryNowCommand, ElementName=MainPageRoot}" CommandParameter="{x:Bind}" />
                                                                        <MenuFlyoutItem Text="{x:Bind resources:Strings.LibraryPage_Context_PlayNext}" Command="{Binding DataContext.PlayHistoryNextCommand, ElementName=MainPageRoot}" CommandParameter="{x:Bind}" />
                                                                    </MenuFlyout></Grid.ContextFlyout>
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                    <StackPanel Margin="0,0,12,0" Spacing="4">
                                                                        <TextBlock x:Name="SongTitle" Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                                        <StackPanel>
                                                                            <TextBlock Style="{StaticResource SongListViewPageSecondaryTextBlockStyle}"
                                                                                       uihelpers:MultiArtistHyperlinkHelper.ArtistName="{x:Bind ArtistName}"
                                                                                       uihelpers:MultiArtistHyperlinkHelper.Song="{x:Bind Song}"
                                                                                       uihelpers:MultiArtistHyperlinkHelper.Command="{Binding DataContext.GoToArtistCommand, ElementName=MainPageRoot}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Text="{x:Bind TimeText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </uihelpers:RecentHistoryTemplateSelector.SongTemplate>
                                                    </uihelpers:RecentHistoryTemplateSelector>
                                                </ListView.ItemTemplateSelector>
                                            </ListView>
                                            <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.History.EmptyStateText, Mode=OneWay}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.History.ShowEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ProgressRing Grid.Row="2" Width="24" Height="24" IsActive="{x:Bind ViewModel.History.ShowInitialLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.History.ShowInitialLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border x:Name="QueueDropHighlight" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="2" CornerRadius="{ThemeResource OverlayCornerRadius}" IsHitTestVisible="False" Visibility="Collapsed" />
                            </Grid>
                        </SplitView.Pane>
                        <Frame x:Name="ContentFrame" Padding="12,0,12,0" />
                    </SplitView>

                    <Border x:Name="PlayerContentSpace" Grid.Row="1" MaxHeight="132"
                            Height="{Binding MinHeight, ElementName=FloatingPlayerContainer}" />

                    <Grid
                        x:Name="PlayerHitBox"
                        Grid.RowSpan="2"
                        Height="132"
                        Margin="12,0,12,12"
                        VerticalAlignment="Bottom"
                        PointerEntered="FloatingPlayerContainer_PointerEntered"
                        PointerExited="FloatingPlayerContainer_PointerExited">
                        <Grid.Resources>
                            <StaticResource x:Key="SliderThumbBackground" ResourceKey="PlayerAccentBrush" />
                            <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="PlayerAccentBrush" />
                            <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="PlayerAccentBrush" />
                            <StaticResource x:Key="SliderTrackValueFill" ResourceKey="PlayerAccentBrush" />
                            <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="PlayerAccentBrush" />
                            <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="PlayerAccentBrush" />
                        </Grid.Resources>
                        <Grid.RenderTransform>
                            <CompositeTransform />
                        </Grid.RenderTransform>

                        <Border
                            x:Name="FloatingPlayerContainer"
                            Padding="{StaticResource CompactSurfaceContentPadding}"
                            AllowDrop="True"
                            DragOver="Queue_DragOver"
                            Drop="Queue_Drop"
                            VerticalAlignment="Bottom"
                            CornerRadius="{ThemeResource OverlayCornerRadius}">
                            <Grid>
                                <Grid x:Name="MainControlsGrid" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition MinWidth="180" Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition MinWidth="160" Width="*" />
                                    </Grid.ColumnDefinitions>

                                <Grid
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        ToolTipService.ToolTip="{x:Bind resources:Strings.Player_GoToAlbumButton_ToolTip, Mode=OneTime}"
                                        Grid.Column="0"
                                        Padding="0"
                                        Margin="0,0,12,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Command="{x:Bind ViewModel.GoToAlbumCommand, Mode=OneWay}"
                                        Style="{StaticResource DefaultButtonStyle}"
                                        Visibility="{x:Bind ViewModel.IsArtworkAvailable, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                        <Border
                                            x:Name="AlbumArtBorder"
                                            Width="{StaticResource FloatingPlayerArtSize}"
                                            Height="{StaticResource FloatingPlayerArtSize}"
                                            CornerRadius="{StaticResource ArtworkCornerRadius}">
                                            <imageEx:ImageEx Width="{StaticResource FloatingPlayerArtSize}" Height="{StaticResource FloatingPlayerArtSize}"
                                                x:Name="AlbumArt"
                                                IsCacheEnabled="True"
                                                Source="{x:Bind ViewModel.AlbumArtUri, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}, FallbackValue=null}"
                                                DecodePixelWidth="{StaticResource FloatingPlayerArtSize}"
                                                DecodePixelType="Logical"
                                                Stretch="UniformToFill" />
                                        </Border>
                                    </Button>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Grid HorizontalAlignment="Left" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock
                                                x:Name="SongTitle"
                                                VerticalAlignment="Center"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind ViewModel.SongTitle, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <Button Grid.Column="1" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.CurrentPlayingTrack, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}" Style="{StaticResource CompactMediaControlButtonStyle}" ToolTipService.ToolTip="{x:Bind resources:Strings.Listening_PlayerOptions}" AutomationProperties.Name="{x:Bind resources:Strings.Listening_PlayerOptions}">
                                                <Button.Flyout><MenuFlyout Opening="PlayerOptions_Opening" /></Button.Flyout>
                                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE712;" Foreground="{StaticResource PlayerAccentBrush}" />
                                            </Button>
                                        </Grid>
                                        <Grid
                                            x:Name="ArtistNameHyperlink"
                                            MaxHeight="0"
                                            Visibility="{x:Bind ViewModel.CurrentPlayingTrack, Converter={StaticResource ObjectToVisibilityConverter}, Mode=OneWay}">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{ThemeResource BodyTextBlockStyle}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                uihelpers:MultiArtistHyperlinkHelper.ArtistName="{x:Bind ViewModel.ArtistName, Mode=OneWay}"
                                                uihelpers:MultiArtistHyperlinkHelper.Song="{x:Bind ViewModel.CurrentPlayingTrack, Mode=OneWay}"
                                                uihelpers:MultiArtistHyperlinkHelper.Command="{Binding ViewModel.GoToArtistCommand, ElementName=MainPageRoot}" />
                                        </Grid>
                                        <Button Content="{x:Bind ViewModel.StopScheduleText, Mode=OneWay}" Padding="0,2" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" FontSize="12" Visibility="{x:Bind ViewModel.IsStopScheduled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button.Flyout><MenuFlyout Opening="TimerOptions_Opening" /></Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <ItemsControl
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ItemsSource="{x:Bind ViewModel.MainTransportButtons, Mode=OneWay}"
                                    ItemTemplateSelector="{StaticResource PlayerButtonSelector}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <StackPanel
                                    x:Name="SecondaryControlsContainer"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Opacity="0">

                                    <ItemsControl
                                        ItemsSource="{x:Bind ViewModel.SecondaryControlsButtons, Mode=OneWay}"
                                        ItemTemplateSelector="{StaticResource PlayerButtonSelector}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <Grid
                                        Height="72"
                                        Margin="-12,-20,-12,-20"
                                        Background="Transparent"
                                        PointerWheelChanged="VolumeSliderContainer_PointerWheelChanged">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Rectangle
                                            Grid.Column="0"
                                            Width="12"
                                            Fill="Transparent" />

                                        <Slider
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource VolumeSliderStyle}"
                                            Foreground="{StaticResource PlayerAccentBrush}"
                                            Value="{x:Bind ViewModel.CurrentVolume, Mode=TwoWay}"
                                            Visibility="{x:Bind ViewModel.IsVolumeControlVisible, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                            <Slider.Resources>
                                                <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
                                            </Slider.Resources>
                                        </Slider>

                                        <Rectangle
                                            Grid.Column="2"
                                            Width="12"
                                            Fill="Transparent" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Grid
                                x:Name="SeekBarGrid"
                                VerticalAlignment="Bottom"
                                Opacity="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Slider
                                    x:Name="MediaSeekerSlider"
                                    Grid.Row="0"
                                    Margin="0,8,0,-4"
                                    VerticalAlignment="Center"
                                    IsThumbToolTipEnabled="True"
                                    Maximum="{x:Bind ViewModel.TotalDuration, Mode=OneWay, Converter={StaticResource SliderMaximumConverter}}"
                                    Style="{StaticResource MediaSeekerSliderStyle}"
                                    Foreground="{StaticResource PlayerAccentBrush}"
                                    ThumbToolTipValueConverter="{StaticResource TimeSpanToTimeStringConverter}"
                                    Value="{x:Bind ViewModel.CurrentPosition, Mode=TwoWay}"
                                    PointerPressed="MediaSeekerSlider_PointerPressed"
                                    PointerReleased="MediaSeekerSlider_PointerReleased"
                                    PointerCaptureLost="MediaSeekerSlider_PointerReleased"
                                    KeyDown="MediaSeekerSlider_KeyDown"
                                    KeyUp="MediaSeekerSlider_KeyUp" />
                                <Grid Grid.Row="1" Margin="2,0,2,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="CurrentTimeTextBlock"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.CurrentTimeText, Mode=OneWay, FallbackValue='0:00'}" />
                                    <TextBlock
                                        x:Name="TotalTimeTextBlock"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.TotalDurationText, Mode=OneWay, FallbackValue='0:00'}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                    </Grid>
                </Grid>
            </NavigationView>
        </Grid>

        <localControls:TrayIconUserControl
            x:Name="AppTrayIconHost"
            VerticalAlignment="Top" HorizontalAlignment="Left"
            Width="1" Height="1" Opacity="0" IsTabStop="False" />

        <Grid
            x:Name="ProgressOverlayGrid"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            IsHitTestVisible="{x:Bind GlobalOperation.IsInProgress, Mode=OneWay}"
            Opacity="0.85"
            Visibility="{x:Bind GlobalOperation.IsInProgress, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressBar
                    Width="400"
                    Height="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsIndeterminate="{x:Bind GlobalOperation.IsIndeterminate, Mode=OneWay}"
                    Maximum="100"
                    Value="{x:Bind GlobalOperation.ProgressValue, Mode=OneWay}" />
                <TextBlock
                    MaxWidth="400"
                    HorizontalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="{x:Bind GlobalOperation.StatusMessage, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <Button
                    HorizontalAlignment="Center"
                    Command="{x:Bind GlobalOperation.CancelCommand}"
                    Content="{x:Bind resources:Strings.Generic_Cancel, Mode=OneTime}"
                    Visibility="{x:Bind GlobalOperation.IsCancellable, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <Grid x:Name="SeeAllOverlay"
              Visibility="{x:Bind InsightsVm.IsSeeAllOpen, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">


            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.ColumnSpan="3"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  Opacity="0.85"
                  Tapped="OnCloseSeeAll" />

            <Grid x:Name="SeeAllPanel"
                  Grid.Column="1"
                  Margin="0,156,0,156"
                  VerticalAlignment="Stretch"
                  Opacity="1"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  CornerRadius="{ThemeResource OverlayCornerRadius}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  Tapped="OnSeeAllPanelTapped">

                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="{StaticResource SurfaceContentPadding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind InsightsVm.SeeAllTitle, Mode=OneWay}"
                                   FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />

                        <Grid Grid.Column="1" Margin="0,0,8,0">
                            <TextBox x:Name="SeeAllSearchTextBox"
                                     PlaceholderText="{x:Bind resources:Strings.FolderSongViewPage_SearchBox_Placeholder, Mode=OneTime}"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Width="0"
                                     Opacity="0"
                                     IsHitTestVisible="False"
                             IsTabStop="False"
                                     HorizontalAlignment="Right"
                                     KeyDown="OnSeeAllSearchTextBoxKeyDown"
                                     Text="{x:Bind InsightsVm.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Canvas.ZIndex="0">
                                <TextBox.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.15" />
                                </TextBox.OpacityTransition>
                            </TextBox>

                            <Button x:Name="SeeAllSearchToggleButton"
                                    ToolTipService.ToolTip="{x:Bind resources:Strings.FolderSongViewPage_SearchButton_ToolTip, Mode=OneTime}"
                                    Click="OnSeeAllSearchToggleButtonClick"
                                    Style="{StaticResource SongListViewPageIconButton}"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,1,0"
                                    IsHitTestVisible="True"
                                    Canvas.ZIndex="1">
                                <FontIcon x:Name="SeeAllSearchIcon" FontSize="16" Glyph="&#xE721;" />
                            </Button>
                        </Grid>

                        <DropDownButton Grid.Column="2"
                                        Content="{x:Bind InsightsVm.SeeAllSortLabel, Mode=OneWay}"
                                        FontSize="11" Height="28" Padding="8,0"
                                        VerticalAlignment="Center" Margin="0,0,8,0">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <RadioMenuFlyoutItem Text="{x:Bind resources:Strings.InsightsPage_SortBy_PlayCount, Mode=OneTime}" GroupName="SeeAllSort"
                                                         IsChecked="{x:Bind InsightsVm.IsSeeAllByPlayCount, Mode=OneWay}"
                                                         Click="OnSeeAllSortByPlayCountClick" />
                                    <RadioMenuFlyoutItem Text="{x:Bind resources:Strings.InsightsPage_SortBy_Duration, Mode=OneTime}" GroupName="SeeAllSort"
                                                         IsChecked="{x:Bind InsightsVm.IsSeeAllByDuration, Mode=OneWay}"
                                                         Click="OnSeeAllSortByDurationClick" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <Button Grid.Column="3"
                                Click="OnCloseSeeAll"
                                Style="{StaticResource SubtleButtonStyle}"
                                Width="32" Height="32" Padding="0">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ProgressRing IsActive="{x:Bind InsightsVm.IsSeeAllLoading, Mode=OneWay}"
                                      Visibility="{x:Bind InsightsVm.IsSeeAllLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Width="40" Height="40" />

                        <ListView uihelpers:ScrollEdgeFade.IsEnabled="True" x:Name="SeeAllSongsPanel"
                                  x:Load="{x:Bind InsightsVm.IsSeeAllSongs, Mode=OneWay}"
                                  Visibility="{x:Bind InsightsVm.IsSeeAllLoading, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                  ItemsSource="{x:Bind InsightsVm.SeeAllSongs, Mode=OneWay}"
                                  SelectionMode="None"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  Padding="16,0,16,8"
                                  ItemContainerStyle="{StaticResource SeeAllListItemStyle}"
                                  ItemTemplate="{StaticResource TopSongItemTemplate}" />

                        <ListView uihelpers:ScrollEdgeFade.IsEnabled="True" x:Name="SeeAllArtistsPanel"
                                  x:Load="{x:Bind InsightsVm.IsSeeAllArtists, Mode=OneWay}"
                                  Visibility="{x:Bind InsightsVm.IsSeeAllLoading, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                  ItemsSource="{x:Bind InsightsVm.SeeAllArtists, Mode=OneWay}"
                                  SelectionMode="None"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  Padding="16,0,16,8"
                                  ItemContainerStyle="{StaticResource SeeAllListItemStyle}"
                                  ItemTemplate="{StaticResource TopArtistItemTemplate}" />

                        <ListView uihelpers:ScrollEdgeFade.IsEnabled="True" x:Name="SeeAllAlbumsPanel"
                                  x:Load="{x:Bind InsightsVm.IsSeeAllAlbums, Mode=OneWay}"
                                  Visibility="{x:Bind InsightsVm.IsSeeAllLoading, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                  ItemsSource="{x:Bind InsightsVm.SeeAllAlbums, Mode=OneWay}"
                                  SelectionMode="None"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  Padding="16,0,16,8"
                                  ItemContainerStyle="{StaticResource SeeAllListItemStyle}"
                                  ItemTemplate="{StaticResource TopAlbumItemTemplate}" />

                        <ListView uihelpers:ScrollEdgeFade.IsEnabled="True" x:Name="SeeAllGenresPanel"
                                  x:Load="{x:Bind InsightsVm.IsSeeAllGenres, Mode=OneWay}"
                                  Visibility="{x:Bind InsightsVm.IsSeeAllLoading, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                  ItemsSource="{x:Bind InsightsVm.SeeAllGenres, Mode=OneWay}"
                                  SelectionMode="None"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  Padding="16,0,16,8"
                                  ItemContainerStyle="{StaticResource SeeAllListItemStyle}"
                                  ItemTemplate="{StaticResource TopGenreItemTemplate}" />
                    </Grid>

                    <Grid Grid.Row="2" Padding="16,8,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{x:Bind InsightsVm.SeeAllCurrentPage, Mode=OneWay}"
                                 FontWeight="SemiBold"
                                 Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <Run Text=" / " />
                            <Run Text="{x:Bind InsightsVm.SeeAllTotalPages, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button Command="{x:Bind InsightsVm.SeeAllPreviousPageCommand}"
                                    IsEnabled="{x:Bind InsightsVm.HasSeeAllPreviousPage, Mode=OneWay}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Width="32" Height="32" Padding="0">
                                <FontIcon Glyph="&#xE76B;" FontSize="12" />
                            </Button>
                            <Button Command="{x:Bind InsightsVm.SeeAllNextPageCommand}"
                                    IsEnabled="{x:Bind InsightsVm.HasSeeAllNextPage, Mode=OneWay}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Width="32" Height="32" Padding="0">
                                <FontIcon Glyph="&#xE76C;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</UserControl>
